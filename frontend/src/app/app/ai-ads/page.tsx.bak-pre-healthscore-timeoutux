  Radar,
  ShieldAlert,
  ShieldCheck,
  ListChecks,
  Activity,
  Loader2,
  CheckCircle2,
  XCircle,
  RefreshCw,
  Send,
  ClipboardList,
  TrendingUp,
  AlertTriangle,
  ChevronDown,
  ChevronUp,
  History,
  Gauge,
  Sparkles,
  Bot,
} from 'lucide-react';

// ── Tipe bersama ─────────────────────────────────────────────────────────

interface BmOption {
  id: string;
  name: string;
  tokenStatus: 'ACTIVE' | 'ERROR' | 'EXPIRED';
}

interface AdAccountOption {
  id: string;
  accountId: string;
  name: string;
  status: string;
}

interface CampaignOption {
  id: string;
  name: string;
  status: string;
  adAccountId: string;
  adAccountName: string;
}

type ShiftType = 'MORNING_EARLY_KILL' | 'MID_DAY_PACING' | 'GOLDEN_HOUR_SCALING' | 'MANUAL_TRIGGER' | 'ADHOC_COPILOT';
type RecStatus = 'PENDING_APPROVAL' | 'APPROVED' | 'REJECTED' | 'EXECUTED' | 'EXECUTION_FAILED';

interface AiAdsRecommendation {
  id: string;
  bmId: string;
  shiftType: ShiftType;
  status: RecStatus;
  planPath: string | null;
  planSummary: Record<string, unknown> | null;
  rawAgyOutput: string | null;
  requestedBy: string | null;
  approvedBy: string | null;
  approvedAt: string | null;
  rejectedBy: string | null;
  rejectedAt: string | null;
  rejectionReason: string | null;
  executionResult: Record<string, unknown> | null;
  executedAt: string | null;
  createdAt: string;
  updatedAt: string;
}

interface SentinelStatusResp {
  available: boolean;
  message?: string;
  state?: Record<string, unknown> | null;
  config?: {
    _README?: string;
    spend_anomaly?: {
      spend_increase_pct_threshold?: number;
      targets?: any[];
    };
    landing_page?: {
      auto_pause_on_down?: boolean;
      timeout_seconds?: number;
      pages?: any[];
    };
    spendAnomalyThresholdPct?: number | null;
    spendAnomalyTargetCount?: number;
    landingPageAutoPauseOnDown?: boolean | null;
    landingPageCount?: number;
  } | null;
  errors?: string[];
}

const SHIFT_LABEL: Record<ShiftType, string> = {
  MORNING_EARLY_KILL: 'Morning Early-Kill (09:00)',
  MID_DAY_PACING: 'Mid-Day Pacing (13:00)',
  GOLDEN_HOUR_SCALING: 'Golden Hour Scaling (16:00)',
  MANUAL_TRIGGER: 'Trigger Manual',
  ADHOC_COPILOT: 'Konsultasi Copilot',
};

const STATUS_BADGE: Record<RecStatus, string> = {
  PENDING_APPROVAL: 'bg-amber-100 text-amber-800',
  APPROVED: 'bg-blue-100 text-blue-800',
  REJECTED: 'bg-gray-100 text-gray-600',
  EXECUTED: 'bg-emerald-100 text-emerald-800',
  EXECUTION_FAILED: 'bg-red-100 text-red-800',
};

const STATUS_LABEL: Record<RecStatus, string> = {
  PENDING_APPROVAL: 'Menunggu Approval',
  APPROVED: 'Sedang Dieksekusi',
  REJECTED: 'Ditolak',
  EXECUTED: 'Berhasil Dieksekusi',
  EXECUTION_FAILED: 'Eksekusi Gagal',
};

function formatWaktu(iso: string | null): string {
  if (!iso) return '-';
  try {
    return new Date(iso).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
  } catch {
    return iso;
  }
}

// ── Blok 1: Sentinel & Emergency Radar ─────────────────────────────────────

function SentinelRadarBlock() {
  const [status, setStatus] = useState<SentinelStatusResp | null>(null);
  const [bmDefaultsList, setBmDefaultsList] = useState<{ bmName: string; enabled: boolean; threshold: number }[]>([]);
  const [loading, setLoading] = useState(true);

  const muat = useCallback(async () => {
    try {
      const [resStatus, bms] = await Promise.all([
        apiGet<SentinelStatusResp>('/ai-ads/sentinel-status').catch(() => ({
          available: false,
          message: 'Gagal menghubungi backend.',
        } as SentinelStatusResp)),
        apiGet<BmOption[]>('/business/meta-bms').catch(() => [] as BmOption[]),
      ]);
      setStatus(resStatus);

      if (Array.isArray(bms) && bms.length > 0) {
        const defs = await Promise.all(
          bms.map(async (bm) => {
            try {
              const def = await apiGet<{ spendAnomaly?: { enabled: boolean; default: { spendIncreasePctThreshold: number } } }>(
                `/business/meta-bms/${bm.id}/automation-defaults`
              );
              return {
                bmName: bm.name,
                enabled: def?.spendAnomaly?.enabled ?? false,
                threshold: def?.spendAnomaly?.default?.spendIncreasePctThreshold ?? 50,
              };
            } catch {
              return { bmName: bm.name, enabled: false, threshold: 50 };
            }
          })
        );
        setBmDefaultsList(defs);
      }
    } catch {
      setStatus({ available: false, message: 'Gagal menghubungi backend.' });
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void muat();
    const t = setInterval(muat, 30000);
    return () => clearInterval(t);
  }, [muat]);

  const state = (status?.state ?? {}) as Record<string, unknown>;
  const adaAlarm = Object.keys(state).length > 0;

  // Hitung ambang batas Multi-BM
  const activeBms = bmDefaultsList.filter((b) => b.enabled);
  let ambangDisplay = '-';
  if (activeBms.length === 0) {
    const rawDefault = status?.config?.spend_anomaly?.spend_increase_pct_threshold ?? status?.config?.spendAnomalyThresholdPct;
    ambangDisplay = rawDefault ? `${rawDefault}% (Default)` : 'Nonaktif';
  } else if (activeBms.length === 1) {
    ambangDisplay = `${activeBms[0].threshold}% (${activeBms[0].bmName})`;
  } else {
    const thresholds = activeBms.map((b) => b.threshold);
    const minT = Math.min(...thresholds);
    const maxT = Math.max(...thresholds);
    ambangDisplay = minT === maxT ? `${minT}% (${activeBms.length} BM)` : `Multi-BM (${minT}% - ${maxT}%)`;
  }

  const rawTargets = status?.config?.spend_anomaly?.targets ?? [];
  const targetCount = rawTargets.length || (status?.config?.spendAnomalyTargetCount ?? 0);

  const rawLandingPages = status?.config?.landing_page?.pages ?? [];
  const landingPageCount = rawLandingPages.length || (status?.config?.landingPageCount ?? 0);

  const autoPauseDown = status?.config?.landing_page?.auto_pause_on_down ?? status?.config?.landingPageAutoPauseOnDown ?? false;

  return (
    <section className="bg-white rounded-lg shadow border border-gray-100 p-5 space-y-3">
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-2">
          <Radar className="w-5 h-5 text-indigo-600" />
          <h2 className="text-base font-bold">Blok 1 — Sentinel &amp; Emergency Radar</h2>
        </div>
        <button onClick={() => void muat()} className="text-gray-400 hover:text-gray-600" title="Muat ulang">
          <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin' : ''}`} />
        </button>
      </div>
      <p className="text-xs text-gray-500">
        Status live cek landing page down &amp; anomali spend (cron */15 menit di VPS Antigravity), relay
        baca-saja dari emergency_brake.py.
      </p>

      {loading ? (
        <div className="text-sm text-gray-400 flex items-center gap-2">
          <Loader2 className="w-4 h-4 animate-spin" /> Memuat status sentinel…
        </div>
      ) : !status?.available ? (
        <div className="text-sm text-gray-500 bg-gray-50 border border-gray-200 rounded p-3">
          Sentinel belum bisa dihubungi ({status?.message || 'API Bridge belum dikonfigurasi'}).
        </div>
      ) : adaAlarm ? (
        <div className="bg-red-50 border border-red-300 text-red-800 rounded p-3 text-sm flex items-start gap-2">
          <AlertTriangle className="w-4 h-4 flex-shrink-0 mt-0.5" />
          <div>
            <strong>Ada alarm aktif</strong> — cek detail di log VPS Antigravity.
            <pre className="mt-1 text-xs whitespace-pre-wrap">{JSON.stringify(state, null, 2)}</pre>
          </div>
        </div>
      ) : (
        <div className="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded p-3 text-sm flex items-center gap-2">
          <ShieldCheck className="w-4 h-4" /> Tidak ada alarm aktif saat ini.
        </div>
      )}

      {status?.config && (
        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs text-gray-600">
          <div className="bg-gray-50 rounded p-2">
            <div className="font-semibold text-gray-800 truncate" title={ambangDisplay}>
              {ambangDisplay}
            </div>
            Ambang Spend Anomaly
          </div>
          <div className="bg-gray-50 rounded p-2">
            <div className="font-semibold text-gray-800">{targetCount} Campaign</div>
            Target Spend Anomaly
          </div>
          <div className="bg-gray-50 rounded p-2">
            <div className="font-semibold text-gray-800">
              {autoPauseDown ? 'Aktif' : 'Nonaktif'}
            </div>
            Auto-Pause Landing Down
          </div>
          <div className="bg-gray-50 rounded p-2">
            <div className="font-semibold text-gray-800">{landingPageCount} URL</div>
            Landing Page Dipantau
          </div>
        </div>
      )}
    </section>
  );
}

// ── Blok 2: Active Action Queue ─────────────────────────────────────────────

function SyncCronPlansButton({ onSynced }: { onSynced: () => void }) {
  const [bms, setBms] = useState<BmOption[]>([]);
  const [bmId, setBmId] = useState('');
  const [syncing, setSyncing] = useState(false);
  const [msg, setMsg] = useState('');
  const [err, setErr] = useState('');

  useEffect(() => {
    (async () => {
      try {
        const list = await apiGet<BmOption[]>('/business/meta-bms');
        setBms(list);
        if (list.length > 0) setBmId(list[0].id);
      } catch {
        // diamkan, tombol tetap tampil kosong
      }
    })();
  }, []);

  async function sinkron() {
    if (!bmId) {
      setErr('Pilih BM dulu.');
      return;
    }
    setSyncing(true);
    setErr('');
    setMsg('');
    try {
      const res = await apiPost<{ ok: boolean; masuk: number; dilewati: number; totalDitemukanDiVps45: number }>(
        '/ai-ads/sync-cron-plans',
        { bmId },
      );
      setMsg(
        res.masuk > 0
          ? `${res.masuk} rekomendasi baru dari cron masuk ke antrean.`
          : `Tidak ada rekomendasi baru (${res.totalDitemukanDiVps45} plan draft ditemukan di VPS 45, ${res.dilewati} sudah pernah masuk sebelumnya).`,
      );
      if (res.masuk > 0) onSynced();
    } catch (e: any) {
      setErr(e?.message || 'Gagal menyinkronkan.');
    } finally {
      setSyncing(false);
    }
  }

  return (
    <div className="border border-dashed border-emerald-200 rounded-lg p-3 bg-emerald-50/40 flex flex-wrap items-center gap-2">
      <RefreshCw className="w-4 h-4 text-emerald-600 flex-shrink-0" />
      <span className="text-xs text-emerald-800 font-medium">
        Rekomendasi dari cron 3-Shift (run_shift.py) belum otomatis muncul di sini.
      </span>
      <select className="border rounded px-2 py-1 text-xs" value={bmId} onChange={(e) => setBmId(e.target.value)}>
        {bms.length === 0 && <option value="">— Belum ada BM —</option>}
        {bms.map((b) => (
          <option key={b.id} value={b.id}>
            {b.name}
          </option>
        ))}
      </select>
      <button
        onClick={() => void sinkron()}
        disabled={syncing || !bmId}
        className="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white text-xs font-medium px-3 py-1.5 rounded"
      >
        {syncing ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <RefreshCw className="w-3.5 h-3.5" />}
        Sinkronkan dari Cron
      </button>
      {msg && <p className="text-xs text-emerald-700 w-full">{msg}</p>}
      {err && <p className="text-xs text-red-600 w-full">{err}</p>}
    </div>
  );
}

function TriggerForm({ onTriggered }: { onTriggered: () => void }) {
  const [bms, setBms] = useState<BmOption[]>([]);
  const [bmId, setBmId] = useState('');
  const [campaigns, setCampaigns] = useState<CampaignOption[]>([]);
  const [objectId, setObjectId] = useState('');
  const [shiftType, setShiftType] = useState<'MORNING_EARLY_KILL' | 'MID_DAY_PACING' | 'GOLDEN_HOUR_SCALING' | 'MANUAL_TRIGGER'>(
    'MANUAL_TRIGGER',
  );
  const [promptTambahan, setPromptTambahan] = useState('');
  const [loadingCampaigns, setLoadingCampaigns] = useState(false);
  const [submitting, setSubmitting] = useState(false);
  const [error, setError] = useState('');
  const [open, setOpen] = useState(false);

  useEffect(() => {
    (async () => {
      try {
        const list = await apiGet<BmOption[]>('/business/meta-bms');
        setBms(list);
        if (list.length > 0) setBmId(list[0].id);
      } catch {
        // diamkan, form tetap tampil kosong
      }
    })();
  }, []);

  useEffect(() => {
    if (!bmId) return;
    setLoadingCampaigns(true);
    setObjectId('');
    apiGet<{ campaigns: CampaignOption[] }>(`/business/meta-bms/${bmId}/campaigns`)
      .then((res) => setCampaigns(res.campaigns ?? []))
      .catch(() => setCampaigns([]))
      .finally(() => setLoadingCampaigns(false));
  }, [bmId]);

  async function kirim() {
    const campaign = campaigns.find((c) => c.id === objectId);
    if (!bmId || !campaign) {
      setError('Pilih BM dan campaign dulu.');
      return;
    }
    setSubmitting(true);
    setError('');
    try {
      await apiPost('/ai-ads/trigger', {
        bmId,
        shiftType,
        objectId: campaign.id,
        objectName: campaign.name,
        adAccountId: campaign.adAccountId,
        promptTambahan,
      });
      setPromptTambahan('');
      onTriggered();
    } catch (e: any) {
      setError(e?.message || 'Gagal memicu analisa.');
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <div className="border border-dashed border-indigo-200 rounded-lg p-4 bg-indigo-50/40">
      <button
        onClick={() => setOpen((v) => !v)}
        className="flex items-center gap-2 text-sm font-semibold text-indigo-700"
      >
        <Send className="w-4 h-4" />
        Trigger Analisa Manual
        {open ? <ChevronUp className="w-4 h-4" /> : <ChevronDown className="w-4 h-4" />}
      </button>
      {open && (
        <div className="mt-3 space-y-3">
          <p className="text-xs text-gray-500">
            Memanggil agy (LLM) via API Bridge VPS Antigravity — bisa sampai beberapa menit. Hasilnya
            masuk sebagai kartu &quot;Menunggu Approval&quot; di bawah, TIDAK langsung dieksekusi.
          </p>
          <div className="grid sm:grid-cols-2 gap-3">
            <div>
              <label className="text-xs text-gray-600 block mb-1">Business Manager</label>
              <select
                className="w-full border rounded px-2 py-1.5 text-sm"
                value={bmId}
                onChange={(e) => setBmId(e.target.value)}
              >
                {bms.length === 0 && <option value="">— Belum ada BM —</option>}
                {bms.map((b) => (
                  <option key={b.id} value={b.id}>
                    {b.name}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label className="text-xs text-gray-600 block mb-1">Jenis Evaluasi</label>
              <select
                className="w-full border rounded px-2 py-1.5 text-sm"
                value={shiftType}
                onChange={(e) => setShiftType(e.target.value as typeof shiftType)}
              >
                <option value="MANUAL_TRIGGER">Trigger Manual (bebas)</option>
                <option value="MORNING_EARLY_KILL">Morning Early-Kill</option>
                <option value="MID_DAY_PACING">Mid-Day Pacing</option>
                <option value="GOLDEN_HOUR_SCALING">Golden Hour Scaling</option>
              </select>
            </div>
          </div>
          <div>
            <label className="text-xs text-gray-600 block mb-1">
              Campaign {loadingCampaigns && <Loader2 className="w-3 h-3 inline animate-spin" />}
            </label>
            <select
              className="w-full border rounded px-2 py-1.5 text-sm"
              value={objectId}
              onChange={(e) => setObjectId(e.target.value)}
            >
              <option value="">— Pilih campaign —</option>
              {campaigns.map((c) => (
                <option key={c.id} value={c.id}>
                  {c.name} — {c.adAccountName}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label className="text-xs text-gray-600 block mb-1">Konteks tambahan (opsional)</label>
            <textarea
              className="w-full border rounded px-2 py-1.5 text-sm"
              rows={2}
              placeholder="Mis. 'fokus ke closing WA, jangan cuma leads mentah'"
              value={promptTambahan}
              onChange={(e) => setPromptTambahan(e.target.value)}
            />
          </div>
          {error && <p className="text-xs text-red-600">{error}</p>}
          <button
            onClick={() => void kirim()}
            disabled={submitting || !objectId}
            className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white text-sm font-medium px-4 py-2 rounded"
          >
            {submitting ? <Loader2 className="w-4 h-4 animate-spin" /> : <Send className="w-4 h-4" />}
            Jalankan Analisa
          </button>
        </div>
      )}
    </div>
  );
}

function RecommendationCard({ rec, onChanged }: { rec: AiAdsRecommendation; onChanged: () => void }) {
  const [busy, setBusy] = useState(false);
  const [showRaw, setShowRaw] = useState(false);
  const [rejectReason, setRejectReason] = useState('');
  const [showRejectBox, setShowRejectBox] = useState(false);
  const [err, setErr] = useState('');

  async function approve() {
    setBusy(true);
    setErr('');
    try {
      await apiPost(`/ai-ads/approve`, { id: rec.id });
      onChanged();
    } catch (e: any) {
      setErr(e?.message || 'Gagal approve.');
    } finally {
      setBusy(false);
    }
  }

  async function reject() {
    setBusy(true);
    setErr('');
    try {
      await apiPost(`/ai-ads/reject`, { id: rec.id, reason: rejectReason });
      onChanged();
    } catch (e: any) {
      setErr(e?.message || 'Gagal menolak.');
    } finally {
      setBusy(false);
    }
  }

  const reason = (rec.planSummary?.reason as string) || null;
  const blastRadius = (rec.planSummary?.blast_radius as string) || null;

  return (
    <div className="border rounded-lg p-4 space-y-2 bg-white">
      <div className="flex items-start justify-between gap-2">
        <div>
          <span className={`text-[11px] px-2 py-0.5 rounded-full font-medium ${STATUS_BADGE[rec.status]}`}>
            {STATUS_LABEL[rec.status]}
          </span>
          <div className="text-sm font-semibold mt-1">{SHIFT_LABEL[rec.shiftType] || rec.shiftType}</div>
          <div className="text-xs text-gray-400">{formatWaktu(rec.createdAt)}</div>
        </div>
      </div>

      {!rec.planPath && (
        <p className="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded p-2">
          ⚠️ Lokasi file plan tidak terdeteksi otomatis dari output agy — perlu cek manual sebelum bisa
          di-approve.
        </p>
      )}

      {reason && <p className="text-sm text-gray-700">{reason}</p>}
      {blastRadius && <p className="text-xs text-gray-500">Blast radius: {blastRadius}</p>}

      {rec.rawAgyOutput && (
        <div>
          <button onClick={() => setShowRaw((v) => !v)} className="text-xs text-indigo-600 flex items-center gap-1">
            {showRaw ? <ChevronUp className="w-3 h-3" /> : <ChevronDown className="w-3 h-3" />}
            {showRaw ? 'Sembunyikan' : 'Lihat'} output lengkap agy
          </button>
          {showRaw && (
            <pre className="mt-1 text-xs bg-gray-50 border rounded p-2 max-h-64 overflow-auto whitespace-pre-wrap">
              {rec.rawAgyOutput}
            </pre>
          )}
        </div>
      )}

      {rec.status === 'EXECUTION_FAILED' && rec.executionResult && (
        <pre className="text-xs bg-red-50 border border-red-200 rounded p-2 max-h-40 overflow-auto whitespace-pre-wrap text-red-700">
          {JSON.stringify(rec.executionResult, null, 2)}
        </pre>
      )}

      {rec.status === 'REJECTED' && rec.rejectionReason && (
        <p className="text-xs text-gray-500">Alasan tolak: {rec.rejectionReason}</p>
      )}

      {err && <p className="text-xs text-red-600">{err}</p>}

      {(rec.status === 'PENDING_APPROVAL' || rec.status === 'EXECUTION_FAILED') && (
        <div className="flex items-center gap-2 pt-1">
          <button
            onClick={() => void approve()}
            disabled={busy || !rec.planPath}
            className="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 text-white text-sm font-medium px-3 py-1.5 rounded"
          >
            {busy ? <Loader2 className="w-4 h-4 animate-spin" /> : <CheckCircle2 className="w-4 h-4" />}
            {rec.status === 'EXECUTION_FAILED' ? 'Coba Eksekusi Lagi' : 'APPROVE & EKSEKUSI KE META'}
          </button>
          {rec.status === 'PENDING_APPROVAL' && (
            <button
              onClick={() => setShowRejectBox((v) => !v)}
              disabled={busy}
              className="flex items-center gap-1.5 text-red-600 hover:text-red-800 text-sm font-medium px-3 py-1.5 rounded border border-red-200"
            >
              <XCircle className="w-4 h-4" /> Reject
            </button>
          )}
        </div>
      )}

      {showRejectBox && (
        <div className="flex items-center gap-2 pt-1">
          <input
            className="flex-1 border rounded px-2 py-1 text-xs"
            placeholder="Alasan (opsional)"
            value={rejectReason}
            onChange={(e) => setRejectReason(e.target.value)}
          />
          <button
            onClick={() => void reject()}
            disabled={busy}
            className="text-xs bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded"
          >
            Konfirmasi Tolak
          </button>
        </div>
      )}

      {rec.status === 'EXECUTED' && (
        <p className="text-xs text-emerald-700">Dieksekusi {formatWaktu(rec.executedAt)}.</p>
      )}
    </div>
  );
}

function ActionQueueBlock() {
  const [recs, setRecs] = useState<AiAdsRecommendation[]>([]);
  const [loading, setLoading] = useState(true);

  const muat = useCallback(async () => {
    try {
      const res = await apiGet<{ plans: AiAdsRecommendation[] }>('/ai-ads/plans?status=PENDING_APPROVAL');
      const res2 = await apiGet<{ plans: AiAdsRecommendation[] }>('/ai-ads/plans?status=EXECUTION_FAILED');
      setRecs([...(res.plans ?? []), ...(res2.plans ?? [])]);
    } catch {
      // diamkan, biar UI tetap tampil dengan data terakhir
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    void muat();
    const t = setInterval(muat, 20000);
    return () => clearInterval(t);
  }, [muat]);

  return (
    <section className="bg-white rounded-lg shadow border border-gray-100 p-5 space-y-4">
      <div className="flex items-center gap-2">
        <ListChecks className="w-5 h-5 text-indigo-600" />
        <h2 className="text-base font-bold">Blok 2 — Active Action Queue</h2>
      </div>
      <p className="text-xs text-gray-500">
        Kartu rekomendasi 3-Shift &amp; hasil trigger manual yang menunggu keputusan Bossfren. Klik APPROVE
        untuk langsung eksekusi ke Meta Ads (lewat execute_mutation.py di VPS Antigravity), atau REJECT
        untuk menolak.
      </p>

      <TriggerForm onTriggered={muat} />
      <SyncCronPlansButton onSynced={muat} />

      {loading ? (
        <div className="text-sm text-gray-400 flex items-center gap-2">
          <Loader2 className="w-4 h-4 animate-spin" /> Memuat antrean…
        </div>
      ) : recs.length === 0 ? (
        <div className="text-sm text-gray-400 text-center py-6">Tidak ada rekomendasi menunggu saat ini.</div>
      ) : (
        <div className="grid sm:grid-cols-2 gap-4">
          {recs.map((r) => (
            <RecommendationCard key={r.id} rec={r} onChanged={muat} />
          ))}
        </div>
      )}
    </section>
  );
}

// ── Blok 3: Health Score & Quick Wins ───────────────────────────────────────

function HealthScoreBlock() {
  const [bms, setBms] = useState<BmOption[]>([]);
  const [bmId, setBmId] = useState('');
  const [platform, setPlatform] = useState<'meta' | 'google' | 'tiktok'>('meta');
  const [adAccounts, setAdAccounts] = useState<AdAccountOption[]>([]);
  const [adAccountId, setAdAccountId] = useState('');
  const [loadingAdAccounts, setLoadingAdAccounts] = useState(false);
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<any>(null);
  const [error, setError] = useState('');

  useEffect(() => {
    (async () => {
      try {
        const list = await apiGet<BmOption[]>('/business/meta-bms');
        setBms(list);
        if (list.length > 0) setBmId(list[0].id);
      } catch {
        // diamkan
      }
    })();
  }, []);

  // [2026-08-25 restore -- lihat wasit note] Dropdown Ad Account, WAJIB diisi untuk platform Meta
  // (divalidasi backend juga). Endpoint sama dgn modal "Kelola Aset BM" (GET /business/meta-bms/:id/assets),
  // bentuk respons NESTED {bm, assets:{adAccounts,...}} -- baca res.assets?.adAccounts, BUKAN res.adAccounts
  // top-level (pernah jadi bug tersendiri sebelumnya, dropdown selalu kosong).
  useEffect(() => {
    setAdAccountId('');
    if (!bmId) {
      setAdAccounts([]);
      return;
    }
    setLoadingAdAccounts(true);
    apiGet<{ assets: { adAccounts: AdAccountOption[] } }>(`/business/meta-bms/${bmId}/assets`)
      .then((res) => setAdAccounts(res.assets?.adAccounts ?? []))
      .catch(() => setAdAccounts([]))
      .finally(() => setLoadingAdAccounts(false));
  }, [bmId]);

  async function hitung() {
    if (!bmId) {
      setError('Pilih BM dulu.');
      return;
    }
    if (platform === 'meta' && !adAccountId) {
      setError('Pilih akun iklan dulu.');
      return;
    }
    setLoading(true);
    setError('');
    setResult(null);
    try {
      const res = await apiPost('/ai-ads/health-score', { bmId, platform, adAccountId });
      setResult(res);
    } catch (e: any) {
      setError(e?.message || 'Gagal menghitung Health Score.');
    } finally {
      setLoading(false);
    }
  }

  const score = result?.structured ? Number(result.score) : null;
  const scoreColor = score === null ? 'text-gray-400' : score >= 85 ? 'text-emerald-600' : score >= 60 ? 'text-amber-600' : 'text-red-600';

  return (
    <section className="bg-white rounded-lg shadow border border-gray-100 p-5 space-y-4">
      <div className="flex items-center gap-2">
        <Gauge className="w-5 h-5 text-indigo-600" />
        <h2 className="text-base font-bold">Blok 3 — Health Score &amp; Quick Wins</h2>
      </div>
      <p className="text-xs text-gray-500">
        Skor kesehatan akun (0-100, 116 cek) via skills/ads-score + ranking perbaikan prioritas via
        skills/ads-next. Dihitung on-demand (bisa sampai beberapa menit, memanggil agy).
      </p>

      <div className="flex flex-wrap items-end gap-3">
        <div>
          <label className="text-xs text-gray-600 block mb-1">Business Manager</label>
          <select className="border rounded px-2 py-1.5 text-sm" value={bmId} onChange={(e) => setBmId(e.target.value)}>
            {bms.length === 0 && <option value="">— Belum ada BM —</option>}
            {bms.map((b) => (
              <option key={b.id} value={b.id}>
                {b.name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label className="text-xs text-gray-600 block mb-1">Platform</label>
          <select
            className="border rounded px-2 py-1.5 text-sm"
            value={platform}
            onChange={(e) => setPlatform(e.target.value as typeof platform)}
          >
            <option value="meta">Meta</option>
            <option value="google">Google</option>
            <option value="tiktok">TikTok</option>
          </select>
        </div>
        {platform === 'meta' && (
          <div>
            <label className="text-xs text-gray-600 block mb-1">
              Akun Iklan {loadingAdAccounts && <Loader2 className="w-3 h-3 inline animate-spin" />}
            </label>
            <select
              className="border rounded px-2 py-1.5 text-sm"
              value={adAccountId}
              onChange={(e) => setAdAccountId(e.target.value)}
            >
              <option value="">
                {loadingAdAccounts ? '— Memuat... —' : adAccounts.length === 0 ? '— Belum ada akun iklan —' : '— Pilih akun iklan —'}
              </option>
              {adAccounts.map((a) => (
                <option key={a.id} value={a.id}>
                  {a.name} ({a.accountId})
                </option>
              ))}
            </select>
          </div>
        )}
        <button
          onClick={() => void hitung()}
          disabled={loading || !bmId || (platform === 'meta' && !adAccountId)}
          className="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white text-sm font-medium px-4 py-2 rounded"
        >
          {loading ? <Loader2 className="w-4 h-4 animate-spin" /> : <Sparkles className="w-4 h-4" />}
          Hitung Health Score
        </button>
      </div>

      {error && <p className="text-xs text-red-600">{error}</p>}

      {result && result.structured && (
        <div className="space-y-3 pt-2">
          <div className="flex items-center gap-4">
            <div className={`text-4xl font-black ${scoreColor}`}>{score}</div>
            <div className="text-sm text-gray-500">dari 100</div>
          </div>
          {Array.isArray(result.quickWins) && result.quickWins.length > 0 && (
            <div>
              <h3 className="text-sm font-semibold flex items-center gap-1.5 mb-1">
                <TrendingUp className="w-4 h-4 text-indigo-600" /> Quick Wins
              </h3>
              <ul className="text-sm text-gray-700 list-disc list-inside space-y-0.5">
                {result.quickWins.map((q: any, i: number) => (
                  <li key={i}>{typeof q === 'string' ? q : JSON.stringify(q)}</li>
                ))}
              </ul>
            </div>
          )}
        </div>
      )}

      {result && !result.structured && (
        <div>
          <p className="text-xs text-gray-500 mb-1">
            Hasil belum bisa diparsing jadi skor terstruktur — ini teks mentah dari agy:
          </p>
          <pre className="text-xs bg-gray-50 border rounded p-2 max-h-64 overflow-auto whitespace-pre-wrap">
            {result.rawText}
          </pre>
        </div>
      )}
    </section>
  );
}

