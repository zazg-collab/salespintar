'use client';

/**
 * Konfigurasi Meta Conversions API (CAPI) — Fase 40 (2026-08-20).
 *
 * Kenapa halaman ini ada: gantikan aplikasi pihak ketiga (koneksiku.web.id) dengan integrasi
 * CAPI native, otomatis dari data yang SalesPintar sudah hitung sendiri (leadCategory, leadStage,
 * conversionStatus, confirmedCodAmount) -- lihat rencana lengkap di
 * projek-ceo/20260820-rencana-integrasi-meta-capi.md.
 *
 * ⚠️ ATURAN WAJIB (audit Fase 39, temuan #1): backend TIDAK PERNAH mengembalikan access token
 * mentah/terenkripsi. Field token di bawah SELALU dimulai KOSONG saat halaman dibuka -- kalau
 * dibiarkan kosong saat simpan, token yang tersimpan TIDAK berubah. Yang ditampilkan cuma status
 * "sudah diisi" + preview tersamar (mis. "EAAbc1••••"), BUKAN nilai aslinya. Ini SENGAJA beda dari
 * pola input API Key Mengantar di halaman Pengaturan (yang bind nilai mentah ke input) -- access
 * token Meta System User jauh lebih sensitif kalau bocor ke Network tab browser.
 */

import { useState, useEffect, useCallback } from 'react';
import { apiGet, apiPatch, apiPost, apiPut, apiDelete } from '../../../lib/api';
import {
  Megaphone, Loader2, Save, AlertCircle, CheckCircle, KeyRound,
  ShieldCheck, Info, ToggleLeft, ToggleRight, Trash2, Edit, Plus, X,
  ExternalLink, Building2, Target, Shield, Check, Layers, RefreshCw, Zap,
} from 'lucide-react';


interface CustomPixel {
  id?: string;
  name: string;
  pixelId: string;
  accessToken: string;
  landingPageUrls: string[];
  isActive: boolean;
}

interface MetaCapiConfig {
  metaCapiEnabled: boolean;
  metaCapiConfigured: boolean;
  metaCapiPixelId: string | null;
  metaCapiTestEventCode: string | null;
  metaCapiWabaId: string | null;
  metaCapiCurrency: string;
  metaCapiTokenPreview: string | null;
  metaCapiEventMap?: any;
  updatedAt?: string;
}

const DEFAULT_EVENT_MAP = {
  NEW_LEAD: 'ViewContent',
  WARM: 'Lead',
  HOT: 'AddToCart',
  CLOSING: 'Purchase'
};

const STANDARD_META_EVENTS = [
  'ViewContent', 'Lead', 'AddToCart', 'Purchase', 
  'InitiateCheckout', 'Contact', 'CustomizeProduct', 
  'Schedule', 'SubmitApplication'
];

export default function MetaCapiPage() {
  const [loading, setLoading] = useState(true);
  const [savingCreds, setSavingCreds] = useState(false);
  const [saveCredsMsg, setSaveCredsMsg] = useState<string | null>(null);
  const [savingMap, setSavingMap] = useState(false);
  const [saveMapMsg, setSaveMapMsg] = useState<string | null>(null);
  const [savingStatus, setSavingStatus] = useState(false);
  const [testing, setTesting] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [testResult, setTestResult] = useState<{ success: boolean; message: string } | null>(null);

  const [config, setConfig] = useState<MetaCapiConfig | null>(null);

  // Form fields -- terpisah dari `config` (snapshot server) supaya field token
  // TIDAK PERNAH diisi dari respons server (lihat catatan di atas).
  const [enabled, setEnabled] = useState(false);
  const [pixelId, setPixelId] = useState('');
  const [accessToken, setAccessToken] = useState(''); // selalu mulai kosong
  const [deleteToken, setDeleteToken] = useState(false);
  const [testEventCode, setTestEventCode] = useState('');
  const [wabaId, setWabaId] = useState('');
  const [currency, setCurrency] = useState('IDR');
  
  const [eventMap, setEventMap] = useState<Record<string, string>>(DEFAULT_EVENT_MAP);
  const [customPixels, setCustomPixels] = useState<CustomPixel[]>([]);
  const [showPixelModal, setShowPixelModal] = useState(false);
  const [editingPixel, setEditingPixel] = useState<CustomPixel | null>(null);
  const [pixelForm, setPixelForm] = useState<CustomPixel>({ name: '', pixelId: '', accessToken: '', landingPageUrls: [], isActive: true });
  const [newUrl, setNewUrl] = useState('');
  const [modalError, setModalError] = useState<string | null>(null);
  const [savingPixel, setSavingPixel] = useState(false);

  // ── State: mode BM di modal Tambah Pixel ─────────────────────────────────────
  const [pixelUseBm, setPixelUseBm] = useState(false);        // toggle "ambil dari BM"
  const [pixelSelectedBmId, setPixelSelectedBmId] = useState('');  // BM yg dipilih
  const [bmPixelOptions, setBmPixelOptions] = useState<{ id: string; name: string }[]>([]);
  const [bmPixelsLoading, setBmPixelsLoading] = useState(false);
  const [bmPixelsError, setBmPixelsError] = useState<string | null>(null);

  const cleanUrlInput = (raw: string): string => {
    return raw
      .trim()
      .toLowerCase()
      .replace(/^https?:\/\//, '')
      .split('?')[0]
      .split('#')[0]
      .replace(/\/+$/, '');
  };

  const muat = useCallback(async () => {
    setLoading(true);
    setError(null);
    try {
      const res = await apiGet<MetaCapiConfig>('/business/meta-capi');
      setConfig(res);
      setEnabled(res.metaCapiEnabled);
      setPixelId(res.metaCapiPixelId ?? '');
      setTestEventCode(res.metaCapiTestEventCode ?? '');
      setWabaId(res.metaCapiWabaId ?? '');
      setCurrency(res.metaCapiCurrency ?? 'IDR');
      if (res.metaCapiEventMap && typeof res.metaCapiEventMap === 'object') {
        setEventMap(res.metaCapiEventMap);
      } else {
        setEventMap(DEFAULT_EVENT_MAP);
      }
      setAccessToken(''); // tegas: jangan pernah diisi dari server

      const pixels = await apiGet<CustomPixel[]>('/business/meta-pixels');
      setCustomPixels(pixels);

    } catch (e: any) {
      setError(e?.message || 'Gagal memuat konfigurasi Meta CAPI');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void muat(); }, [muat]);

  const simpanKredensial = useCallback(async () => {
    setSavingCreds(true);
    setError(null);
    setSaveCredsMsg(null);
    try {
      const body: Record<string, unknown> = {
        metaCapiPixelId: pixelId.trim(),
        metaCapiTestEventCode: testEventCode.trim(),
        metaCapiWabaId: wabaId.trim(),
        metaCapiCurrency: currency.trim(),
      };
      if (deleteToken) {
        body.metaCapiAccessToken = '';
      } else if (accessToken.trim()) {
        body.metaCapiAccessToken = accessToken.trim();
      }

      const res = await apiPatch<MetaCapiConfig & { message?: string }>('/business/meta-capi', body);
      setConfig(res);
      setAccessToken('');
      setDeleteToken(false);
      setSaveCredsMsg(res.message || 'Kredensial tersimpan.');
    } catch (e: any) {
      setError(e?.message || 'Gagal menyimpan kredensial');
    } finally {
      setSavingCreds(false);
    }
  }, [pixelId, accessToken, testEventCode, wabaId, currency]);

  const simpanPemetaan = useCallback(async () => {
    setSavingMap(true);
    setError(null);
    setSaveMapMsg(null);
    try {
      const res = await apiPatch<MetaCapiConfig & { message?: string }>('/business/meta-capi', {
        metaCapiEventMap: eventMap,
      });
      setConfig(res);
      setSaveMapMsg('Pemetaan event berhasil disimpan.');
    } catch (e: any) {
      setError(e?.message || 'Gagal menyimpan pemetaan event');
    } finally {
      setSavingMap(false);
    }
  }, [eventMap]);

  const toggleAktif = useCallback(async (next: boolean) => {
    setSavingStatus(true);
    setError(null);
    try {
      const res = await apiPatch<MetaCapiConfig & { message?: string }>('/business/meta-capi', { metaCapiEnabled: next });
      setConfig(res);
      setEnabled(res.metaCapiEnabled);
    } catch (e: any) {
      setEnabled(!next); // batalkan toggle optimis kalau gagal (mis. belum lengkap kredensial)
      setError(e?.message || 'Gagal mengubah status aktif');
    } finally {
      setSavingStatus(false);
    }
  }, []);

  const tesKoneksi = useCallback(async () => {
    setTesting(true);
    setTestResult(null);
    setError(null);
    try {
      const res = await apiPost<{ success: boolean; message: string }>('/business/meta-capi/test-connection');
      setTestResult(res);
    } catch (e: any) {
      setTestResult({ success: false, message: e?.message || 'Tes koneksi gagal' });
    } finally {
      setTesting(false);
    }
  }, []);

  const handleSavePixel = async () => {
    setModalError(null);
    if (!pixelForm.name.trim() || !pixelForm.pixelId.trim()) {
      setModalError('Nama dan Pixel ID wajib diisi');
      return;
    }
    
    // Validasi sesuai mode
    if (!editingPixel) {
      if (pixelUseBm && !pixelSelectedBmId) {
        setModalError('Pilih BM terlebih dahulu');
        return;
      }
      if (!pixelUseBm && !pixelForm.accessToken.trim()) {
        setModalError('Access Token System User wajib diisi untuk Pixel baru');
        return;
      }
    }

    setSavingPixel(true);
    try {
      // Mode BM: kirim bmId ke backend, backend salin token sendiri dari DB
      // Mode manual: kirim accessToken seperti biasa
      const body: Record<string, any> = {
        name: pixelForm.name.trim(),
        pixelId: pixelForm.pixelId.trim(),
        landingPageUrls: pixelForm.landingPageUrls,
        isActive: pixelForm.isActive,
      };

      if (pixelUseBm && !editingPixel) {
        body.bmId = pixelSelectedBmId;
      } else if (pixelForm.accessToken.trim()) {
        body.accessToken = pixelForm.accessToken.trim();
      }
      
      if (editingPixel?.id) {
        await apiPut(`/business/meta-pixels/${editingPixel.id}`, body);
      } else {
        await apiPost('/business/meta-pixels', body);
      }
      setShowPixelModal(false);
      void muat();
    } catch (e: any) {
      setModalError(e.message || 'Gagal menyimpan pixel');
    } finally {
      setSavingPixel(false);
    }
  };

  const handleDeletePixel = async (id: string) => {
    if (!window.confirm('Hapus konfigurasi pixel ini?')) return;
    try {
      await apiDelete(`/business/meta-pixels/${id}`);
      void muat();
    } catch (e: any) {
      setError(e.message || 'Gagal menghapus pixel');
    }
  };

  // Fetch daftar pixel dari BM yg dipilih via endpoint /assets
  const handleBmSelectForPixel = async (bmId: string) => {
    setPixelSelectedBmId(bmId);
    setBmPixelOptions([]);
    setBmPixelsError(null);
    setPixelForm(f => ({ ...f, pixelId: '' })); // reset pilihan pixel
    if (!bmId) return;
    setBmPixelsLoading(true);
    try {
      const res = await apiGet<{ assets: { pixels: { id: string; name: string }[] } }>(`/business/meta-bms/${bmId}/assets`);
      setBmPixelOptions(res.assets?.pixels ?? []);
      if (!res.assets?.pixels?.length) {
        setBmPixelsError('Tidak ada Pixel / Dataset yang terdeteksi di BM ini');
      }
    } catch (err: any) {
      setBmPixelsError(err?.message || 'Gagal memuat daftar Pixel dari BM');
    } finally {
      setBmPixelsLoading(false);
    }
  };

  const openNewPixelModal = () => {
    setEditingPixel(null);
    setPixelForm({ name: '', pixelId: '', accessToken: '', landingPageUrls: [], isActive: true });
    setNewUrl('');
    setModalError(null);
    // Reset BM mode state
    setPixelUseBm(false);
    setPixelSelectedBmId('');
    setBmPixelOptions([]);
    setBmPixelsError(null);
    setShowPixelModal(true);
  };

  const openEditPixelModal = (pixel: CustomPixel) => {
    setEditingPixel(pixel);
    setPixelForm({ ...pixel, accessToken: '' }); // Kosongkan token untuk keamanan
    setNewUrl('');
    setModalError(null);
    // Mode BM tidak tersedia saat edit (token sudah tersimpan di DB)
    setPixelUseBm(false);
    setPixelSelectedBmId('');
    setBmPixelOptions([]);
    setBmPixelsError(null);
    setShowPixelModal(true);
  };


  const [activeTab, setActiveTab] = useState<'general' | 'bm_accounts' | 'datasets' | 'logs'>('general');

  // ── State: Manajemen Akun BM (Tab 2) ──────────────────────────────────────────
  interface BmAccount {
    id: string;
    name: string;
    metaBusinessId: string | null;
    picName: string;
    tokenPreview: string | null;
    tokenStatus: 'ACTIVE' | 'ERROR' | 'EXPIRED';
    isActive: boolean;
    createdAt: string;
  }

  interface BmAssetData {
    bm: {
      id: string;
      name: string;
      picName: string;
      metaBusinessId: string | null;
      tokenStatus: string;
      createdAt: string;
    };
    assets: {
      adAccounts: {
        id: string;
        accountId: string;
        name: string;
        status: string;
        currency: string;
        timezone: string;
        amountSpent: number;
      }[];
      pixels: {
        id: string;
        name: string;
        setting?: string;
        creationTime?: string;
        connectedAdAccount?: string;
      }[];
      permissions: string[];
    };
  }

  interface AutomationDefaults {
    thresholdShift: {
      enabled: boolean;
      default: {
        morningEarlyKill: { costThreshold: number; cpcKillMultiplier: number };
        middayPacing: { dailyBudget: number; dailyLeadsTarget: number; spendPaceThreshold: number; leadsPaceThreshold: number; reducePct: number };
        goldenHourScaling: { roasTarget: number; scalePct: number; maxDailyBudgetCeiling: number };
      };
    };
    spendAnomaly: { enabled: boolean; default: { spendIncreasePctThreshold: number } };
    landingPageCheck: { enabled: boolean; autoPauseOnDown: boolean; timeoutSeconds: number };
  }

  const [bms, setBms] = useState<BmAccount[]>([]);
  const [bmLoading, setBmLoading] = useState(false);
  const [showBmModal, setShowBmModal] = useState(false);
  const [editingBm, setEditingBm] = useState<BmAccount | null>(null);
  const [bmForm, setBmForm] = useState({ name: '', picName: '', accessToken: '', metaBusinessId: '' });
  const [bmModalError, setBmModalError] = useState<string | null>(null);
  const [savingBm, setSavingBm] = useState(false);
  const [testingBm, setTestingBm] = useState<string | null>(null); // ID BM yang sedang diuji

  const [selectedAssetBm, setSelectedAssetBm] = useState<BmAccount | null>(null);
  const [assetData, setAssetData] = useState<BmAssetData | null>(null);
  const [assetLoading, setAssetLoading] = useState(false);
  const [assetError, setAssetError] = useState<string | null>(null);

  const [automationDefaults, setAutomationDefaults] = useState<AutomationDefaults | null>(null);
  const [automationLoading, setAutomationLoading] = useState(false);
  const [automationSaving, setAutomationSaving] = useState(false);
  const [automationError, setAutomationError] = useState<string | null>(null);
  const [automationSaved, setAutomationSaved] = useState<string | null>(null);

  const handleOpenBmAssets = async (bm: BmAccount) => {
    setSelectedAssetBm(bm);
    setAssetLoading(true);
    setAssetError(null);
    setAssetData(null);
    setAutomationLoading(true);
    setAutomationError(null);
    setAutomationSaved(null);
    try {
      const res = await apiGet<BmAssetData>(`/business/meta-bms/${bm.id}/assets`);
      setAssetData(res);
    } catch (err: any) {
      setAssetError(err?.message || 'Gagal memuat detail aset terhubung');
    } finally {
      setAssetLoading(false);
    }
    try {
      const auto = await apiGet<AutomationDefaults>(`/business/meta-bms/${bm.id}/automation-defaults`);
      setAutomationDefaults(auto);
    } catch (err: any) {
      setAutomationError(err?.message || 'Gagal memuat setelan otomatisasi AI Ads');
    } finally {
      setAutomationLoading(false);
    }
  };

  const handleSaveAutomationDefaults = async () => {
    if (!selectedAssetBm || !automationDefaults) return;
    setAutomationSaving(true);
    setAutomationError(null);
    setAutomationSaved(null);
    try {
      const res = await apiPut<AutomationDefaults>(`/business/meta-bms/${selectedAssetBm.id}/automation-defaults`, automationDefaults);
      setAutomationDefaults(res);
      setAutomationSaved('Setelan otomatisasi AI Ads tersimpan.');
    } catch (err: any) {
      setAutomationError(err?.message || 'Gagal menyimpan setelan otomatisasi AI Ads');
    } finally {
      setAutomationSaving(false);
    }
  };

  const fetchBms = useCallback(async () => {
    setBmLoading(true);
    try {
      const data = await apiGet<BmAccount[]>('/business/meta-bms');
      setBms(data);
    } catch (e) { /* silent */ } finally { setBmLoading(false); }
  }, []);

  useEffect(() => { if (activeTab === 'bm_accounts' || activeTab === 'datasets') void fetchBms(); }, [activeTab, fetchBms]);


  const handleSaveBm = async () => {
    setBmModalError(null);
    if (!bmForm.name.trim()) { setBmModalError('Nama BM wajib diisi'); return; }
    if (!bmForm.picName.trim()) { setBmModalError('PIC Marketing wajib diisi'); return; }
    if (!editingBm && !bmForm.accessToken.trim()) { setBmModalError('Access Token wajib diisi untuk BM baru'); return; }
    setSavingBm(true);
    try {
      const body: Record<string, string> = { name: bmForm.name, picName: bmForm.picName };
      if (bmForm.accessToken.trim()) body.accessToken = bmForm.accessToken;
      if (bmForm.metaBusinessId.trim()) body.metaBusinessId = bmForm.metaBusinessId;
      if (editingBm) {
        await apiPut(`/business/meta-bms/${editingBm.id}`, body);
      } else {
        await apiPost('/business/meta-bms', body);
      }
      setShowBmModal(false);
      void fetchBms();
    } catch (e: any) { setBmModalError(e.message || 'Gagal menyimpan BM'); }
    finally { setSavingBm(false); }
  };

  const handleTestBm = async (id: string) => {
    setTestingBm(id);
    try {
      const res = await apiPost<{ success: boolean; message: string; tokenStatus: string }>(`/business/meta-bms/${id}/test`, {});
      alert(res.message);
      void fetchBms();
    } catch (e: any) { alert(e.message || 'Gagal menguji koneksi BM'); }
    finally { setTestingBm(null); }
  };

  const handleDeleteBm = async (id: string, name: string) => {
    if (!confirm(`Hapus BM "${name}"? Token yang tersimpan akan dihapus permanen.`)) return;
    try {
      await apiDelete(`/business/meta-bms/${id}`);
      void fetchBms();
    } catch (e: any) { alert(e.message || 'Gagal menghapus BM'); }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center py-24 text-gray-400">
        <Loader2 className="w-6 h-6 animate-spin" />
      </div>
    );
  }

  return (
    <div className="max-w-3xl mx-auto py-6 px-4 space-y-5">
      <div>
        <h1 className="text-lg font-semibold text-gray-900 flex items-center gap-2">
          <Megaphone className="w-5 h-5 text-indigo-600" />
          Integrasi Meta Conversions API (CAPI)
        </h1>
        <p className="text-sm text-gray-500 mt-1">
          Kirim otomatis event Lead / ViewContent / AddToCart / Purchase ke Meta dari data yang sudah
          dihitung SalesPintar sendiri -- tanpa entri manual, gantikan aplikasi pihak ketiga.
        </p>
      </div>

      <div className="flex border-b border-gray-200 mt-4 overflow-x-auto">
        <button
          onClick={() => setActiveTab('general')}
          className={`px-4 py-2 text-sm font-medium border-b-2 whitespace-nowrap ${activeTab === 'general' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700'}`}
        >
          Pengaturan Umum
        </button>
        <button
          onClick={() => setActiveTab('bm_accounts')}
          className={`px-4 py-2 text-sm font-medium border-b-2 whitespace-nowrap ${activeTab === 'bm_accounts' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700'}`}
        >
          Manajemen Akun BM
        </button>
        <button
          onClick={() => setActiveTab('datasets')}
          className={`px-4 py-2 text-sm font-medium border-b-2 whitespace-nowrap ${activeTab === 'datasets' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700'}`}
        >
          Manajemen Dataset
        </button>
        <button
          onClick={() => setActiveTab('logs')}
          className={`px-4 py-2 text-sm font-medium border-b-2 whitespace-nowrap ${activeTab === 'logs' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700'}`}
        >
          Log &amp; Uji Coba CAPI
        </button>
      </div>

      {activeTab === 'general' && (
        <div className="space-y-5">


      {error && (
        <div className="flex items-start gap-2 text-xs rounded-lg p-3 text-rose-800 bg-rose-50 border border-rose-200">
          <AlertCircle className="w-4 h-4 flex-shrink-0 text-rose-600 mt-0.5" />
          <span>{error}</span>
        </div>
      )}

      {/* Sakelar aktif/nonaktif */}
      <div className="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
        <div className="flex items-center justify-between gap-3">
          <div>
            <h2 className="text-sm font-semibold text-gray-900">Status Integrasi</h2>
            <p className="text-xs text-gray-500 mt-0.5">
              {config?.metaCapiConfigured
                ? 'Kredensial lengkap. Aktifkan untuk mulai mengirim event ke Meta.'
                : 'Isi & simpan Pixel ID + Access Token dulu sebelum bisa diaktifkan.'}
            </p>
          </div>
          <button
            onClick={() => void toggleAktif(!enabled)}
            disabled={savingStatus || (!enabled && !config?.metaCapiConfigured)}
            className="flex items-center gap-1.5 disabled:opacity-40"
          >
            {enabled ? (
              <ToggleRight className="w-9 h-9 text-emerald-600" />
            ) : (
              <ToggleLeft className="w-9 h-9 text-gray-300" />
            )}
          </button>
        </div>
      </div>

      {/* CARD 1: Form kredensial Master / Default Pixel */}
      <div className="bg-white border border-gray-200 rounded-xl p-5 shadow-sm space-y-4">
        <div>
          <h2 className="text-sm font-semibold text-gray-900">Kredensial Default (Master Pixel)</h2>
          <p className="text-xs text-gray-500 mt-0.5">
            Piksel default utama yang digunakan untuk pengiriman event CAPI atau sebagai <em>fallback</em> jika URL landing page tidak terdaftar di Multi-Pixel.
          </p>
        </div>

        <div>
          <label className="block text-xs font-medium text-gray-700 mb-1">Pixel ID</label>
          <input
            type="text"
            value={pixelId}
            onChange={(e) => setPixelId(e.target.value)}
            placeholder="mis. 1242353536834553"
            className="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
          />
        </div>

        <div>
          <label className="block text-xs font-medium text-gray-700 mb-1">
            Access Token (System User)
            {config?.metaCapiTokenPreview && (
              <span className="ml-2 text-emerald-600 font-normal">tersimpan: {config.metaCapiTokenPreview}</span>
            )}
          </label>
          <div className="relative">
            <div className="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
              <KeyRound className="w-4 h-4" />
            </div>
            <input
              type="password"
              value={accessToken}
              onChange={(e) => setAccessToken(e.target.value)}
              disabled={deleteToken}
              placeholder={config?.metaCapiConfigured ? 'Kosongkan jika tidak ingin mengubah token' : 'Tempel access token System User di sini'}
