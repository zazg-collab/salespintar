                          {automationDefaults.spendAnomaly.enabled && (
                            <div className="flex items-center gap-2 mt-3 ml-6">
                              <label className="text-xs text-gray-600">Threshold kenaikan spend</label>
                              <input type="number" className="w-20 border rounded px-2 py-1 text-xs"
                                value={automationDefaults.spendAnomaly.default.spendIncreasePctThreshold}
                                onChange={(e) => setAutomationDefaults((prev) => prev && {
                                  ...prev,
                                  spendAnomaly: { ...prev.spendAnomaly, default: { spendIncreasePctThreshold: Number(e.target.value) } },
                                })} />
                              <span className="text-xs text-gray-500">%</span>
                            </div>
                          )}
                        </div>

                        {/* Landing Page Check */}
                        <div className="rounded-xl border border-gray-200 p-3.5 bg-gray-50/50">
                          <label className="flex items-center gap-2 text-sm font-semibold text-gray-800">
                            <input
                              type="checkbox"
                              checked={automationDefaults.landingPageCheck.enabled}
                              onChange={(e) => setAutomationDefaults((prev) => prev && {
                                ...prev,
                                landingPageCheck: { ...prev.landingPageCheck, enabled: e.target.checked },
                              })}
                            />
                            Aktifkan cek Landing Page untuk akun-akun di BM ini
                          </label>
                          <p className="text-[11px] text-gray-500 mt-1 ml-6">
                            Daftar URL yang dipantau diatur di tab Pengaturan &gt; Emergency Brake &amp;
                            Monitoring (daftar global, tidak terikat BM). Toggle ini cuma nyalain pencarian
                            campaign yang pakai URL itu di akun-akun BM ini.
                          </p>
                          {automationDefaults.landingPageCheck.enabled && (
                            <div className="flex flex-wrap items-center gap-4 mt-3 ml-6 text-xs">
                              <label className="flex items-center gap-1.5">
                                <input type="checkbox"
                                  checked={automationDefaults.landingPageCheck.autoPauseOnDown}
                                  onChange={(e) => setAutomationDefaults((prev) => prev && {
                                    ...prev,
                                    landingPageCheck: { ...prev.landingPageCheck, autoPauseOnDown: e.target.checked },
                                  })} />
                                Auto-pause otomatis kalau down
                              </label>
                              <label className="flex items-center gap-1.5">
                                Timeout cek (detik)
                                <input type="number" min={1} max={60} className="w-16 border rounded px-2 py-1"
                                  value={automationDefaults.landingPageCheck.timeoutSeconds}
                                  onChange={(e) => setAutomationDefaults((prev) => prev && {
                                    ...prev,
                                    landingPageCheck: { ...prev.landingPageCheck, timeoutSeconds: Number(e.target.value) },
                                  })} />
                              </label>
                            </div>
                          )}
                        </div>

                        <div className="flex justify-end">
                          <button
                            onClick={handleSaveAutomationDefaults}
                            disabled={automationSaving}
                            className="flex items-center gap-1.5 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 px-3 py-1.5 rounded-lg transition-colors"
                          >
                            {automationSaving ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Save className="w-3.5 h-3.5" />}
                            Simpan Setelan Otomatisasi
                          </button>
                        </div>
                      </div>
                    ) : null}
                  </div>
                </>
              ) : null}
            </div>

            {/* Footer */}
            <div className="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
              <button
                onClick={() => selectedAssetBm && handleOpenBmAssets(selectedAssetBm)}
                disabled={assetLoading}
                className="px-3 py-1.5 text-xs font-medium text-gray-600 hover:text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 flex items-center gap-1.5 transition-colors disabled:opacity-50"
              >
                <RefreshCw className={`w-3.5 h-3.5 ${assetLoading ? 'animate-spin' : ''}`} />
                Segarkan Aset
              </button>
              <button
                onClick={() => setSelectedAssetBm(null)}
                className="px-4 py-2 text-sm font-medium text-white bg-gray-900 hover:bg-black rounded-lg transition-colors shadow-sm"
              >
                Tutup
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}