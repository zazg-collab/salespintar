        (c.campaignId && c.campaignId.toLowerCase().includes(q))
      );
    }

    // Sort
    return [...result].sort((a, b) => {
      let valA: any = (a as any)[sortField];
      let valB: any = (b as any)[sortField];

      if (sortField === 'cpr') {
        valA = getMetaResultAndCpr(a).cprValue;
