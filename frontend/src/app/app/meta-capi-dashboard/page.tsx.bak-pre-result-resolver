      if (typeof valA === 'string') {
        const comp = (valA || '').localeCompare(valB || '');
        if (comp !== 0) return sortDirection === 'asc' ? comp : -comp;
      } else {
        valA = Number(valA) || 0;
        valB = Number(valB) || 0;
        if (valA !== valB) {
          return sortDirection === 'asc' ? valA - valB : valB - valA;
        }
      }

      // Tiebreaker: spend desc
      return (b.spend || 0) - (a.spend || 0);
    });
