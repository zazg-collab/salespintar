        <p className="text-sm text-gray-500 bg-gray-50 rounded-xl px-4 py-3">
          Tidak ada pelanggaran spesifik yang tercatat pada channel ini — skor murni dari penilaian kualitas/kesesuaian AI, bukan karena ada yang dilanggar.
        </p>
      )}
    </div>
  );
}

export default function ComplianceReportPage() {
  const params = useParams<{ auditId: string }>();
  const auditId = params.auditId;
  const [state, setState] = useState<AuditStatusResponse | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [activeChannel, setActiveChannel] = useState<keyof ChannelScores | null>(null);
  const [activeTab, setActiveTab] = useState<TabKey>('overview');
  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null);

  // State klarifikasi (Round D poin 2 -- diserap dari analysis/page.tsx ke tab "Pelanggaran" di
  // sini, supaya tidak perlu pindah halaman lagi. Route /analysis lama TIDAK dihapus/diubah --
  // masih dipakai dari tempat lain (kartu "Ads Creative") -- ini murni duplikasi logic ke tab baru.
  const [answers, setAnswers] = useState<Record<string, string>>({});
  const [sending, setSending] = useState<string | null>(null);
  const [sendError, setSendError] = useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;

    async function poll() {
      try {
        const res = await apiGet<AuditStatusResponse>(`/video-guard/audit/${auditId}`);
        if (cancelled) return;
        setState(res);
        if (res.status === 'done' || res.status === 'error') {
          if (pollRef.current) clearInterval(pollRef.current);
        }
      } catch (e) {
        if (!cancelled) setError((e as Error).message || 'Gagal memuat status audit.');
      }
    }

    void poll();
    pollRef.current = setInterval(poll, 4000);
    return () => {
      cancelled = true;
      if (pollRef.current) clearInterval(pollRef.current);
    };
  }, [auditId]);

  async function handleClarify(violationId: string) {
    const userContext = (answers[violationId] || '').trim();
    if (!userContext) return;
    setSending(violationId);
    setSendError(null);
    try {
      const updated = await apiPost<ComplianceAuditReport>(`/video-guard/audit/${auditId}/clarify`, {
        violation_id: violationId,
        user_context: userContext,
      });
      setState({ status: 'done', report: updated });
      setAnswers((prev) => ({ ...prev, [violationId]: '' }));
    } catch (e) {
      setSendError((e as Error).message || 'Gagal mengirim klarifikasi.');
    } finally {
      setSending(null);
    }
  }

  return (
    <div className="max-w-4xl mx-auto space-y-6">
      <Link href="/app/video-guard/riwayat" className="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
        <ArrowLeft className="w-4 h-4" /> Kembali ke Riwayat
      </Link>

      {error && <div className="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 text-sm">{error}</div>}

      {!state && !error && (
        <div className="flex items-center gap-2 text-gray-500 text-sm py-12 justify-center">
          <Loader2 className="w-4 h-4 animate-spin" /> Memuat status audit…
        </div>
      )}

      {state && (state.status === 'queued' || state.status === 'processing') && (
        <div className="bg-white rounded-2xl border border-gray-200 p-10 flex flex-col items-center gap-3 text-center">
          <Loader2 className="w-8 h-8 text-emerald-500 animate-spin" />
          <p className="font-medium text-gray-800">Audit sedang diproses AI…</p>
          <p className="text-sm text-gray-500">Bisa memakan waktu puluhan detik sampai beberapa menit tergantung ukuran video. Halaman ini akan memperbarui diri otomatis.</p>
        </div>
      )}

      {state && state.status === 'error' && (
        <div className="bg-rose-50 border border-rose-200 rounded-2xl p-6 text-rose-700">
          <p className="font-semibold">Audit gagal diproses</p>
          <p className="text-sm mt-1">{state.error}</p>
        </div>
      )}

      {state && state.status === 'done' && (() => {
        const report = state.report;
        const meta = VERDICT_META[report.verdict] ?? VERDICT_META.MANUAL_REVIEW;
        const Icon = meta.icon;
        const scores = report.raw_assessment.channel_scores;
        const displayTitle = report.ad_name || report.raw_assessment.ad_title;
        const showSubtitle = report.ad_name && report.ad_name !== report.raw_assessment.ad_title;
        const hasOriginalCopy = Boolean(report.original_headline || report.original_primary_text);
        const captions = report.raw_assessment.remediation_assets.safe_captions;
        const violations = report.raw_assessment.violations;
        const presentChannels = (Object.keys(CHANNEL_LABELS) as (keyof ChannelScores)[]).filter((k) => typeof scores[k] === 'number');
        const openQuestions = report.raw_assessment.clarification_questions ?? [];
        const director = report.raw_assessment.remediation_assets.director_advice;
        const directorFields: { key: keyof DirectorAdvice; label: string }[] = [
          { key: 'b_roll_replacement', label: 'Ganti B-Roll' },
          { key: 'camera_angle', label: 'Sudut Kamera' },
          { key: 'action_direction', label: 'Arahan Aksi/Gerakan' },
          { key: 'environment_setting', label: 'Setting Lokasi' },
          { key: 'wardrobe_props', label: 'Wardrobe & Properti' },
        ];
        const hasDirectorAdvice = director && directorFields.some((f) => director[f.key]);
        const visualCuts = report.raw_assessment.remediation_assets.visual_cut_instructions;
        const voiceoverScript = report.raw_assessment.remediation_assets.safe_voiceover_script;
        const landingPageFixes = report.raw_assessment.remediation_assets.landing_page_fixes;
        const hasTechnicalContent = hasDirectorAdvice || visualCuts.length > 0 || Boolean(voiceoverScript) || landingPageFixes.length > 0;

        return (
          <div className="space-y-6">
            <div className={`rounded-2xl border p-6 ${meta.className}`}>
              <div className="flex items-center gap-3">
                <Icon className="w-8 h-8" />
                <div>
                  <p className="font-bold text-lg">{meta.label}</p>
                  <p className="text-sm opacity-80">Skor Kepatuhan Keseluruhan: {report.overall_compliance_score}/100</p>
                </div>
              </div>
            </div>

            <div className="bg-white rounded-2xl border border-gray-200 p-2 flex flex-wrap gap-1">
              {TABS.map((t) => {
                const TIcon = t.icon;
                const active = activeTab === t.key;
                const badge = t.key === 'violations' && violations.length > 0 ? violations.length : null;
                return (
                  <button
                    key={t.key}
                    type="button"
                    onClick={() => setActiveTab(t.key)}
                    className={`flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${
                      active ? 'bg-indigo-600 text-white' : 'text-gray-500 hover:bg-gray-100'
                    }`}
                  >
                    <TIcon className="w-4 h-4" /> {t.label}
                    {badge !== null && (
                      <span className={`text-[10px] font-bold px-1.5 py-0.5 rounded-full ${active ? 'bg-white/20' : 'bg-rose-100 text-rose-600'}`}>
                        {badge}
                      </span>
                    )}
                  </button>
                );
              })}
            </div>

            {activeTab === 'overview' && (
              <div className="space-y-6">
                <div className="bg-white rounded-2xl border border-gray-200 p-6">
                  <h2 className="font-semibold text-gray-900">{displayTitle}</h2>
                  {showSubtitle && <p className="text-xs text-gray-400 mb-4 mt-0.5">{report.raw_assessment.ad_title}</p>}
                  <div className={`space-y-3 ${showSubtitle ? '' : 'mt-4'}`}>
                    {presentChannels.map((k) => (
                      <ScoreBar key={k} label={CHANNEL_LABELS[k]} value={scores[k] as number} onClick={() => setActiveChannel(k)} />
                    ))}
                  </div>
                  <p className="text-[11px] text-gray-400 mt-3">Klik salah satu channel untuk lihat ringkasan skornya.</p>
                </div>

                <div className="bg-white rounded-2xl border border-gray-200 p-6">
                  <h2 className="font-semibold text-gray-900 mb-2">Ringkasan Eksekutif</h2>
                  <p className="text-sm text-gray-600 leading-relaxed whitespace-pre-line">{report.raw_assessment.executive_summary}</p>
                </div>

                {violations.length > 0 && (
                  <button
                    type="button"
                    onClick={() => setActiveTab('violations')}
                    className="w-full flex items-center justify-between bg-white rounded-2xl border border-gray-200 p-6 hover:border-emerald-300 hover:shadow-md transition-all text-left"
                  >
                    <div className="flex items-center gap-3">
                      <ListChecks className="w-6 h-6 text-emerald-600" />
                      <div>
                        <p className="font-semibold text-gray-900">{violations.length} Pelanggaran Terdeteksi</p>
                        <p className="text-xs text-gray-500">Lihat analisis rinci per pelanggaran & panel klarifikasi →</p>
                      </div>
                    </div>
                  </button>
                )}

                {captions.length > 0 && (
                  <div className="bg-white rounded-2xl border border-gray-200 p-6">
                    <h2 className="font-semibold text-gray-900 mb-1">Saran Caption Aman</h2>
                    <p className="text-xs text-gray-400 mb-4">
                      {hasOriginalCopy ? 'Perbandingan teks iklan asli (kiri) dengan saran versi aman AI (kanan).' : 'Teks asli iklan ini tidak tersimpan — berikut saran caption amannya.'}
                    </p>
                    <div className="space-y-3">
                      {captions.map((c, i) => (
                        <div key={i} className={`grid gap-3 ${hasOriginalCopy ? 'sm:grid-cols-2' : ''}`}>
                          {hasOriginalCopy && (
                            <div className="bg-gray-50 border border-gray-200 rounded-xl p-4">
                              <p className="text-[10px] font-semibold text-gray-400 uppercase mb-1">Teks Asli</p>
                              {report.original_headline && <p className="text-sm font-medium text-gray-700">{report.original_headline}</p>}
                              {report.original_primary_text && <p className="text-sm text-gray-600 mt-1">{report.original_primary_text}</p>}
                            </div>
                          )}
                          <div className="bg-emerald-50 border border-emerald-200 rounded-xl p-4">
                            <p className="text-[10px] font-semibold text-emerald-600 uppercase mb-1">Saran Caption {captions.length > 1 ? `#${i + 1}` : ''}</p>
                            <p className="text-sm text-emerald-900">{c}</p>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}

            {activeTab === 'media' && (
              <div className="space-y-6">
                <MediaPreviewBlock media={report.media} />
                {presentChannels.map((k) => (
                  <ChannelMediaCard
                    key={k}
                    channelKey={k}
                    score={scores[k] as number}
                    violations={violations}
                    imageAnalysis={report.raw_assessment.image_analysis}
                    videoAnalysis={report.raw_assessment.video_analysis}
                  />
                ))}
              </div>
            )}

            {activeTab === 'violations' && (
              <div className="space-y-4">
                {sendError && <div className="bg-rose-50 border border-rose-200 text-rose-700 rounded-xl px-4 py-3 text-sm">{sendError}</div>}
                {violations.length === 0 && (
                  <p className="text-sm text-gray-500 bg-white border border-gray-200 rounded-2xl p-6 text-center">Tidak ada pelanggaran terdeteksi pada audit ini.</p>
                )}
                {violations.map((v) => {
                  const question = openQuestions.find((q) => q.violation_id === v.id);
                  return (
                    <div key={v.id} className="bg-white rounded-2xl border border-gray-200 p-5">
                      <div className="flex items-start justify-between gap-3">
                        <div className="flex items-start gap-3">
                          <AlertOctagon className="w-5 h-5 text-rose-500 flex-shrink-0 mt-0.5" />
                          <div>
                            <p className="font-semibold text-gray-900">{v.detected_element}</p>
                            <p className="text-xs text-gray-500 mt-0.5">
                              Channel: {v.channel}
                              {v.timestamp_start ? ` · ${v.timestamp_start}${v.timestamp_end ? ` – ${v.timestamp_end}` : ''}` : ''}
                            </p>
                          </div>
                        </div>
                        <span className={`text-xs font-semibold px-2 py-1 rounded-full border flex-shrink-0 ${RISK_STYLE[v.risk_level]}`}>
                          {v.risk_level}
                        </span>
                      </div>

                      <div className="mt-3 text-sm text-gray-600 space-y-1">
                        <p><span className="font-medium text-gray-700">Kebijakan:</span> {v.policy_reference}</p>
                        <p><span className="font-medium text-gray-700">Saran perbaikan:</span> {v.remediation}</p>
                      </div>

                      {question && (
                        <div className="mt-4 bg-indigo-50 border border-indigo-200 rounded-xl p-4">
                          <p className="text-sm font-medium text-indigo-900 flex items-start gap-2">
                            <MessageCircleQuestion className="w-4 h-4 flex-shrink-0 mt-0.5" />
                            {question.question}
                          </p>
                          <div className="mt-3 flex gap-2">
                            <input
                              type="text"
                              value={answers[v.id] || ''}
                              onChange={(e) => setAnswers((prev) => ({ ...prev, [v.id]: e.target.value }))}
                              placeholder="Jelaskan konteksnya di sini…"
                              className="flex-1 border border-indigo-200 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500"
                            />
                            <button
                              onClick={() => handleClarify(v.id)}
                              disabled={sending === v.id || !(answers[v.id] || '').trim()}
                              className="flex items-center gap-1.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
                            >
                              {sending === v.id ? <Loader2 className="w-4 h-4 animate-spin" /> : <Send className="w-4 h-4" />}
                              Kirim
                            </button>
                          </div>
                          <p className="text-[11px] text-indigo-500 mt-2">
                            AI akan mengecek ulang klaim ini terhadap piksel/audio asli video (bukan cuma teks jawaban Anda).
                          </p>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}

            {activeTab === 'technical' && (
              <div className="space-y-6">
                {!hasTechnicalContent && (
                  <p className="text-sm text-gray-500 bg-white border border-gray-200 rounded-2xl p-6 text-center">
                    Belum ada saran teknis produksi untuk audit ini — biasanya karena tidak ada pelanggaran yang butuh perbaikan syuting ulang.
                  </p>
                )}

                {hasDirectorAdvice && (
                  <div className="bg-white rounded-2xl border border-gray-200 p-6">
                    <h2 className="font-semibold text-gray-900 mb-1 flex items-center gap-2">
                      <PlayCircle className="w-5 h-5 text-indigo-600" /> Catatan Sutradara
                    </h2>
                    <p className="text-xs text-gray-400 mb-4">Arahan konkret buat tim kreatif kalau mau syuting ulang adegan yang bermasalah.</p>
                    <div className="grid sm:grid-cols-2 gap-3">
                      {directorFields.filter((f) => director?.[f.key]).map((f) => (
                        <div key={f.key} className="bg-indigo-50 border border-indigo-100 rounded-xl p-4">
                          <p className="text-[10px] font-semibold text-indigo-600 uppercase mb-1">{f.label}</p>
                          <p className="text-sm text-indigo-900">{director?.[f.key]}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {visualCuts.length > 0 && (
                  <div className="bg-white rounded-2xl border border-gray-200 p-6">
                    <h2 className="font-semibold text-gray-900 mb-3">Instruksi Potongan Visual</h2>
                    <ul className="space-y-2">
                      {visualCuts.map((c, i) => (
                        <li key={i} className="text-sm text-gray-600 flex items-start gap-2">
                          <span className="text-indigo-400 font-semibold flex-shrink-0">{i + 1}.</span> {c}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {voiceoverScript && (
                  <div className="bg-white rounded-2xl border border-gray-200 p-6">
                    <h2 className="font-semibold text-gray-900 mb-2">Naskah Voice-Over Aman</h2>
                    <p className="text-sm text-gray-600 leading-relaxed whitespace-pre-line bg-gray-50 rounded-xl p-4">{voiceoverScript}</p>
                  </div>
                )}

                {landingPageFixes.length > 0 && (
                  <div className="bg-white rounded-2xl border border-gray-200 p-6">
                    <h2 className="font-semibold text-gray-900 mb-3">Perbaikan Landing Page</h2>
                    <ul className="space-y-2">
                      {landingPageFixes.map((f, i) => (
                        <li key={i} className="text-sm text-gray-600 flex items-start gap-2">
                          <span className="text-indigo-400 font-semibold flex-shrink-0">{i + 1}.</span> {f}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}

            {activeTab === 'methods' && (
              <div className="space-y-6">
                <div className="bg-white rounded-2xl border border-gray-200 p-6">
                  <h2 className="font-semibold text-gray-900 mb-2">Cara Skor Akhir Dihitung</h2>
                  <p className="text-sm text-gray-600 leading-relaxed">
                    Skor tiap channel (di bawah) murni hasil pembacaan AI atas medianya masing-masing. Tapi skor <b>akhir</b> ({report.overall_compliance_score}/100)
                    dan verdict-nya <b>TIDAK</b> ditentukan AI — dihitung ulang oleh kode Python yang sudah tetap (bukan LLM), supaya konsisten dan bisa diaudit:
                  </p>
                  <ol className="mt-3 space-y-1.5 text-sm text-gray-600 list-decimal list-inside">
                    <li>Rata-rata berbobot dari semua channel yang berhasil dianalisis (channel yang gagal/tidak ada asset-nya TIDAK dihitung sebagai 0, cuma dikeluarkan dari perhitungan).</li>
                    <li>Kalau ada pelanggaran fatal (mis. mengacungkan senjata ke orang, ancaman eksplisit), skornya dipotong penalti tetap — dan kalau hasil akhirnya masih di bawah 60, verdict otomatis dipaksa &quot;Ditolak&quot; apapun angkanya.</li>
                    <li>Angka final dicocokkan ke salah satu dari 3 tingkat: ≥80 Disetujui, 60–79 Perlu Revisi Kecil, &lt;60 Ditolak.</li>
                  </ol>
                </div>

                <div className="bg-white rounded-2xl border border-gray-200 p-6 space-y-4">
                  <h2 className="font-semibold text-gray-900">Metodologi per Channel</h2>
                  {presentChannels.map((k) => (
                    <div key={k} className="border border-gray-100 rounded-xl p-4">
                      <div className="flex items-center justify-between mb-1.5">
                        <p className="text-sm font-semibold text-gray-800">{CHANNEL_LABELS[k]}</p>
                        <span className="text-[10px] font-semibold text-gray-400 uppercase">Bobot {Math.round(CHANNEL_WEIGHTS[k] * 100)}%</span>
                      </div>
                      <p className="text-sm text-gray-600 leading-relaxed">{CHANNEL_METHODOLOGY[k]}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      })()}

      {state && state.status === 'done' && activeChannel && (
        <ChannelSummaryPopup
          channelKey={activeChannel}
          score={(state.report.raw_assessment.channel_scores[activeChannel] as number) ?? 0}
          violationCount={state.report.raw_assessment.violations.filter((v) => matchesChannel(v.channel, activeChannel)).length}
          onClose={() => setActiveChannel(null)}
          onViewDetail={() => {
            setActiveChannel(null);
            setActiveTab('media');
          }}
        />
      )}
    </div>
  );
}
