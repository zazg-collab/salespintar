  channelKey,
  score,
  violations,
  imageAnalysis,
  videoAnalysis,
}: {
  channelKey: keyof ChannelScores;
  score: number;
  violations: ViolationDetail[];
  imageAnalysis?: ImageAnalysis | null;
  videoAnalysis?: VideoAnalysis | null;
}) {
  const related = violations.filter((v) => matchesChannel(v.channel, channelKey));
  const showImageExtraction = channelKey === 'thumbnail_image_score' && imageAnalysis;
  const showVideoObjects = channelKey === 'visual_motion_score' && videoAnalysis;
  const showAudioTranscript = channelKey === 'audio_speech_score' && videoAnalysis;

  return (
    <div className="bg-white rounded-2xl border border-gray-200 p-5 space-y-4">
      <div className="flex items-center justify-between">
        <h3 className="font-bold text-gray-900">{CHANNEL_LABELS[channelKey]}</h3>
        <span className="text-sm font-semibold text-gray-700">{score}/100</span>
      </div>

      {showImageExtraction && (
        <div className="bg-violet-50 border border-violet-100 rounded-xl p-4 space-y-2">
          {imageAnalysis?.extracted_text && (
            <div className="flex items-start gap-2">
              <FileText className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
              <div>
                <p className="text-xs font-semibold text-violet-700">Teks terbaca di gambar (OCR)</p>
                <p className="text-sm text-violet-900 mt-0.5">{imageAnalysis.extracted_text}</p>
              </div>
            </div>
          )}
          {imageAnalysis?.detected_objects && imageAnalysis.detected_objects.length > 0 && (
            <div className="flex items-start gap-2">
              <Tags className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
              <div>
                <p className="text-xs font-semibold text-violet-700">Objek terdeteksi</p>
                <p className="text-sm text-violet-900 mt-0.5">{imageAnalysis.detected_objects.join(', ')}</p>
              </div>
            </div>
          )}
        </div>
      )}

      {showVideoObjects && videoAnalysis?.detected_objects && videoAnalysis.detected_objects.length > 0 && (
        <div className="bg-violet-50 border border-violet-100 rounded-xl p-4">
          <div className="flex items-start gap-2">
            <Tags className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
            <div>
              <p className="text-xs font-semibold text-violet-700">Objek terdeteksi di sepanjang video</p>
              <p className="text-sm text-violet-900 mt-0.5">{videoAnalysis.detected_objects.join(', ')}</p>
            </div>
          </div>
        </div>
      )}

      {showAudioTranscript && videoAnalysis?.audio_transcript && (
        <div className="bg-violet-50 border border-violet-100 rounded-xl p-4">
          <div className="flex items-start gap-2">
            <Mic className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
            <div>
              <p className="text-xs font-semibold text-violet-700">Transkrip verbatim audio</p>
              <p className="text-sm text-violet-900 mt-0.5 whitespace-pre-line">{videoAnalysis.audio_transcript}</p>
            </div>
          </div>
        </div>
      )}

      {related.length > 0 ? (
        <div className="space-y-3">
          <p className="text-xs font-semibold text-gray-500 uppercase">{related.length} temuan pada channel ini</p>
          {related.map((v) => (
            <div key={v.id} className="border border-gray-200 rounded-xl p-4 space-y-2">
              <div className="flex items-start justify-between gap-2">
                <p className="text-sm font-medium text-gray-800">{v.detected_element}</p>
                <span className={`text-[10px] font-semibold px-2 py-0.5 rounded-full border flex-shrink-0 ${RISK_STYLE[v.risk_level]}`}>
                  {v.risk_level}
