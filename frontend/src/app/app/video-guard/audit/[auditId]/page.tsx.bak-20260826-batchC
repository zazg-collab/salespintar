/** Blok preview media asli (Round D poin 4, Bossfren 2026-08-25): "media analysisnya jg pengen
 *  gambar/videonya kelihatan kaya di halaman Ads Creative, ga usah download." Reuse PERSIS
 *  mekanisme yang sudah proven di meta-rejected-page.tsx -- iframe embed Meta (`previewIframe`)
 *  kalau ada, fallback ke `<img>` thumbnail statis, fallback lagi ke pesan "tidak tersedia" utk
 *  audit manual/upload yang memang tidak punya metaAdId (lihat komentar backend fetchAdMediaPreview). */
function MediaPreviewBlock({ media }: { media: AuditMedia | null | undefined }) {
  if (!media || (!media.previewIframe && !media.thumbnailUrl)) {
    return (
      <div className="bg-gray-50 border border-gray-200 rounded-2xl p-6 text-center text-sm text-gray-400">
        Media asli tidak tersedia untuk ditampilkan di sini — audit ini dibuat lewat upload manual (bukan dari menu &quot;Ads Creative&quot;), jadi file aslinya tidak disimpan di server.
      </div>
    );
  }
  return (
    <div className="bg-gray-950 rounded-2xl p-4 border border-gray-800 shadow-inner flex items-center justify-center overflow-hidden min-h-[280px]">
      {media.previewIframe ? (
        <div
          className="w-full flex items-center justify-center overflow-hidden [&>iframe]:w-full [&>iframe]:max-w-[340px] [&>iframe]:h-[500px] [&>iframe]:border-0 [&>iframe]:rounded-xl [&>iframe]:shadow-2xl"
          dangerouslySetInnerHTML={{ __html: media.previewIframe }}
        />
      ) : (
        // eslint-disable-next-line @next/next/no-img-element
        <img src={media.thumbnailUrl as string} alt="Preview iklan" className="max-h-[440px] w-auto object-contain rounded-xl shadow-2xl" />
      )}
    </div>
  );
}

/** Kartu detail per-channel di tab Media Analysis (Round D poin 2+3): ini pengganti isi
 *  ChannelDetailModal yang lama -- sekarang tinggal di sini, bukan di popup. Nampilkan SEMUA
