      {isVisualChannel && videoAnalysis?.hook_effectiveness_note && (
        <div className="bg-sky-50 border border-sky-100 rounded-xl p-4 flex items-start gap-2">
          <Zap className="w-4 h-4 text-sky-500 flex-shrink-0 mt-0.5" />
          <div>
            <p className="text-xs font-semibold text-sky-700">Efektivitas Hook (3 Detik Pertama)</p>
            <p className="text-sm text-sky-900 mt-0.5">{videoAnalysis.hook_effectiveness_note}</p>
          </div>
        </div>
      )}

      {isVisualChannel && videoAnalysis?.pacing_note && (
        <div className="bg-sky-50 border border-sky-100 rounded-xl p-4 flex items-start gap-2">
          <Gauge className="w-4 h-4 text-sky-500 flex-shrink-0 mt-0.5" />
          <div>
            <p className="text-xs font-semibold text-sky-700">Tempo / Pacing</p>
            <p className="text-sm text-sky-900 mt-0.5">{videoAnalysis.pacing_note}</p>
          </div>
        </div>
      )}

      {isAudioChannel && videoAnalysis?.audio_transcript && (
        <div className="bg-violet-50 border border-violet-100 rounded-xl p-4 flex items-start gap-2">
          <Mic className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
          <div>
            <p className="text-xs font-semibold text-violet-700">Transkrip verbatim audio</p>
            <p className="text-sm text-violet-900 mt-0.5 whitespace-pre-line">{videoAnalysis.audio_transcript}</p>
          </div>
        </div>
