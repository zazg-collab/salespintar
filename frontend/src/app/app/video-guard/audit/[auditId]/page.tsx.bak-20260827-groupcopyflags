      {isImageChannel && imageAnalysis?.detected_objects && imageAnalysis.detected_objects.length > 0 && (
        <div className="bg-violet-50 border border-violet-100 rounded-xl p-4 flex items-start gap-2">
          <Tags className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
          <div>
            <p className="text-xs font-semibold text-violet-700">Objek terdeteksi</p>
            <p className="text-sm text-violet-900 mt-0.5">{imageAnalysis.detected_objects.join(', ')}</p>
          </div>
        </div>
