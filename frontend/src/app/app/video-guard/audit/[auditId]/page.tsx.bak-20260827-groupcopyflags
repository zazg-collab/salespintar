/** Cocokkan field `channel` bebas-teks dari violations (mis. "Video_Visual", "Landing_Page") ke
 *  key channel_scores yang baku -- pencarian substring case-insensitive, bukan exact match, krn
 *  metaguard_service tidak selalu konsisten menuliskan nama channel-nya. */
function matchesChannel(violationChannel: string, key: keyof ChannelScores): boolean {
  const vc = violationChannel.toLowerCase();
  switch (key) {
    case 'visual_motion_score': return vc.includes('visual') || vc.includes('motion') || vc.includes('video');
    case 'audio_speech_score': return vc.includes('audio') || vc.includes('speech') || vc.includes('suara') || vc.includes('ucapan');
    case 'text_copy_score': return vc.includes('text') || vc.includes('copy') || vc.includes('caption');
    case 'thumbnail_image_score': return vc.includes('thumbnail') || vc.includes('image') || vc.includes('gambar');
    case 'landing_page_score': return vc.includes('landing') || vc.includes('page');
    default: return false;
  }
}

