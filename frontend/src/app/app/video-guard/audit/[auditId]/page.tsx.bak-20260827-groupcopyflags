/** [2026-08-26] Blueprint Batch B/C Bagian 4.3: render 1 bukti still-frame (JPEG) tersimpan di
 *  tabel VideoAdAuditEvidence lewat endpoint baru GET /video-guard/audit/:auditId/evidence/:violationId.
 *  Endpoint ini dijaga JWT lewat header Authorization -- `<img src="...">` polos TIDAK BISA
 *  mengirim header itu, jadi WAJIB pakai apiGetObjectUrl() (fetch ber-header -> blob -> object URL),
 *  pola yang PERSIS sama dengan yang sudah proven dipakai gambar katalog Fase 89 (lihat lib/api.ts).
 *  404 (violation tanpa evidence -- channel Text/Landing_Page, atau ekstraksi cv2 best-effort gagal)
 *  ditangani SENYAP, component render null, BUKAN pesan error -- ini kondisi normal, bukan bug. */
function EvidenceThumbnail({ auditId, violationId }: { auditId: string; violationId: string }) {
  const [url, setUrl] = useState<string | null>(null);
  const [failed, setFailed] = useState(false);

  useEffect(() => {
    let cancelled = false;
    let objectUrl: string | null = null;
    setUrl(null);
    setFailed(false);

    apiGetObjectUrl(`/video-guard/audit/${auditId}/evidence/${violationId}`)
      .then((u) => {
        if (cancelled) {
          URL.revokeObjectURL(u);
          return;
        }
        objectUrl = u;
        setUrl(u);
      })
      .catch(() => {
        if (!cancelled) setFailed(true);
      });

    return () => {
      cancelled = true;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    };
  }, [auditId, violationId]);

  if (failed || !url) return null;

  return (
    // eslint-disable-next-line @next/next/no-img-element
    <img
      src={url}
      alt="Bukti tangkapan layar dari video/gambar iklan"
      className="mt-3 max-h-56 w-auto rounded-lg border border-gray-200 shadow-sm"
    />
  );
}

