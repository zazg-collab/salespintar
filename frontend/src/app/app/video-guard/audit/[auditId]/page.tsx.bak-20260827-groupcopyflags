  // channelKey aktif. Ditampilkan di ATAS blok observasi kreatif lainnya biar langsung kebaca.
  const complianceNote = isImageChannel
    ? imageAnalysis?.compliance_note
    : isVisualChannel
    ? videoAnalysis?.visual_compliance_note
    : isAudioChannel
    ? videoAnalysis?.audio_compliance_note
    : isTextChannel
    ? textCopyAnalysis?.compliance_note
