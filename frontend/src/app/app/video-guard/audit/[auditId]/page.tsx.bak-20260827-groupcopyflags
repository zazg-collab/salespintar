  // selalu jatuh ke pesan kosong walau text_copy_analysis sudah terisi backend.
  const isTextChannel = channelKey === 'text_copy_score';

  const hasImageContent = isImageChannel && Boolean(
    imageAnalysis?.extracted_text ||
    (imageAnalysis?.detected_objects && imageAnalysis.detected_objects.length > 0) ||
    imageAnalysis?.visual_style_note ||
    imageAnalysis?.text_legibility_note ||
    imageAnalysis?.compliance_note
