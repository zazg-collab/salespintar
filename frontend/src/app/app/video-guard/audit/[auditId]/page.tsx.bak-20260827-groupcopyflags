          <Eye className="w-4 h-4 text-sky-500 flex-shrink-0 mt-0.5" />
          <div>
            <p className="text-xs font-semibold text-sky-700">Gaya &amp; Komposisi Visual</p>
            <p className="text-sm text-sky-900 mt-0.5">{imageAnalysis.visual_style_note}</p>
