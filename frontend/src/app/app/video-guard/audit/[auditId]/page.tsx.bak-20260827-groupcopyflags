  const hasVisualContent = isVisualChannel && Boolean(
    (videoAnalysis?.detected_objects && videoAnalysis.detected_objects.length > 0) ||
    (videoAnalysis?.scene_breakdown && videoAnalysis.scene_breakdown.length > 0) ||
    videoAnalysis?.hook_effectiveness_note ||
    videoAnalysis?.pacing_note ||
    videoAnalysis?.visual_compliance_note
