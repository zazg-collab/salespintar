      {isTextChannel && textCopyAnalysis?.tone_of_voice_note && (
        <div className="bg-violet-50 border border-violet-100 rounded-xl p-4 flex items-start gap-2">
          <Mic className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
