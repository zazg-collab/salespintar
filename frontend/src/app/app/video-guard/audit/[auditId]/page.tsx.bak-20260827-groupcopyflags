          <FileText className="w-4 h-4 text-violet-500 flex-shrink-0 mt-0.5" />
          <div>
            <p className="text-xs font-semibold text-violet-700">Teks terbaca di gambar (OCR)</p>
            <p className="text-sm text-violet-900 mt-0.5">{imageAnalysis.extracted_text}</p>
          </div>
        </div>
