  const hasTextContent = isTextChannel && Boolean(
    textCopyAnalysis?.tone_of_voice_note ||
    textCopyAnalysis?.persuasion_technique_note ||
    textCopyAnalysis?.readability_note ||
    textCopyAnalysis?.compliance_note
  );
  const hasAnyContent = hasImageContent || hasVisualContent || hasAudioContent || hasTextContent;
