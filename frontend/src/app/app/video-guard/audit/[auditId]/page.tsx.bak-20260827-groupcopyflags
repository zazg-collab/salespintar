      {isAudioChannel && videoAnalysis?.audio_style_note && (
        <div className="bg-sky-50 border border-sky-100 rounded-xl p-4 flex items-start gap-2">
          <Volume2 className="w-4 h-4 text-sky-500 flex-shrink-0 mt-0.5" />
