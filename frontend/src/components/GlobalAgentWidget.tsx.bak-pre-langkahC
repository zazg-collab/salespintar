'use client';

/**
 * GlobalAgentWidget — tombol bulat mengambang pojok kanan bawah yang membuka panel
 * `GlobalAgentChat` (mode="floating"). Dipasang sekali di `app/layout.tsx` supaya tetap ada
 * di semua halaman `/app/*` sampai user close manual, tidak hilang saat pindah menu.
 *
 * Bagian dari Langkah B blueprint "Ekstensi Fase 3: Global Agent Workspace & Multi-BM Token
 * Vault" v1.3 — lihat GlobalAgentChat.tsx untuk logika chat/PIC/session yang sesungguhnya;
 * komponen ini murni shell buka/tutup + posisi.
 *
 * [2026-08-25] Fix layout: panel awalnya di-anchor pakai `bottom` + `height` tetap
 * (`h-[560px]`) -- di viewport pendek (browser/window yang tingginya < ~656px) itu bikin
 * bagian ATAS panel (termasuk header ungu "Agent Workspace") kepotong/ketutup di luar batas
 * atas layar, jadi yang kelihatan cuma area chat kosong + input di bawah (persis keluhan user:
 * "potongannya widget chatnya gak rapi"). Sekarang di-anchor pakai `top` + `bottom` SEKALIGUS
 * (bukan height tetap) supaya tingginya otomatis menyesuaikan ruang yang tersedia -- kedua
 * ujung panel dijamin selalu di dalam viewport, tidak pernah kepotong di layar sependek apapun.
 * z-index juga dinaikkan (z-[9999], lewat inline style biar pasti menang) supaya tidak ambigu
 * ketika ada modal lain yang juga z-50 di halaman (mis. Audit AI / Creative Preview modal).
 */

import { useState } from 'react';
import { Bot, X } from 'lucide-react';
import GlobalAgentChat from './GlobalAgentChat';

const PANEL_Z = 2147483000; // sengaja jauh di atas z-index modal manapun di app ini (semua pakai z-50)

export default function GlobalAgentWidget() {
  const [open, setOpen] = useState(false);

  return (
    <>
      {open && (
        <div
          className="fixed right-6 top-6 bottom-24 w-96 bg-white rounded-xl shadow-2xl border border-gray-200 flex flex-col overflow-hidden"
          style={{ maxWidth: 'calc(100vw - 2rem)', zIndex: PANEL_Z }}
        >
          <div className="flex items-center justify-between px-4 py-3 border-b border-gray-100 bg-indigo-600 text-white flex-shrink-0">
            <div className="flex items-center gap-2">
              <Bot className="w-4 h-4" />
              <span className="text-sm font-semibold">Agent Workspace</span>
            </div>
            <button
              onClick={() => setOpen(false)}
              className="p-1 rounded hover:bg-indigo-500/60 transition-colors"
              title="Tutup"
            >
              <X className="w-4 h-4" />
            </button>
          </div>
          <div className="flex-1 min-h-0 p-3 pb-4">
            <GlobalAgentChat mode="floating" />
          </div>
        </div>
      )}

      <button
        onClick={() => setOpen((v) => !v)}
        className="fixed bottom-6 right-6 w-14 h-14 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white shadow-xl flex items-center justify-center transition-transform hover:scale-105"
        style={{ zIndex: PANEL_Z }}
        title={open ? 'Tutup Agent Workspace' : 'Buka Agent Workspace'}
      >
        {open ? <X className="w-6 h-6" /> : <Bot className="w-6 h-6" />}
      </button>
    </>
  );
}
