// [2026-08-25] Blueprint Integrasi "Meta Video AI Guards" ke SalesPintar (projek-ceo), Section 3.4.
// Persistensi histori audit video Meta Ads -- sebelumnya video-guard.routes.ts murni proxy realtime
// tanpa nyimpen apa-apa ke DB (lihat catatan "Belum diimplementasikan" di note integrasi). rawReportJson
// nyimpen ComplianceAuditReport penuh dari metaguard_service biar halaman Riwayat/Compliance Report
// bisa render ulang tanpa manggil microservice lagi.
model VideoAdAudit {
  // Bukan @default(uuid()) sengaja -- id ini SELALU diisi eksplisit dari audit_id yang dibalikin
  // metaguard_service (format "aud_<hex32>", lihat metaguard_service/main.py), bukan uuid standar
  // Postgres, supaya satu id yang sama dipakai di URL frontend/proxy/DB tanpa lapisan translasi.
  id             String   @id @db.VarChar(50)
  businessId     String   @map("business_id") @db.Uuid
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adTitle        String   @db.VarChar(255)
  overallScore   Int?     @map("overall_score")
  verdict        String?  @db.VarChar(30)
  layersApplied  String[] @default([]) @map("layers_applied")
  rawReportJson  Json?    @map("raw_report_json") @db.JsonB
  // Diisi HANYA kalau audit ini dipicu dari menu "Meta Ads Creative" (creative yang di-reject Meta
  // sendiri, lihat Section baru 2026-08-25 "Meta Ads Creative"), bukan dari upload manual "Audit
  // Baru". metaAdId dipakai buat dedup -- 1 ad Meta cuma boleh punya 1 baris audit (tombol "Audit
  // MetaGuard AI" cek baris ini dulu sebelum jalanin audit baru, supaya tidak bolak-balik hit agy
  // dan biaya LLM utk video yang sama). Nullable + @@unique: Postgres izinin banyak NULL di unique
  // index, jadi audit manual (metaAdId selalu null) tidak kena constraint ini sama sekali.
  metaAdId       String?  @map("meta_ad_id") @db.VarChar(50)
  metaVideoId    String?  @map("meta_video_id") @db.VarChar(50)
  // [2026-08-27] Status Audit (proses) terpisah dari Status AI (verdict) --
  // PROCESSING | SUCCESS | TECHNICAL_ERROR. Nullable + kode punya fallback
  // (lihat video-guard.routes.ts) supaya baris lama sebelum kolom ini ada
  // tetap kebaca benar (verdict null -> dianggap PROCESSING, verdict ada ->
  // dianggap SUCCESS). Field ini nyusul field yang sudah dipakai kode sejak
  // lebih dulu (sesi Cowork sebelumnya lupa/gagal update schema+rebuild).
  processingStatus String? @map("processing_status") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  // fix Batch B (blueprint 2026-08-26 Bagian 4.3): evidence still-frame/thumbnail per violation --
  // 1 audit bisa punya banyak baris evidence (1 per violation_id yang berhasil diekstrak).
  evidence       VideoAdAuditEvidence[]

  @@unique([businessId, metaAdId])
  @@index([businessId])
  @@map("video_ad_audits")
}

// [2026-08-26] Blueprint Video Guard Batch B, Bagian 4.3 -- still-frame/thumbnail evidence per
// violation. Bytes JPEG langsung di Postgres (bukan object storage terpisah): ukuran kecil
// (<50KB/evidence, dikompres Python cv2 di metaguard_service SEBELUM dikirim ke sini -- lihat
// engine.py `_encode_jpeg_capped`/`_compress_thumbnail_evidence`), overhead per audit < 250KB
// (rata-rata 1-5 violation). Kalau volume naik jauh ke depan, tinggal ganti `frameJpeg Bytes?`
// jadi `framePath String?` (URL object storage) tanpa ubah kontrak API ke frontend (frontend
// selalu terima `frame_asset_id`, backend yang urus di belakang mau dari DB atau storage eksternal).
// @@unique([auditId, violationId]) BUKAN dari draf blueprint asli -- ditambahkan supaya
// persistAuditReport() bisa upsert per (auditId, violationId) dgn aman kalau audit yang sama
// diproses ulang (mis. lewat alur klarifikasi), bukan numpuk baris evidence duplikat.
model VideoAdAuditEvidence {
  id           String       @id @default(uuid()) @db.Uuid
  auditId      String       @map("audit_id") @db.VarChar(50)
  audit        VideoAdAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  violationId  String       @map("violation_id") @db.VarChar(50)
  evidenceType String       @map("evidence_type") @db.VarChar(20)
  frameJpeg    Bytes?       @map("frame_jpeg")
  evidenceText String?      @map("evidence_text") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([auditId, violationId])
  @@index([auditId])
  @@map("video_ad_audit_evidence")
}

// ── Fase 3 Langkah 4 (2026-08-25): Cache Health Score & Audit AI Lapis 2 ──────
// Redesign Bossfren (brainstorming sesi 2026-08-25): Health Score dipindah dari halaman
