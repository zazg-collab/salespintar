// nyimpen baris di sini lalu balas langsung ke browser, job agy sungguhan jalan di background dan
// nulis hasilnya ke baris yang sama begitu selesai -- ini fix struktural problem lama (hasil hilang
// kalau browser disconnect duluan sebelum agy selesai, lihat root-cause di ledger 2026-08-25 soal
// timeout 320 detik vs durasi agy yang bisa 10-15 menit). Popup baca cache ini duluan (langsung
// nongol + jam "terakhir update"), TIDAK compute ulang tiap dibuka -- tombol Refresh manual dengan
// cooldown (lihat REFRESH_COOLDOWN_MS di ai-ads.routes.ts) dan deteksi busy instan kalau ada proses
// lain masih jalan di API Bridge VPS45 (global concurrency=1, lihat busy-tracker di file yang sama).
enum AiAdsCacheStatus {
  IDLE
  RUNNING
  DONE
  ERROR
}

model AiAdsHealthScoreCache {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  bmId            String           @map("bm_id") @db.VarChar(100)
  platform        String           @default("meta") @db.VarChar(20)
  adAccountId     String           @map("ad_account_id") @db.VarChar(100)
  status          AiAdsCacheStatus @default(IDLE)
  result          Json?            @db.JsonB
  errorMessage    String?          @map("error_message") @db.Text
  conversationId  String?          @map("conversation_id") @db.VarChar(150)
  lastRequestedAt DateTime?        @map("last_requested_at") @db.Timestamptz()
  lastCompletedAt DateTime?        @map("last_completed_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, bmId, platform, adAccountId])
  @@index([businessId])
  @@map("ai_ads_health_score_cache")
}

// Lapis 2 SAJA (butuh agy) -- Lapis 1 (campaign-audit-facts) TETAP live tiap dibuka, murni
// Node+DB, cepat, sengaja TIDAK di-cache sesuai instruksi eksplisit Bossfren 2026-08-25.
model AiAdsAuditInsightCache {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  campaignId      String           @map("campaign_id") @db.VarChar(100)
  status          AiAdsCacheStatus @default(IDLE)
  insight         String?          @db.Text
