// [2026-08-26] Cache Analisa AI utk Top Creatives (meta-capi-dashboard) -- ganti template
// hardcoded "Analisis & Rekomendasi Senior Media Buyer" jadi analisa copy nyata (lever-scoring
// ala CTR Optimizer OpenAdKit: emotional_trigger/specificity/urgency/power_words/relevance,
// tiap skor wajib alasan nyebut frasa spesifik) + rewrite konkret before->after, anchor verdict
// ke Quality/Engagement/Conversion Ranking Meta + CTR asli (bukan benchmark generik) karena
// ranking Meta sendiri sudah peer-relative. Pola cache/refresh/cooldown/self-heal SAMA PERSIS
// dgn AiAdsHealthScoreCache/AiAdsAuditInsightCache -- key per adId (bukan campaignId/adAccountId
// krn 1 ad = 1 creative). result disimpan Json (bukan String) krn bentuknya terstruktur
// (verdict + lever_scores + rewrites[]), beda dari AiAdsAuditInsightCache yang cuma teks bebas.
model AiAdsCreativeInsightCache {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  adId            String           @map("ad_id") @db.VarChar(100)
  status          AiAdsCacheStatus @default(IDLE)
  result          Json?            @db.JsonB
  errorMessage    String?          @map("error_message") @db.Text
  conversationId  String?          @map("conversation_id") @db.VarChar(150)
  lastRequestedAt DateTime?        @map("last_requested_at") @db.Timestamptz()
  lastCompletedAt DateTime?        @map("last_completed_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, adId])
  @@index([businessId])
  @@map("ai_ads_creative_insight_cache")
}

// [2026-08-26] Cache Analisa AI utk "Top Ad Fatigue" (meta-capi-dashboard, tombol kedua di kartu
// yang sama dgn Top Creatives) -- rumus decay/severity/signal-scoring diadaptasi dari OpenAdKit
// `lib/prompts/ad-fatigue.ts` (lokal, MIT). BEDA arsitektur dari AiAdsCreativeInsightCache: decay%,
// skor sinyal (frequency/ctr_decay/cpm_increase/creative_lifespan), dan severity overall SEMUA
// dihitung Node murni matematika (Layer 1, di GET /business/meta-ad-fatigue, DETERMINISTIK, nol
// panggilan agy) -- field `result` di sini HANYA nyimpen bagian Layer 2 yg butuh bahasa/kreativitas
// (refresh_options 3 tier effort, new_angles_to_test, kill_threshold), diminta lewat agy pool
// terpisah 'ai-ads-fatigue' spy nggak antre sama fitur agy lain. Isi popup Ad Fatigue SENGAJA beda
// struktur total dari popup Top Creative (permintaan eksplisit Bossfren "isi popup nya beda").
model AiAdsFatigueInsightCache {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  adId            String           @map("ad_id") @db.VarChar(100)
  status          AiAdsCacheStatus @default(IDLE)
  result          Json?            @db.JsonB
  errorMessage    String?          @map("error_message") @db.Text
  conversationId  String?          @map("conversation_id") @db.VarChar(150)
  lastRequestedAt DateTime?        @map("last_requested_at") @db.Timestamptz()
  lastCompletedAt DateTime?        @map("last_completed_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, adId])
  @@index([businessId])
  @@map("ai_ads_fatigue_insight_cache")
}

// [2026-08-26] Cache Lapis 2 (agy, kualitatif doang) utk fitur "Rekomendasi Budget" (kolom Budget
// baru di tabel drill-down Campaign, meta-capi-dashboard). Lapis 1 (fakta CPR/CTR/frekuensi/ROAS
// hari-ini-vs-rata7hari, verdict scale/maintain/attention/kill, saran angka budget baru) DIHITUNG
// MURNI DI NODE (GET /business/budget-facts, nol panggilan agy) dgn nyambungin ulang
// computeCampaignAuditFacts() punya today.cpr/avg7d.cpr (udah Meta-native, prioritas
// cost_per_action_type) -- SENGAJA BUKAN today.cpp/roas function itu krn keduanya dihitung dari
// confirmedCodAmount (closing CS/WA manual, "belum fully integrated" -- sama kelasnya sama cpp yg
// Bossfren eksplisit minta dihindari). ROAS di fitur Budget ini fetch terpisah dari field
// `purchase_roas` Meta Insights (murni Pixel/CAPI value, opsional -- di-skip total dari analisa
// kalau 0/kosong). Field `result` di sini nyimpen narasi kualitatif Lapis 2 (kenapa
// scale/maintain/attention, saran bid strategy, warning), pool agy terpisah 'ai-ads-budget'.
model AiAdsBudgetInsightCache {
  id              String           @id @default(uuid()) @db.Uuid
  businessId      String           @map("business_id") @db.Uuid
  campaignId      String           @map("campaign_id") @db.VarChar(100)
  status          AiAdsCacheStatus @default(IDLE)
  result          Json?            @db.JsonB
  errorMessage    String?          @map("error_message") @db.Text
  conversationId  String?          @map("conversation_id") @db.VarChar(150)
  lastRequestedAt DateTime?        @map("last_requested_at") @db.Timestamptz()
  lastCompletedAt DateTime?        @map("last_completed_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, campaignId])
  @@index([businessId])
  @@map("ai_ads_budget_insight_cache")
}

// [2026-08-26] Audit trail fitur "Edit Budget" (Stage B, BELUM ada endpoint yg nulis ke sini per
// hari ini -- tabel disiapkan duluan bareng migration Stage A biar nggak migrate 2x). Ini jalur
// PERTAMA di dashboard yg langsung ubah daily_budget asli ke Meta -- SENGAJA TIDAK lewat pipeline
// Sentinel (trigger->draft plan agy->approve->execute_mutation.py VPS45): update 1 field scalar,
// dipanggil sinkron langsung dari Node ke Meta Graph API begitu user konfirmasi (opsi "Terapkan
// Rekomendasi" ATAU "Custom"), nol sentuhan ke Python core VPS45. Tabel ini yg gantiin peran jejak
// audit Sentinel versi ringan: siapa (userId), apa (campaignId/adsetId), dari berapa ke berapa,
// sumbernya rekomendasi-AI atau custom, kapan, dan respons Meta-nya sukses/gagal.
model AiAdsBudgetActionLog {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  campaignId      String   @map("campaign_id") @db.VarChar(100)
  targetObjectId  String   @map("target_object_id") @db.VarChar(100)
  targetLevel     String   @map("target_level") @db.VarChar(20)
  oldDailyBudget  Decimal? @map("old_daily_budget") @db.Decimal(14, 2)
  newDailyBudget  Decimal  @map("new_daily_budget") @db.Decimal(14, 2)
  source          String   @db.VarChar(20)
  triggeredByUserId String? @map("triggered_by_user_id") @db.Uuid
  metaSuccess     Boolean  @map("meta_success")
  metaResponse    Json?    @map("meta_response") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([campaignId])
  @@map("ai_ads_budget_action_log")
}


