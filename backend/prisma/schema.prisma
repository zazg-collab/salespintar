// ── Fase 3 (2026-08-24): AI Ads Action Center — rekomendasi 3-Shift & Copilot ──
// Menyimpan setiap siklus rekomendasi (dipicu cron 3-Shift di VPS Antigravity,
// trigger manual dari /app/ai-ads, atau konsultasi Copilot per-campaign) yang
// lewat gerbang approval sebelum eksekusi sungguhan ke Meta Ads. `planPath`
// menunjuk ke file MutationPlan v1 (mutation-plan.schema.json) yang ditulis
// `agy` di PLANS_DIR VPS Antigravity (45.77.247.72) -- backend Sales Pintar
// TIDAK PERNAH menyimpan/memodifikasi file itu sendiri, cuma menyimpan
// referensinya + ringkasannya di sini dan memanggil API Bridge (POST
// /v1/approve, POST /v1/execute) untuk memprosesnya lebih lanjut.

enum AiAdsRecommendationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  EXECUTION_FAILED
}

enum AiAdsShiftType {
  MORNING_EARLY_KILL
  MID_DAY_PACING
  GOLDEN_HOUR_SCALING
  ADHOC_COPILOT
  MANUAL_TRIGGER
}

model AiAdsRecommendation {
  id                String                    @id @default(uuid()) @db.Uuid
  businessId        String                    @map("business_id") @db.Uuid
  bmId              String                    @map("bm_id") @db.VarChar(100)
  // [Fase 1B] shiftType dijadiin nullable: layer baru (layerKey generik) tidak punya shiftType.
  // Nilai lama (MORNING_EARLY_KILL, MID_DAY_PACING, GOLDEN_HOUR_SCALING, dst) tetap valid untuk
  // rekomendasi yang datang dari run_shift.py lewat jalur lama.
  shiftType         AiAdsShiftType?           @map("shift_type")
  // [Fase 1B] layerKey generik — diisi layer baru (layer_mutation, content_review).
  // Format: "layer01_scale_up", "layer07_velocity_spike", dst. Null untuk jalur lama (shiftType != null).
  layerKey          String?                   @map("layer_key") @db.VarChar(100)
  // [Fase 7A] routingType: "mutation" | "content_review" | "report_only" | "emergency_auto"
  // Null untuk rekomendasi dari jalur lama (shiftType != null).
  routingType       String?                   @map("routing_type") @db.VarChar(30)
  // [Fase 7A] isUrgent: true untuk Layer 7 (Velocity Spike), 8 (Zero-Conversion Hard Stop),
  // 12 (LP Dead-Link) — ditampilkan dengan badge merah di antrian approval dan dinaikan ke atas.
  isUrgent          Boolean                   @default(false) @map("is_urgent")
  // [Fase 7A] contentData: JSON preview konten AI untuk content_review (Layer 11/13).
  // Isi: { hooks: [{title, body}], selectedHookIndex?: number } untuk Layer 11,
  // atau { rewriteH1, rewriteSubhead, rewriteCta } untuk Layer 13.
  // NULL untuk tipe mutation (pakai planPath sebagai ganti).
  contentData       Json?                     @map("content_data") @db.JsonB
  status            AiAdsRecommendationStatus @default(PENDING_APPROVAL)
  conversationId    String?                   @map("conversation_id") @db.VarChar(150)
  planPath          String?                   @map("plan_path") @db.Text
  planSummary       Json?                     @map("plan_summary") @db.JsonB
  rawAgyOutput      String?                   @map("raw_agy_output") @db.Text
  requestedBy       String?                   @map("requested_by") @db.VarChar(150)
  approvedBy        String?                   @map("approved_by") @db.VarChar(150)
  approvedAt        DateTime?                 @map("approved_at") @db.Timestamptz()
  rejectedBy        String?                   @map("rejected_by") @db.VarChar(150)
  rejectedAt        DateTime?                 @map("rejected_at") @db.Timestamptz()
  rejectionReason   String?                   @map("rejection_reason") @db.Text
  executionResult   Json?                     @map("execution_result") @db.JsonB
  executedAt        DateTime?                 @map("executed_at") @db.Timestamptz()
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([layerKey])
  @@index([routingType])
  @@map("ai_ads_recommendations")
}


// [2026-08-25] Blueprint "Ekstensi Fase 3: Global Agent Workspace & Multi-BM Token Vault" v1.3,
// Langkah B (redesign UX widget floating). 1 baris per kombinasi business+PIC -- PIC di sini BUKAN
