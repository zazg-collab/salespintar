// POST /video-guard/reinforce — proxy ke metaguard_service /v1/presentation/reinforce
// ══════════════════════════════════════════════════════════════════════════

router.post(
  '/reinforce',
  upload.single('video_file'),
  async (req: Request, res: Response, next: NextFunction) => {
    try {
      const videoFile = req.file;
      const { layers } = req.body;
      if (!videoFile) throw new ValidationError('video_file wajib diisi');
      if (!layers) throw new ValidationError('layers wajib diisi (comma-separated)');

      const form = new FormData();
      form.set('layers', String(layers));
      form.set('video_file', new Blob([videoFile.buffer], { type: videoFile.mimetype }), videoFile.originalname);

      const baseUrl = requireMetaguardUrl();
      const upstream = await fetch(`${baseUrl}/v1/presentation/reinforce`, {
        method: 'POST',
        headers: metaguardHeaders(),
        body: form,
        signal: AbortSignal.timeout(METAGUARD_TIMEOUT_MS),
      });
      const data = await upstream.json();
      res.status(upstream.status).json(data);
    } catch (e) { next(e); }
  },
);

