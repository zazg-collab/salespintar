// GET /video-guard/history — daftar VideoAdAudit milik business ini, dari DB kita sendiri (BUKAN
// proxy ke metaguard_service -- statusnya in-memory & tidak survive restart, lihat catatan header
// modul). Dipakai halaman Dashboard (2.3) & Riwayat Audit (2.3); dashboard menghitung ringkasan
// (success rate, dsb) dari list yang sama di sisi client supaya tidak perlu endpoint agregasi
// terpisah untuk MVP ini.
// ══════════════════════════════════════════════════════════════════════════

const TOTAL_AUDIT_CHANNELS = 5; // visual, audio, teks, thumbnail, landing page -- lihat CHANNEL_LABELS di frontend page.tsx

router.get('/history', async (req: Request, res: Response, next: NextFunction) => {
  try {
    const businessId = req.user!.businessId;
    const take = Math.min(Number(req.query.take) || 50, 200);
    const rows = await prisma.videoAdAudit.findMany({
      where: { businessId },
      orderBy: { createdAt: 'desc' },
      take,
      select: {
        id: true,
        adTitle: true,
        overallScore: true,
        verdict: true,
        layersApplied: true,
        rawReportJson: true,
        createdAt: true,
        updatedAt: true,
      },
    });
    // Feedback Bossfren 2026-08-25: (1) judul Riwayat harus konsisten dgn kartu "Ads Creative" --
    // pakai adName asli (dari _ad_context) kalau ada; (2) kolom status kelengkapan channel, krn
    // investigasi hari ini nemu banyak audit diam-diam cuma pakai teks+thumbnail (video gagal
    // diambil dari Meta) tanpa ada tanda apa pun di UI. `rawReportJson` SENGAJA tidak diteruskan
    // utuh ke response (bisa berat, ada raw_assessment lengkap) -- cuma dipakai hitung 2 field di
    // bawah lalu dibuang.
    const audits = rows.map((r) => {
      const ctx = (r.rawReportJson as any)?._ad_context;
      return {
        id: r.id,
        adTitle: r.adTitle,
        adName: ctx?.adName ?? null,
        // [2026-08-25] Round D point 1 (Bossfren): tabel Riwayat baru butuh tahu channel MANA yang
        // berhasil (bukan cuma hitung N/5) supaya bisa render icon Text/Image/Video/Link per baris --
        // sebelumnya cuma channelsCompleted (angka) yang diteruskan, sekarang array-nya juga.
        channels: r.layersApplied || [],
        description: ctx?.originalPrimaryText ?? null,
        overallScore: r.overallScore,
        verdict: r.verdict,
        channelsCompleted: (r.layersApplied || []).length,
        channelsTotal: TOTAL_AUDIT_CHANNELS,
        createdAt: r.createdAt,
        updatedAt: r.updatedAt,
      };
    });
    res.json({ audits });
  } catch (e) { next(e); }
});

// ══════════════════════════════════════════════════════════════════════════
// GET /video-guard/meta-rejected-creatives — creative yang DITOLAK Meta sendiri (Ad Review),
// di semua Business Manager yang terkoneksi di salespintar utk business ini. Pola fetch Graph API
// SAMA PERSIS dgn /business/meta-top-creatives (business.routes.ts) -- loop BM aktif -> ad account
// -> fetch ads -- tapi filter `effective_status=DISAPPROVED` (bukan sort-by-CTR), dan ambil
// `ad_review_feedback` (alasan reject asli dari Meta) alih-alih quality_ranking. SENGAJA hanya
// DISAPPROVED, bukan WITH_ISSUES -- WITH_ISSUES itu masalah teknis/akun (pixel hilang, akun
// nonaktif), bukan pelanggaran konten, jadi tidak relevan buat menu MetaGuard ini (keputusan
// Bossfren 2026-08-25).
//
// Tidak menjalankan audit MetaGuard AI apa pun di sini -- itu murni proxy baca Graph API (murah,
// cepat), di-cache Redis pendek. Audit sungguhan (mahal, panggil agy) BARU jalan kalau user klik
// tombol "Audit MetaGuard AI" di popup, lihat POST /meta-rejected-creatives/:adId/audit di bawah.
// ══════════════════════════════════════════════════════════════════════════

const META_GRAPH_VERSION = 'v21.0';

async function getActiveBmTokens(businessId: string): Promise<Array<{ bmId: string; token: string }>> {
  const bms = await prisma.metaBusinessManager.findMany({
    where: { businessId, isActive: true, tokenStatus: 'ACTIVE' },
  });
  const out: Array<{ bmId: string; token: string }> = [];
  for (const bm of bms) {
    const token = decrypt(bm.accessToken);
    if (token) out.push({ bmId: bm.id, token });
  }
  return out;
}

/** Ambil video_id "asli" yang bisa dipakai buat resolve source url mp4 -- lewat pengalaman empiris
 *  (2026-08-25): `creative.video_id` level atas SERING BEDA dari
 *  `creative.object_story_spec.video_data.video_id` dan yang terakhir ini yang benar-benar bisa
 *  di-resolve `?fields=source`-nya, bukan yang pertama. Fallback ke level atas kalau nested nggak ada. */
function extractMetaVideoId(creative: any): string | null {
  return creative?.object_story_spec?.video_data?.video_id || creative?.video_id || null;
}

function extractLandingPageUrl(creative: any): string | null {
  return creative?.object_story_spec?.video_data?.call_to_action?.value?.link
    || creative?.object_story_spec?.link_data?.link
    || null;
}

function extractCreativeCopy(creative: any): { headline?: string; primaryText?: string } {
  const headline = creative?.object_story_spec?.video_data?.title || creative?.title || undefined;
  const primaryText = creative?.object_story_spec?.video_data?.message || creative?.body || undefined;
  return { headline, primaryText };
}

router.get('/meta-rejected-creatives', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const businessId = req.user!.businessId;
    const limit = Math.min(parseInt(req.query.limit as string) || 30, 100);

    const cacheKey = `salespintar:video-guard:meta-rejected:${businessId}`;
    const { redisCache } = await import('../config/redis');
    const forceRefresh = req.query.forceRefresh === 'true';
    const cached = await redisCache.get(cacheKey).catch(() => null);
    if (cached && !forceRefresh) {
      return res.json(JSON.parse(cached));
    }

    const bmTokens = await getActiveBmTokens(businessId);
    const rejected: any[] = [];
    const uniqueAdAccounts = new Set<string>();

    for (const { token } of bmTokens) {
      try {
        const adAccResp = await fetch(`https://graph.facebook.com/${META_GRAPH_VERSION}/me/adaccounts?fields=id&access_token=${token}`);
        if (!adAccResp.ok) continue;
        const adAccounts = ((await adAccResp.json()) as any).data || [];

        await Promise.allSettled(adAccounts.map(async (act: any) => {
          const actId = act.id;
          const dedupeKey = `${actId}:${token.slice(0, 8)}`;
          if (uniqueAdAccounts.has(dedupeKey)) return;
          uniqueAdAccounts.add(dedupeKey);

          const q = new URLSearchParams({
            fields: 'id,name,campaign{name},ad_review_feedback,creative{id,name,thumbnail_url,image_url,video_id,object_story_spec,body}',
            effective_status: JSON.stringify(['DISAPPROVED']),
            limit: '50',
            access_token: token,
          });
          const adsResp = await fetch(`https://graph.facebook.com/${META_GRAPH_VERSION}/${actId}/ads?${q.toString()}`);
          if (!adsResp.ok) return;
          const ads = ((await adsResp.json()) as any).data || [];

          for (const ad of ads) {
            const feedback = ad.ad_review_feedback?.global || {};
            const violationKeys = Object.keys(feedback);
            if (violationKeys.length === 0) continue; // DISAPPROVED tapi tanpa feedback terbaca -- skip drpd nampilin badge kosong
            const violationLabel = violationKeys[0];
            const violationMessage = feedback[violationLabel];
            const creative = ad.creative || {};
            const metaVideoId = extractMetaVideoId(creative);
            const isVideo = Boolean(metaVideoId);

            rejected.push({
              metaAdId: ad.id,
              adAccountId: actId,
              adName: ad.name,
              campaignName: ad.campaign?.name || '-',
              thumbnailUrl: creative.thumbnail_url || creative.image_url || null,
              mediaType: isVideo ? 'VIDEO' : 'IMAGE',
              metaVideoId,
              violationLabel,
              violationMessage,
              token, // dipakai step berikutnya (insight + preview), DIHAPUS sebelum dikirim ke client
            });
          }
        }));
      } catch (e) {
        logger.warn(`[VideoGuard] Gagal fetch rejected creatives dari salah satu BM: ${(e as Error).message}`);
      }
    }

    const limited = rejected.slice(0, limit);

    // Insight (spend/ctr/impressions) lifetime -- disapproved bisa jadi sempat tayang sebelum
    // ketahuan, atau belum tayang sama sekali (spend 0). Best-effort, gagal per-item tidak fatal.
    // Preview iframe interaktif -- pola sama dgn /business/meta-top-creatives.
    await Promise.allSettled(limited.map(async (item) => {
      try {
        const insQ = new URLSearchParams({
          level: 'ad',
          fields: 'ad_id,spend,ctr,impressions',
          date_preset: 'maximum',
          filtering: JSON.stringify([{ field: 'ad.id', operator: 'IN', value: [item.metaAdId] }]),
          access_token: item.token,
        });
        const insResp = await fetch(`https://graph.facebook.com/${META_GRAPH_VERSION}/${item.adAccountId}/insights?${insQ.toString()}`);
        if (insResp.ok) {
          const row = ((await insResp.json()) as any).data?.[0];
          item.spend = parseFloat(row?.spend || '0');
          item.ctr = parseFloat(row?.ctr || '0');
          item.impressions = parseInt(row?.impressions || '0', 10);
        } else {
          item.spend = 0; item.ctr = 0; item.impressions = 0;
        }
      } catch { item.spend = 0; item.ctr = 0; item.impressions = 0; }

      try {
        const prevRes = await fetch(`https://graph.facebook.com/${META_GRAPH_VERSION}/${item.metaAdId}/previews?ad_format=MOBILE_FEED_STANDARD&access_token=${item.token}`);
        if (prevRes.ok) {
          const prevData = (await prevRes.json()) as any;
          item.previewIframe = prevData.data?.[0]?.body || null;
        }
      } catch { /* opsional, biarkan null */ }

      delete item.token;
    }));

    // Tandai yang SUDAH pernah diaudit MetaGuard AI -- 1 query findMany drpd N findFirst.
    const metaAdIds = limited.map((i) => i.metaAdId);
    const existingAudits = metaAdIds.length
      ? await prisma.videoAdAudit.findMany({
          where: { businessId, metaAdId: { in: metaAdIds } },
          select: { id: true, metaAdId: true, overallScore: true, verdict: true },
        })
      : [];
    const auditByAdId = new Map(existingAudits.map((a) => [a.metaAdId as string, a]));
    for (const item of limited) {
      const existing = auditByAdId.get(item.metaAdId);
      item.existingAuditId = existing?.id ?? null;
      item.existingOverallScore = existing?.overallScore ?? null;
      item.existingVerdict = existing?.verdict ?? null;
    }

    const payload = { data: limited };
    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 15 * 60).catch(() => {});
    res.json(payload);
  } catch (e) { next(e); }
});

const MAX_META_VIDEO_DOWNLOAD_MS = 60_000; // download video dari CDN Meta bisa lebih lama drpd
// panggilan API biasa -- beda dgn METAGUARD_TIMEOUT_MS yang buat submit/poll ringan ke metaguard_service.

/** Cari token BM (dari business ini) yang punya akses ke adId tertentu -- ad Meta di-scope per BM,
 *  jadi harus dicoba satu-satu (persis pola yang kepakai pas investigasi manual 2026-08-25: token
 *  yang bukan pemilik ad akan dapat error "does not exist ... missing permissions", BUKAN exception
 *  fatal -- itu sinyal normal buat lanjut coba token berikutnya). */
async function resolveAdOwnerToken(businessId: string, adId: string): Promise<string | null> {
  const bmTokens = await getActiveBmTokens(businessId);
  for (const { token } of bmTokens) {
    try {
      const r = await fetch(`https://graph.facebook.com/${META_GRAPH_VERSION}/${adId}?fields=id&access_token=${token}`);
      const j = (await r.json()) as any;
      if (r.ok && !j.error) return token;
    } catch { /* coba token berikutnya */ }
  }
  return null;
}

async function downloadUrlAsBuffer(url: string, timeoutMs: number): Promise<{ buffer: Buffer; contentType: string } | null> {
  const resp = await fetch(url, { signal: AbortSignal.timeout(timeoutMs) });
  if (!resp.ok) return null;
  const contentLength = resp.headers.get('content-length');
  if (contentLength && parseInt(contentLength, 10) > MAX_VIDEO_BYTES) {
    throw new ValidationError(`File dari Meta terlalu besar (${contentLength} bytes, batas ${MAX_VIDEO_BYTES}).`);
  }
  const buffer = Buffer.from(await resp.arrayBuffer());
  if (buffer.byteLength > MAX_VIDEO_BYTES) {
    throw new ValidationError(`File dari Meta terlalu besar (${buffer.byteLength} bytes, batas ${MAX_VIDEO_BYTES}).`);
  }
  return { buffer, contentType: resp.headers.get('content-type') || 'application/octet-stream' };
}

// ══════════════════════════════════════════════════════════════════════════
// POST /video-guard/meta-rejected-creatives/:adId/audit — tombol "Audit MetaGuard AI" di popup.
// Dedup WAJIB (permintaan eksplisit Bossfren 2026-08-25): kalau ad ini SUDAH pernah diaudit
// (baris VideoAdAudit dgn metaAdId yang sama sudah ada), balikin audit_id yang lama LANGSUNG,
// JANGAN jalankan audit baru -- supaya video yang sama tidak berkali-kali kena biaya agy/LLM.
// Kalau belum pernah: download video+thumbnail dari Meta CDN, forward ke metaguard_service PERSIS
// seperti alur upload manual POST /audit di atas (multipart form yang sama), supaya nol perubahan
// dibutuhkan di metaguard_service sendiri.
// ══════════════════════════════════════════════════════════════════════════

router.post('/meta-rejected-creatives/:adId/audit', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const businessId = req.user!.businessId;
    const adId = String(req.params.adId);

    const existing = await prisma.videoAdAudit.findFirst({ where: { businessId, metaAdId: adId } });
    // TEMUAN 2026-08-25 (smoke test nyata dgn video produksi asli 15MB): kalau audit sebelumnya
    // gagal secara TEKNIS (agy exit non-zero / timeout AGY_TIMEOUT_MS 300s di api-bridge -- lihat
    // ledger entry hari ini), metaguard_service TETAP membalikin status "done" dgn verdict
    // MANUAL_REVIEW + overallScore 0 (bukan error HTTP) -- laporan "sukses" secara struktur tapi
    // isinya cuma placeholder gagal-parse. Kalau baris begini dianggap "sudah diaudit" oleh dedup,
    // user TERKUNCI PERMANEN tanpa jalan retry. Jadi baris gagal-teknis begini TIDAK dihitung sbg
    // "sudah diaudit" -- dedup cuma berlaku utk hasil yang BENERAN selesai dianalisis.
    const looksLikeTechnicalFailure = (row: typeof existing) => {
      if (!row) return false;
      if (row.verdict !== 'MANUAL_REVIEW' || row.overallScore !== 0) return false;
      const summary = (row.rawReportJson as any)?.raw_assessment?.executive_summary as string | undefined;
      return typeof summary === 'string' && (
        summary.includes('gagal diparse') || summary.includes('invoker') && summary.includes('gagal')
      );
    };
    if (existing && !looksLikeTechnicalFailure(existing)) {
      return res.json({ audit_id: existing.id, already_audited: true });
    }
    if (existing) {
      logger.warn(`[VideoGuard] Baris audit lama utk meta ad ${adId} kelihatan gagal teknis (bukan hasil AI beneran) -- audit ulang, baris lama akan ditimpa metaAdId-nya.`);
      // Lepas metaAdId dari baris lama supaya tidak bentrok sama unique constraint saat baris baru
      // dibuat -- baris lama tetap ada (histori percobaan gagal), cuma tidak lagi "terikat" ke ad ini.
      await prisma.videoAdAudit.update({ where: { id: existing.id }, data: { metaAdId: null } });
    }

    const token = await resolveAdOwnerToken(businessId, adId);
    if (!token) throw new NotFoundError('Ad Meta (tidak ditemukan di BM manapun yang terkoneksi utk business ini)');

    const q = new URLSearchParams({
      fields: 'id,name,ad_review_feedback,creative{id,name,thumbnail_url,image_url,video_id,object_story_spec,body}',
      access_token: token,
    });
    const adResp = await fetch(`https://graph.facebook.com/${META_GRAPH_VERSION}/${adId}?${q.toString()}`);
    const adData = (await adResp.json()) as any;
    if (!adResp.ok || adData.error) {
      throw new ValidationError(`Gagal ambil detail ad dari Meta: ${adData.error?.message || 'unknown error'}`);
    }

    const creative = adData.creative || {};
    const metaVideoId = extractMetaVideoId(creative);
    const landingPageUrl = extractLandingPageUrl(creative);
    const { headline, primaryText } = extractCreativeCopy(creative);
    const adTitle = creative.name || adData.name || `Meta Ad ${adId}`;

    let videoBuffer: Buffer | null = null;
    let videoContentType = 'video/mp4';
    if (metaVideoId) {
      const srcResp = await fetch(`https://graph.facebook.com/${META_GRAPH_VERSION}/${metaVideoId}?fields=source&access_token=${token}`);
      const srcData = (await srcResp.json()) as any;
      if (srcResp.ok && srcData.source) {
        const downloaded = await downloadUrlAsBuffer(srcData.source, MAX_META_VIDEO_DOWNLOAD_MS);
        if (downloaded) { videoBuffer = downloaded.buffer; videoContentType = downloaded.contentType; }
      } else {
        logger.warn(`[VideoGuard] video_id ${metaVideoId} (ad ${adId}) tidak bisa di-resolve source-nya: ${JSON.stringify(srcData).slice(0, 300)}`);
      }
    }

    let thumbnailBuffer: Buffer | null = null;
    let thumbnailContentType = 'image/jpeg';
    const thumbUrl = creative.thumbnail_url || creative.image_url;
    if (thumbUrl) {
      try {
        const downloaded = await downloadUrlAsBuffer(thumbUrl, 20_000);
        if (downloaded) { thumbnailBuffer = downloaded.buffer; thumbnailContentType = downloaded.contentType; }
      } catch (e) {
        logger.warn(`[VideoGuard] Gagal download thumbnail ad ${adId}: ${(e as Error).message}`);
      }
    }

    if (!videoBuffer && !thumbnailBuffer && !landingPageUrl) {
      throw new ValidationError('Tidak ada video/thumbnail/landing page yang bisa diambil dari creative Meta ini.');
    }

    const geminiKey = await resolveBusinessGeminiKey(businessId);
    const form = new FormData();
    form.set('ad_title', String(adTitle));
    if (primaryText) form.set('primary_text', String(primaryText));
    if (headline) form.set('headline', String(headline));
    if (landingPageUrl) form.set('landing_page_url', String(landingPageUrl));
    if (videoBuffer) form.set('video_file', new Blob([videoBuffer], { type: videoContentType }), `meta-ad-${adId}.mp4`);
    if (thumbnailBuffer) form.set('thumbnail_file', new Blob([thumbnailBuffer], { type: thumbnailContentType }), `meta-ad-${adId}-thumb.jpg`);

    const baseUrl = requireMetaguardUrl();
    const upstream = await fetch(`${baseUrl}/v1/audit`, {
      method: 'POST',
      headers: metaguardHeaders(geminiKey ? { 'X-Gemini-Api-Key': geminiKey } : undefined),
      body: form,
      signal: AbortSignal.timeout(METAGUARD_TIMEOUT_MS),
    });
    const data: any = await upstream.json();
    if (!upstream.ok) {
      logger.warn(`[VideoGuard] metaguard_service /v1/audit menolak (dari Meta ad ${adId}): ${upstream.status} ${JSON.stringify(data)}`);
    } else if (typeof data?.audit_id === 'string') {
      try {
        await prisma.videoAdAudit.create({
          data: {
            id: data.audit_id,
            businessId,
            adTitle: String(adTitle),
            metaAdId: adId,
            metaVideoId: metaVideoId || undefined,
            // _ad_context (2026-08-25, feedback Bossfren): simpan nama ad ASLI (adData.name --
            // yang tampil di kartu "Ads Creative") + copy asli SEBELUM diaudit, supaya halaman
            // Riwayat & Laporan bisa konsisten dgn kartu Ads Creative (bukan cuma nama creative
            // yg dipakai `adTitle`), dan "Saran Caption" bisa dibandingkan versi asli vs saran.
            rawReportJson: {
              _ad_context: {
                adName: adData.name || null,
                originalHeadline: headline || null,
                originalPrimaryText: primaryText || null,
              },
            } as Prisma.InputJsonValue,
          },
        });
      } catch (e) {
        logger.warn(`[VideoGuard] Gagal simpan VideoAdAudit awal (Meta ad ${adId}) ${data.audit_id}: ${(e as Error).message}`);
      }
    }
    res.status(upstream.status).json(data);
  } catch (e) { next(e); }
});

export default router;
