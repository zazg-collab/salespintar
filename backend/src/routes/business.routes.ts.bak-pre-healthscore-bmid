router.post('/meta-pixels', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { name, pixelId, accessToken, landingPageUrls, isActive, bmId } = req.body;
    if (!name || typeof name !== 'string' || !name.trim()) {
      throw new ValidationError('Nama pixel wajib diisi');
    }
    if (!pixelId || typeof pixelId !== 'string' || !pixelId.trim()) {
      throw new ValidationError('Pixel ID wajib diisi');
    }

    let resolvedAccessToken: string;

    // ── Mode BM: Salin token dari MetaBusinessManager secara server-side ──
    // Token TIDAK pernah dikirim ke frontend (sesuai aturan keamanan), jadi kita
    // ambil langsung dari DB pakai bmId yang dikirim frontend.
    if (bmId && typeof bmId === 'string' && bmId.trim()) {
      const bm = await prisma.metaBusinessManager.findFirst({
        where: { id: bmId.trim(), businessId: req.user!.businessId, isActive: true },
        select: { accessToken: true },
      });
      if (!bm) {
        throw new ValidationError('BM terdaftar tidak ditemukan atau tidak aktif');
      }
      // token di DB sudah terenkripsi — langsung disalin ke MetaPixelConfig (tetap terenkripsi)
      resolvedAccessToken = bm.accessToken;
    } else {
      // ── Mode Manual: validasi & enkripsi token dari input user ──
      if (!accessToken || typeof accessToken !== 'string' || !accessToken.trim()) {
        throw new ValidationError('Access Token wajib diisi untuk pixel baru');
      }
      resolvedAccessToken = encrypt(accessToken.trim());
    }

    const normalizedUrls = Array.isArray(landingPageUrls)
      ? landingPageUrls
          .filter((u): u is string => typeof u === 'string')
          .map(u => u.trim().toLowerCase().replace(/^https?:\/\//, '').replace(/\/+$/, ''))
          .filter(Boolean)
      : [];

    const pixel = await prisma.metaPixelConfig.create({
      data: {
        businessId: req.user!.businessId,
        name: name.trim(),
        pixelId: pixelId.trim(),
        accessToken: resolvedAccessToken,
        landingPageUrls: normalizedUrls,
        isActive: isActive !== undefined ? Boolean(isActive) : true
      },
      select: {
        id: true,
        businessId: true,
        name: true,
        pixelId: true,
        landingPageUrls: true,
        isActive: true,
        createdAt: true,
        updatedAt: true,
      }
    });

    // Fix #7 (Fase 47): bust Redis cache pixel config supaya perubahan langsung berlaku
    const { redisCache } = await import('../config/redis');
    await redisCache.del(`salespintar:capi:pixels:${req.user!.businessId}`).catch(() => {});

    res.json(pixel);
  } catch (e) { next(e); }
});


router.put('/meta-pixels/:id', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { name, pixelId, accessToken, landingPageUrls, isActive } = req.body;
    const dataToUpdate: Record<string, unknown> = {};
    if (typeof name === 'string' && name.trim()) dataToUpdate.name = name.trim();
    if (typeof pixelId === 'string' && pixelId.trim()) dataToUpdate.pixelId = pixelId.trim();
    if (typeof isActive === 'boolean') dataToUpdate.isActive = isActive;
    if (typeof accessToken === 'string' && accessToken.trim()) {
      dataToUpdate.accessToken = encrypt(accessToken.trim());
