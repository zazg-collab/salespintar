router.get('/meta-capi-stats', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    
    const startDate = req.query.startDate as string;
    const endDate = req.query.endDate as string;
    const period = (req.query.period as string) || 'today';
    
    let gte: Date | undefined;
    let lte: Date | undefined;
    
    if (startDate && endDate) {
      gte = new Date(startDate + 'T00:00:00.000+07:00');
      lte = new Date(endDate + 'T23:59:59.999+07:00');
    } else {
      const now = new Date();
      if (period === 'today') {
        gte = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        lte = new Date(gte.getTime() + 24 * 60 * 60 * 1000 - 1);
      } else if (period === 'yesterday') {
        gte = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
        lte = new Date(gte.getTime() + 24 * 60 * 60 * 1000 - 1);
      } else if (period === 'this_month') {
        gte = new Date(now.getFullYear(), now.getMonth(), 1);
        lte = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);
      }
    }
    
    const whereClause: any = { businessId, leadCategory: 'PROSPEK_IKLAN' };
    if (gte && lte) {
      whereClause.createdAt = { gte, lte };
    }
    
    const customPixelId = req.query.pixelId as string;
    if (customPixelId && customPixelId !== 'all') {
      whereClause.metaCapiPixelId = customPixelId;
    }
    
    const leads = await prisma.lead.findMany({
      where: whereClause,
      select: { capiEventsSent: true, confirmedCodAmount: true }
    });
    
    const b = await prisma.business.findUnique({
      where: { id: businessId },
      select: { metaCapiEventMap: true, metaCapiEnabled: true }
    });
    
    const DEFAULT_EVENT_MAP: Record<string, string> = {
      NEW_LEAD: 'ViewContent',
      WARM: 'Lead',
      HOT: 'AddToCart',
      CLOSING: 'Purchase'
    };
    
    const eventMap = (b?.metaCapiEventMap && typeof b.metaCapiEventMap === 'object')
      ? (b.metaCapiEventMap as Record<string, string>)
      : DEFAULT_EVENT_MAP;
      
    const evNewLead = eventMap.NEW_LEAD || 'ViewContent';
    const evWarm = eventMap.WARM || 'Lead';
    const evHot = eventMap.HOT || 'AddToCart';
    const evClosing = eventMap.CLOSING || 'Purchase';
    
    let funnelViewContent = 0;
    let funnelLead = 0;
    let funnelAddToCart = 0;
    let funnelPurchase = 0;
    let totalNilaiClosing = 0;
    
    for (const lead of leads) {
      if (lead.capiEventsSent.includes(evNewLead)) funnelViewContent++;
      if (lead.capiEventsSent.includes(evWarm)) funnelLead++;
      if (lead.capiEventsSent.includes(evHot)) funnelAddToCart++;
      if (lead.capiEventsSent.includes(evClosing)) funnelPurchase++;
      
      if (lead.capiEventsSent.includes(evClosing) && lead.confirmedCodAmount) {
        totalNilaiClosing += lead.confirmedCodAmount;
      }
    }
    
    res.json({
      period,
      metaCapiEnabled: b?.metaCapiEnabled || false,
      totalSpend: 0,
      totalLeadProspek: leads.length,
      funnelViewContent,
      funnelLead,
      funnelAddToCart,
      funnelPurchase,
      totalNilaiClosing,
      eventMap
    });
  } catch (e) { next(e); }
});

