// ── PATCH /business/meta-capi ───────────────────────────────────────────────────
router.patch('/meta-capi', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const body = req.body ?? {};
    const dataToUpdate: any = {};

    if (body.metaCapiPixelId !== undefined) {
      dataToUpdate.metaCapiPixelId = typeof body.metaCapiPixelId === 'string' && body.metaCapiPixelId.trim()
        ? body.metaCapiPixelId.trim()
        : null;
    }
    if (body.metaCapiTestEventCode !== undefined) {
      dataToUpdate.metaCapiTestEventCode = typeof body.metaCapiTestEventCode === 'string' && body.metaCapiTestEventCode.trim()
        ? body.metaCapiTestEventCode.trim()
        : null;
    }
    if (body.metaCapiWabaId !== undefined) {
      dataToUpdate.metaCapiWabaId = typeof body.metaCapiWabaId === 'string' && body.metaCapiWabaId.trim()
        ? body.metaCapiWabaId.trim()
        : null;
    }
    if (body.metaCapiCurrency !== undefined) {
      const cur = typeof body.metaCapiCurrency === 'string' ? body.metaCapiCurrency.trim().toUpperCase() : '';
      if (!/^[A-Z]{3}$/.test(cur)) throw new ValidationError('metaCapiCurrency wajib kode 3 huruf, mis. IDR');
      dataToUpdate.metaCapiCurrency = cur;
    }
    if (body.metaCapiEventMap !== undefined) {
      dataToUpdate.metaCapiEventMap = body.metaCapiEventMap && typeof body.metaCapiEventMap === 'object'
        ? body.metaCapiEventMap
        : null;
    }
    // Token: string kosong = hapus (set null), string berisi = enkripsi & simpan,
    // undefined = tidak diubah (JANGAN pernah timpa dgn null krn field tidak dikirim).
    if (body.metaCapiAccessToken !== undefined) {
      const raw = typeof body.metaCapiAccessToken === 'string' ? body.metaCapiAccessToken.trim() : '';
      dataToUpdate.metaCapiAccessToken = raw ? encrypt(raw) : null;
    }

    if (body.metaCapiEnabled !== undefined) {
      if (typeof body.metaCapiEnabled !== 'boolean') throw new ValidationError('metaCapiEnabled wajib boolean');
      if (body.metaCapiEnabled) {
        // GERBANG (sama seperti §6 hook rencana): tidak boleh aktif tanpa pixel+token
        // lengkap -- cek nilai YANG AKAN TERSIMPAN (baru ATAU lama), bukan cuma yang lama.
        const existing = await prisma.business.findUnique({
          where: { id: businessId },
          select: { metaCapiPixelId: true, metaCapiAccessToken: true },
        });
        const finalPixelId = dataToUpdate.metaCapiPixelId !== undefined ? dataToUpdate.metaCapiPixelId : existing?.metaCapiPixelId;
        const finalToken = dataToUpdate.metaCapiAccessToken !== undefined ? dataToUpdate.metaCapiAccessToken : existing?.metaCapiAccessToken;
        if (!finalPixelId || !finalToken) {
          throw new ValidationError('Isi Pixel ID dan Access Token dulu sebelum mengaktifkan Meta CAPI');
        }
      }
      dataToUpdate.metaCapiEnabled = body.metaCapiEnabled;
    }

    if (Object.keys(dataToUpdate).length === 0) {
      res.json({ message: 'Tidak ada perubahan data' });
      return;
    }

    const b = await prisma.business.update({ where: { id: businessId }, data: dataToUpdate, select: META_CAPI_SELECT });
    logger.info(`[Business/MetaCapi] Konfigurasi diperbarui (business ${businessId})`);
    res.json({ ...shapeMetaCapiResponse(b), message: 'Konfigurasi Meta CAPI tersimpan.' });
  } catch (e) { next(e); }
});

/**
 * POST /business/meta-capi/test-connection — kirim SATU test event ke Meta pakai
 * `test_event_code` (masuk tab Test Events di Events Manager, TIDAK terhitung
 * sbg konversi asli). Pakai kredensial YANG SUDAH TERSIMPAN -- form Konfigurasi
 * harus disimpan (PATCH) dulu sebelum tombol "Tes Koneksi" dipakai, supaya
 * kredensial yg diuji sama persis dgn yg akan dipakai hook produksi nanti.
 *
 * Implementasi payload minimal di sini (bukan lewat capi.service.ts) SENGAJA --
 * capi.service.ts (Tahap 3 rencana) baru dibangun belakangan; route ini cukup
 * dulu utk memverifikasi kredensial & konektivitas dasar. Akan direfactor
 * memakai capi.service.ts begitu itu ada, hindari payload-building ganda.
 */
router.post('/meta-capi/test-connection', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const b = await prisma.business.findUnique({
      where: { id: businessId },
      select: { metaCapiPixelId: true, metaCapiAccessToken: true, metaCapiTestEventCode: true },
    });
    if (!b?.metaCapiPixelId || !b?.metaCapiAccessToken) {
      throw new ValidationError('Isi & simpan Pixel ID dan Access Token dulu sebelum tes koneksi');
    }
    if (!b?.metaCapiTestEventCode) {
      throw new ValidationError('Isi & simpan Test Event Code dulu -- tanpa ini tes koneksi bisa terhitung sbg event asli');
    }

    const accessToken = decrypt(b.metaCapiAccessToken);
    const dummyPhoneHash = crypto.createHash('sha256').update('6280000000000').digest('hex');

    const graphRes = await fetch(`https://graph.facebook.com/v21.0/${encodeURIComponent(b.metaCapiPixelId)}/events`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        data: [{
          event_name: 'Lead',
          event_time: Math.floor(Date.now() / 1000),
          action_source: 'chat',
          user_data: { ph: [dummyPhoneHash] },
        }],
        test_event_code: b.metaCapiTestEventCode,
        access_token: accessToken,
      }),
    });
    const graphJson: any = await graphRes.json().catch(() => ({}));

    if (!graphRes.ok) {
      logger.warn(`[Business/MetaCapi] Tes koneksi gagal (business ${businessId}): ${JSON.stringify(graphJson)}`);
      res.status(200).json({
        success: false,
        message: graphJson?.error?.message || 'Meta menolak request -- cek Pixel ID/Access Token/Test Event Code.',
        detail: graphJson,
      });
      return;
    }

    logger.info(`[Business/MetaCapi] Tes koneksi sukses (business ${businessId}): ${JSON.stringify(graphJson)}`);
    res.json({
      success: true,
      message: 'Test event terkirim. Cek tab "Test Events" di Meta Events Manager utk konfirmasi.',
      detail: graphJson,
    });
  } catch (e) { next(e); }
});

