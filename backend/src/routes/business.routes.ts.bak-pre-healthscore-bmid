      select: {
        id: true,
        name: true,
        metaBusinessId: true,
        picName: true,
        tokenPreview: true,
        tokenStatus: true,
        isActive: true,
        createdAt: true,
        updatedAt: true,
      },
    });
    res.json(bm);
    // [2026-08-25] Multi-BM Token Vault Tahap 1 (§1.B.2): sync snapshot token aktif ke VPS45 bridge
