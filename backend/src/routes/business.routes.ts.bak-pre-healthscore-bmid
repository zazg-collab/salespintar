    }

    const bms = await prisma.metaBusinessManager.findMany({
      where: { businessId, isActive: true, tokenStatus: 'ACTIVE' }
    });

    let allAds: any[] = [];
    const uniqueAdAccounts = new Set<string>();

    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) continue;
      try {
        const adAccResp = await fetch(`https://graph.facebook.com/v21.0/me/adaccounts?fields=id&access_token=${token}`);
        if (!adAccResp.ok) continue;
        const adAccounts = ((await adAccResp.json()) as any).data || [];
        
        await Promise.allSettled(adAccounts.map(async (act: any) => {
          const actId = act.id;
          if (uniqueAdAccounts.has(actId)) return;
          uniqueAdAccounts.add(actId);

          // Step 1: Ambil insight ad-level TANPA creative field
          const query = new URLSearchParams({
            level: 'ad',
            fields: 'ad_id,ad_name,campaign_name,spend,ctr,impressions,quality_ranking,engagement_rate_ranking,conversion_rate_ranking',
            time_range: JSON.stringify({ since: startDate, until: endDate }),
            access_token: token
          });
          const insResp = await fetch(`https://graph.facebook.com/v21.0/${actId}/insights?${query}`);
          if (insResp.ok) {
            const insights = ((await insResp.json()) as any).data || [];
            for (const row of insights) {
              const imp = parseInt(row.impressions || '0', 10);
              if (imp >= 100) { // Filter min 100 tayangan
                allAds.push({
                  adId: row.ad_id,
                  adName: row.ad_name,
                  campaignName: row.campaign_name,
                  spend: parseFloat(row.spend || '0'),
                  ctr: parseFloat(row.ctr || '0'),
                  impressions: imp,
                  qualityRanking: row.quality_ranking || 'UNKNOWN',
                  engagementRanking: row.engagement_rate_ranking || 'UNKNOWN',
                  conversionRanking: row.conversion_rate_ranking || 'UNKNOWN',
                  token // simpan untuk fetch step 2
                });
              }
            }
          }
        }));
      } catch (err) {}
    }

    // Urutkan CTR DESC dan potong sesuai limit
    allAds.sort((a, b) => b.ctr - a.ctr);
    const topAds = allAds.slice(0, limit);

    // Step 2: Fetch creative thumbnails and interactive preview HANYA untuk topAds
    await Promise.allSettled(topAds.map(async (ad) => {
      try {
        const adResp = await fetch(`https://graph.facebook.com/v21.0/${ad.adId}?fields=creative{id,name,title,body,thumbnail_url,image_url,video_id,object_story_spec,asset_feed_spec,status}&access_token=${ad.token}`);
        if (adResp.ok) {
          const data = (await adResp.json()) as any;
          const creative = data.creative || {};
          ad.thumbnailUrl = creative.thumbnail_url || creative.image_url || creative.object_story_spec?.video_data?.image_url || creative.object_story_spec?.link_data?.picture || creative.object_story_spec?.photo_data?.url || creative.asset_feed_spec?.images?.[0]?.url || null;
          
          const isVideo = Boolean(creative.video_id || creative.object_story_spec?.video_data?.video_id || creative.asset_feed_spec?.videos?.[0]?.video_id);
          ad.mediaType = isVideo ? 'VIDEO' : 'IMAGE';
          ad.adTitle = creative.title || creative.object_story_spec?.video_data?.title || creative.name || '';
          ad.adBody = creative.body || creative.object_story_spec?.video_data?.message || '';
        }

        // Fetch interactive preview iframe (playable video & interactive post)
        const prevRes = await fetch(`https://graph.facebook.com/v21.0/${ad.adId}/previews?ad_format=MOBILE_FEED_STANDARD&access_token=${ad.token}`);
        if (prevRes.ok) {
          const prevData = (await prevRes.json()) as any;
          ad.previewIframe = prevData.data?.[0]?.body || null;
        }
      } catch (err) {}
      delete ad.token; // Jangan bocorkan token
    }));

    const payload = { data: topAds };
    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 20 * 60).catch(() => {});
    res.json(payload);
  } catch (e) { next(e); }
});

export default router;
