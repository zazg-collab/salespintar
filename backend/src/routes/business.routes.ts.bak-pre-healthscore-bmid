const morningEarlyKillSchema = z.object({
  costThreshold: z.number().positive(),
  cpcKillMultiplier: z.number().positive(),
});
const middayPacingSchema = z.object({
  dailyBudget: z.number().positive(),
  dailyLeadsTarget: z.number().nonnegative(),
  spendPaceThreshold: z.number().min(0).max(1),
  leadsPaceThreshold: z.number().min(0).max(1),
  reducePct: z.number().min(0).max(1),
});
const goldenHourScalingSchema = z.object({
  roasTarget: z.number().positive(),
  scalePct: z.number().min(0).max(1),
  maxDailyBudgetCeiling: z.number().positive(),
});

const bmAutomationDefaultsPayloadSchema = z.object({
  thresholdShift: z.object({
    enabled: z.boolean().default(false),
    default: z.object({
      morningEarlyKill: morningEarlyKillSchema,
      middayPacing: middayPacingSchema,
      goldenHourScaling: goldenHourScalingSchema,
    }),
  }),
  spendAnomaly: z.object({
    enabled: z.boolean().default(false),
    default: z.object({
      spendIncreasePctThreshold: z.number().positive().max(1000).default(50),
    }),
  }),
  landingPageCheck: z.object({
    enabled: z.boolean().default(false),
    autoPauseOnDown: z.boolean().default(false),
    timeoutSeconds: z.number().int().positive().max(60).default(10),
