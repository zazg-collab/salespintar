// GET /business/meta-bms/:id/assets — Ambil connected assets (Ad Accounts, Pixels/Datasets, Permissions)
router.get('/meta-bms/:id/assets', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const id = req.params.id as string;

    const bm = await prisma.metaBusinessManager.findFirst({
      where: { id, businessId },
    });
    if (!bm) throw new ValidationError('Akun BM tidak ditemukan');

    const token = decrypt(bm.accessToken);
    if (!token) throw new ValidationError('Token BM tidak valid');

    // 1. Fetch Ad Accounts yang dapat diakses token ini
    let adAccounts: any[] = [];
    try {
      const adAccResp = await fetch(`https://graph.facebook.com/v21.0/me/adaccounts?fields=id,name,account_id,account_status,currency,timezone_name,amount_spent&access_token=${token}`);
      if (adAccResp.ok) {
        const adAccData = (await adAccResp.json()) as any;
        adAccounts = (adAccData.data || []).map((a: any) => ({
          id: a.id,
          accountId: a.account_id,
          name: a.name || a.id,
          status: a.account_status === 1 ? 'ACTIVE' : 'DISABLED',
          currency: a.currency || 'IDR',
          timezone: a.timezone_name || 'Asia/Jakarta',
          amountSpent: parseFloat(a.amount_spent || '0')
        }));
      }
    } catch (adErr) {
      logger.warn(`[Business/MetaAssets] Gagal fetch ad accounts: ${adErr}`);
    }

    // 2. Fetch Pixels / Datasets across Ad Accounts
    const pixelMap = new Map<string, any>();
    await Promise.allSettled(
      adAccounts.map(async (act) => {
        try {
          const pxResp = await fetch(`https://graph.facebook.com/v21.0/${act.id}/adspixels?fields=id,name,data_use_setting,creation_time&access_token=${token}`);
          if (pxResp.ok) {
            const pxData = (await pxResp.json()) as any;
            for (const px of (pxData.data || [])) {
              if (!pixelMap.has(px.id)) {
                pixelMap.set(px.id, {
                  id: px.id,
                  name: px.name,
                  setting: px.data_use_setting,
                  creationTime: px.creation_time,
                  connectedAdAccount: act.name
                });
              }
            }
          }
        } catch (pxErr) {
          logger.warn(`[Business/MetaAssets] Gagal fetch pixels untuk ${act.id}: ${pxErr}`);
        }
      })
    );

    // 3. Permissions yang dimiliki System User Token
    let permissions: string[] = [];
    try {
      const permResp = await fetch(`https://graph.facebook.com/v21.0/me/permissions?access_token=${token}`);
      if (permResp.ok) {
        const permData = (await permResp.json()) as any;
        permissions = (permData.data || [])
          .filter((p: any) => p.status === 'granted')
          .map((p: any) => p.permission);
      }
    } catch (permErr) {
      logger.warn(`[Business/MetaAssets] Gagal fetch permissions: ${permErr}`);
    }

    res.json({
      bm: {
        id: bm.id,
        name: bm.name,
        picName: bm.picName,
        metaBusinessId: bm.metaBusinessId,
        tokenStatus: bm.tokenStatus,
        createdAt: bm.createdAt
      },
      assets: {
        adAccounts,
        pixels: Array.from(pixelMap.values()),
        permissions
      }
    });
  } catch (e) { next(e); }
});

