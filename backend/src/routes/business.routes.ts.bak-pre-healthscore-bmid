            for (const c of (cData.data || [])) {
              if (c.effective_status === 'DELETED' || c.effective_status === 'ARCHIVED') continue;
              campaigns.push({
                id: c.id,
                name: c.name || c.id,
                status: c.effective_status || 'UNKNOWN',
                adAccountId: act.id,
                adAccountName: act.name,
              });
            }
          }
        } catch (cErr) {
          logger.warn(`[Business/MetaCampaigns] Gagal fetch campaigns untuk ${act.id}: ${cErr}`);
        }
      })
    );

    res.json({ campaigns });
  } catch (e) { next(e); }
});

// GET /business/meta-ads-performance — Agregasi Performa & ROAS (Fase 4)
router.get('/meta-ads-performance', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const startDate = (req.query.startDate as string) || new Date().toISOString().split('T')[0];
    const endDate = (req.query.endDate as string) || new Date().toISOString().split('T')[0];

    const cacheKey = `salespintar:meta-perf:${businessId}:${startDate}:${endDate}`;
    const { redisCache } = await import('../config/redis');
    
    const forceRefresh = req.query.forceRefresh === 'true';
    const cached = await redisCache.get(cacheKey).catch(() => null);
    if (cached && !forceRefresh) {
      return res.json(JSON.parse(cached));
    }

    // 1. Ambil semua BM
    const bms = await prisma.metaBusinessManager.findMany({
      where: { businessId, isActive: true }
    });

    // 2 & 4. Kumpulkan Ad Accounts dan Insights
    const metaCampaignsMap = new Map<string, { spend: number, clicks: number, impressions: number, ctr: number, frequency: number, campaignName: string, accountName: string, accountId: string, picName: string, status: string, objective?: string, actions?: any[], cost_per_action_type?: any[] }>();
    const uniqueAdAccounts = new Set<string>();
    let activeBmCount = 0;
    let errorBmCount = 0;

    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) {
        errorBmCount++;
        continue;
      }

      try {
        // Ambil ad accounts yg bisa diakses token ini
        const adAccResp = await fetch(`https://graph.facebook.com/v21.0/me/adaccounts?fields=id,name&access_token=${token}`);
        if (!adAccResp.ok) {
          errorBmCount++;
          const errText = await adAccResp.text();
          logger.warn(`[Business/MetaAds] Gagal me/adaccounts: ${errText}`);
          if (errText.includes('"code":190') || errText.includes('190')) {
            await prisma.metaBusinessManager.update({ where: { id: bm.id }, data: { tokenStatus: 'ERROR' as any } });
          }
          continue;
        }

        activeBmCount++;
        const adAccData = (await adAccResp.json()) as any;
        const adAccounts = adAccData.data || [];
        
        // Fetch per Ad Account secara paralel & terisolasi (Promise.allSettled)
        await Promise.allSettled(
          adAccounts.map(async (act: any) => {
            const actId = act.id;
            const accName = act.name || act.id;
            if (uniqueAdAccounts.has(actId)) return;
            uniqueAdAccounts.add(actId);

            try {
              // 1. Ambil daftar kampanye di Ad Account
              const campResp = await fetch(`https://graph.facebook.com/v21.0/${actId}/campaigns?fields=id,name,status,objective&limit=250&access_token=${token}`);
              if (campResp.ok) {
                const campData = (await campResp.json()) as any;
                for (const camp of (campData.data || [])) {
                  if (!metaCampaignsMap.has(camp.id)) {
                    metaCampaignsMap.set(camp.id, {
                      spend: 0,
                      clicks: 0,
                      impressions: 0,
                      ctr: 0,
                      frequency: 0,
                      actions: [],
                      cost_per_action_type: [],
                      campaignName: camp.name,
                      accountName: accName,
                      accountId: actId,
                      picName: bm.picName,
                      status: camp.status === 'ACTIVE' ? 'Active' : 'Paused',
                      objective: camp.objective || 'UNKNOWN'
                    });
                  }
                }
              }
            } catch (campErr) {
              logger.warn(`[Business/MetaAds] Gagal fetch campaigns untuk ${actId}: ${campErr}`);
            }

            try {
              // 2. Fetch insights per ad account untuk rentang tanggal yang dipilih
              const query = new URLSearchParams({
                level: 'campaign',
                fields: 'spend,campaign_name,campaign_id,clicks,ctr,frequency,impressions,cpc,cpm,actions,cost_per_action_type',
                time_range: JSON.stringify({ since: startDate, until: endDate }),
                access_token: token
              });
              const insResp = await fetch(`https://graph.facebook.com/v21.0/${actId}/insights?${query}`);
              if (insResp.ok) {
                const insData = (await insResp.json()) as any;
                const insights = insData.data || [];
                for (const row of insights) {
                  const cid = row.campaign_id;
                  const spend = parseFloat(row.spend || '0');
                  const clicks = parseInt(row.clicks || '0', 10);
                  const ctr = parseFloat(row.ctr || '0');
                  const frequency = parseFloat(row.frequency || '0');
                  const impressions = parseInt(row.impressions || '0', 10);
                  const actions = row.actions || [];
                  const cost_per_action_type = row.cost_per_action_type || [];

                  if (!metaCampaignsMap.has(cid)) {
                    metaCampaignsMap.set(cid, {
                      spend: 0,
                      clicks: 0,
                      impressions: 0,
                      ctr: 0,
                      frequency: 0,
                      actions: [],
                      cost_per_action_type: [],
                      objective: 'UNKNOWN',
                      campaignName: row.campaign_name,
                      accountName: accName,
                      accountId: actId,
                      picName: bm.picName,
                      status: 'Active'
                    });
                  }
                  
                  const camp = metaCampaignsMap.get(cid)!;
                  camp.spend += spend;
                  camp.clicks += clicks;
                  camp.impressions += impressions;
                  // Untuk rasio seperti CTR dan Frequency, ambil dari insight kampanye
                  camp.ctr = ctr; 
                  camp.frequency = frequency;
                  if (actions.length > 0) {
                    camp.actions = actions;
                  }
                  if (cost_per_action_type.length > 0) {
                    camp.cost_per_action_type = cost_per_action_type;
                  }
                }
              }
            } catch (insErr) {
              logger.warn(`[Business/MetaAds] Gagal fetch insights untuk ${actId}: ${insErr}`);
            }
          })
        );
      } catch (bmErr: any) {
        logger.error(`[Business/MetaAds] Error pada BM loop: ${bmErr}`);
      }
    }

    // 5. JOIN dengan data Closing CS dari database
    const dateFilter = getWibDateRange(startDate, endDate);
    const whereLead: any = { businessId };
    if (dateFilter) {
      whereLead.createdAt = dateFilter;
    }

    const leads = await prisma.lead.findMany({
      where: whereLead,
      select: { metaCampaignId: true, confirmedCodAmount: true, leadStage: true, conversionStatus: true, score: true, capiEventsSent: true }
    });

    let totalOmset = 0;
    let totalSpend = 0;
    const campaignData: any[] = [];
    const picMap = new Map<string, { spend: number, omset: number, closing: number }>();

    // Mapping Omset per campaign (Hanya transaksi yang SUKSES DITEMBAK SEBAGAI PURCHASE di CAPI)
    const omsetByCampaign = new Map<string, { omset: number, leads: number, closing: number }>();
    for (const lead of leads) {
      const cid = lead.metaCampaignId || 'ORGANIC';
      // Bossfren's rule: ONLY count if Meta actually received it!
      const isCapiPurchase = Array.isArray(lead.capiEventsSent) && lead.capiEventsSent.includes('Purchase');
      const amount = isCapiPurchase ? (Number(lead.confirmedCodAmount) || 0) : 0;
      totalOmset += amount;
      
      if (!omsetByCampaign.has(cid)) {
        omsetByCampaign.set(cid, { omset: 0, leads: 0, closing: 0 });
      }
      omsetByCampaign.get(cid)!.omset += amount;
      omsetByCampaign.get(cid)!.leads += 1;
      if (isCapiPurchase) omsetByCampaign.get(cid)!.closing += 1;
    }

    for (const [cid, metaData] of metaCampaignsMap.entries()) {
      totalSpend += metaData.spend;
      const csData = omsetByCampaign.get(cid) || { omset: 0, leads: 0, closing: 0 };
      
      campaignData.push({
        campaignId: cid,
        campaignName: metaData.campaignName,
        accountName: metaData.accountName || '-',
        accountId: metaData.accountId || '-',
        picName: metaData.picName,
        status: metaData.status,
        spend: metaData.spend,
        clicks: (metaData as any).clicks || 0,
        ctr: (metaData as any).ctr || 0,
        frequency: (metaData as any).frequency || 0,
        impressions: (metaData as any).impressions || 0,
        objective: (metaData as any).objective || 'UNKNOWN',
        actions: (metaData as any).actions || [],
        cost_per_action_type: (metaData as any).cost_per_action_type || [],
        leads: csData.leads,
        closing: csData.closing,
        omset: csData.omset,
        roas: metaData.spend > 0 ? (csData.omset / metaData.spend) : 0
      });

      // Aggregate for PIC
      if (!picMap.has(metaData.picName)) picMap.set(metaData.picName, { spend: 0, omset: 0, closing: 0 });
      const pData = picMap.get(metaData.picName)!;
      pData.spend += metaData.spend;
      pData.omset += csData.omset;
      pData.closing += csData.closing;
    }

    // Add Organic to Campaign Table
    if (omsetByCampaign.has('ORGANIC')) {
      const orgData = omsetByCampaign.get('ORGANIC')!;
      campaignData.push({
        campaignId: 'ORGANIC',
        campaignName: 'Organik / Tidak Terlacak',
        accountName: 'Organik',
        accountId: '-',
        picName: '-',
        status: '-',
        spend: 0,
        leads: orgData.leads,
        closing: orgData.closing,
        omset: orgData.omset,
        roas: 0
      });
    }

    // Funnel CAPI BENAR-BENAR menghitung data yang SUDAH SUKSES DIKIRIM ke Meta CAPI:
    // Mencegah false flag jika token error/kosong atau Meta CAPI gagal.
    const funnelStats = {
      viewContent: leads.filter((l: any) => l.capiEventsSent && l.capiEventsSent.includes('ViewContent')).length,
      lead: leads.filter((l: any) => l.capiEventsSent && l.capiEventsSent.includes('Lead')).length,
      addToCart: leads.filter((l: any) => l.capiEventsSent && l.capiEventsSent.includes('AddToCart')).length,
      purchase: leads.filter((l: any) => l.capiEventsSent && l.capiEventsSent.includes('Purchase')).length
    };

    // Hitung status akun & summary teks BM
    let accountStatus = '⚪ Belum Ada BM';
    if (bms.length > 0) {
      if (errorBmCount === 0) {
        accountStatus = '🟢 Semua BM Aktif';
      } else if (activeBmCount > 0) {
        accountStatus = '⚠️ Sebagian BM Error';
      } else {
        accountStatus = '🔴 Semua BM Diskonek';
      }
    }

    const bmSummaryText = bms.length > 0
      ? `${activeBmCount} BM Aktif, ${errorBmCount} Diskonek`
      : '0 BM Terkoneksi';

    // 6 & 7 & 9. Struktur respon
    const payload = {
      execSummary: { 
        totalOmset, 
        totalSpend, 
        realRoas: totalSpend > 0 ? (totalOmset / totalSpend) : 0, 
        accountStatus,
        totalBm: bms.length,
        activeBm: activeBmCount,
        errorBm: errorBmCount,
        bmSummaryText
      },
      picScorecard: Array.from(picMap.entries()).map(([name, data]) => ({
        picName: name,
        spend: data.spend,
        omset: data.omset,
        closing: data.closing,
        roas: data.spend > 0 ? (data.omset / data.spend) : 0
      })),
      campaignTable: campaignData,
      funnelStats
    };

    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 20 * 60).catch(() => {});
    res.json(payload);
  } catch (err) {
    next(err);
  }
});


// GET /business/meta-ads-breakdowns
router.get('/meta-ads-breakdowns', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const startDate = (req.query.startDate as string) || new Date().toISOString().split('T')[0];
    const endDate = (req.query.endDate as string) || new Date().toISOString().split('T')[0];

    const cacheKey = `salespintar:meta-breakdowns:${businessId}:${startDate}:${endDate}`;
    const { redisCache } = await import('../config/redis');
    
    const forceRefresh = req.query.forceRefresh === 'true';
    const cached = await redisCache.get(cacheKey).catch(() => null);
    if (cached && !forceRefresh) {
      return res.json(JSON.parse(cached));
    }

    const bms = await prisma.metaBusinessManager.findMany({
      where: { businessId, tokenStatus: 'ACTIVE' },
      select: { accessToken: true }
    });

    const geoMap = new Map<string, any>();
    const placementMap = new Map<string, any>();

    for (const bm of bms) {
      if (!bm.accessToken) continue;
      
      const token = decrypt(bm.accessToken);
      

      let accountIds: string[] = [];
      try {
        const adAccResp = await fetch(`https://graph.facebook.com/v21.0/me/adaccounts?fields=id&access_token=${token}`);
        if (adAccResp.ok) {
          const adAccData = await adAccResp.json() as any;
          accountIds = (adAccData.data || []).map((a: any) => a.id);
        }
      } catch (e) { continue; }


      const insightPromises = accountIds.map(async (actId) => {
        const geoQuery = new URLSearchParams({
          level: 'ad',
          breakdowns: 'region',
          fields: 'spend,clicks,impressions,cpc,inline_link_click_ctr,ctr',
          time_range: JSON.stringify({ since: startDate, until: endDate }),
          access_token: token
        });
        const placementQuery = new URLSearchParams({
          level: 'ad',
          breakdowns: 'publisher_platform',
          fields: 'spend,clicks,impressions,cpc,inline_link_click_ctr,ctr',
          time_range: JSON.stringify({ since: startDate, until: endDate }),
          access_token: token
        });

        try {
          const [geoResp, plResp] = await Promise.all([
            fetch(`https://graph.facebook.com/v21.0/${actId}/insights?${geoQuery}`),
            fetch(`https://graph.facebook.com/v21.0/${actId}/insights?${placementQuery}`)
          ]);

          if (geoResp.ok) {
            const geoData = await geoResp.json() as any;
            for (const row of (geoData.data || [])) {
              const region = row.region || 'Unknown';
              const spend = parseFloat(row.spend || '0');
              const clicks = parseInt(row.clicks || '0', 10);
              if (spend === 0 && clicks === 0) continue;
              
              if (!geoMap.has(region)) geoMap.set(region, { location: region, spend: 0, clicks: 0, impressions: 0 });
              const current = geoMap.get(region);
              current.spend += spend;
              current.clicks += clicks;
              current.impressions += parseInt(row.impressions || '0', 10);
            }
          }

          if (plResp.ok) {
            const plData = await plResp.json() as any;
            for (const row of (plData.data || [])) {
              let platform = row.publisher_platform || 'Unknown';
              if (platform === 'facebook') platform = 'Facebook';
              else if (platform === 'instagram') platform = 'Instagram';
              else if (platform === 'audience_network') platform = 'Audience Network';
              else if (platform === 'messenger') platform = 'Messenger';
              
              const spend = parseFloat(row.spend || '0');
              const clicks = parseInt(row.clicks || '0', 10);
              if (spend === 0 && clicks === 0) continue;
              
              if (!placementMap.has(platform)) placementMap.set(platform, { placement: platform, spend: 0, clicks: 0, impressions: 0 });
              const current = placementMap.get(platform);
              current.spend += spend;
              current.clicks += clicks;
              current.impressions += parseInt(row.impressions || '0', 10);
            }
          }
        } catch (err) {}
      });
      await Promise.allSettled(insightPromises);
    }

    const payload = {
      geographic: Array.from(geoMap.values()).map(g => ({
        ...g,
        ctr: g.impressions > 0 ? (g.clicks / g.impressions) * 100 : 0,
        cpc: g.clicks > 0 ? g.spend / g.clicks : 0
      })).sort((a, b) => b.spend - a.spend).slice(0, 10), // Top 10
      placement: Array.from(placementMap.values()).map(p => ({
        ...p,
        ctr: p.impressions > 0 ? (p.clicks / p.impressions) * 100 : 0,
        cpc: p.clicks > 0 ? p.spend / p.clicks : 0
      })).sort((a, b) => b.spend - a.spend)
    };

    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 20 * 60).catch(() => {});
    res.json(payload);
  } catch (err) {
    next(err);
  }
});

// GET /business/meta-ads-best-day — Hybrid Analyzer (Fase 4 - Best Day to Run Ads)
router.get('/meta-ads-best-day', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    // Default to last 30 days if not provided
    const end = new Date();
    const start = new Date();
    start.setDate(end.getDate() - 30);
    
    const startDate = (req.query.startDate as string) || start.toISOString().split('T')[0];
    const endDate = (req.query.endDate as string) || end.toISOString().split('T')[0];

    const cacheKey = `salespintar:meta-best-day:${businessId}:${startDate}:${endDate}`;
    const { redisCache } = await import('../config/redis');
    const forceRefresh = req.query.forceRefresh === 'true';
    const cached = await redisCache.get(cacheKey).catch(() => null);
    if (cached && !forceRefresh) {
      return res.json(JSON.parse(cached));
    }

    // Initialize 7 days data (0 = Sunday, 1 = Monday, ..., 6 = Saturday)
    const days = [0, 1, 2, 3, 4, 5, 6].map(d => ({
      dayOfWeek: d,
      spend: 0,
      clicks: 0,
      impressions: 0,
      leads: 0,
      closing: 0,
      omset: 0,
      roas: 0,
      cpa: 0,
      closingRate: 0,
      score: 0
    }));

    const bms = await prisma.metaBusinessManager.findMany({
      where: { businessId, isActive: true, tokenStatus: 'ACTIVE' }
    });

    let totalSpendAll = 0;
    const uniqueAdAccounts = new Set<string>();

    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) continue;
      try {
        const adAccResp = await fetch(`https://graph.facebook.com/v21.0/me/adaccounts?fields=id&access_token=${token}`);
        if (!adAccResp.ok) continue;
        const adAccounts = ((await adAccResp.json()) as any).data || [];
        
        await Promise.allSettled(adAccounts.map(async (act: any) => {
          const actId = act.id;
          if (uniqueAdAccounts.has(actId)) return;
          uniqueAdAccounts.add(actId);

          const query = new URLSearchParams({
            level: 'account',
            fields: 'spend,clicks,impressions',
            time_range: JSON.stringify({ since: startDate, until: endDate }),
            time_increment: '1', // daily
            access_token: token
          });
          const insResp = await fetch(`https://graph.facebook.com/v21.0/${actId}/insights?${query}`);
          if (insResp.ok) {
            const insights = ((await insResp.json()) as any).data || [];
            for (const row of insights) {
              if (row.date_start) {
                // Meta returns YYYY-MM-DD
                const dateObj = new Date(row.date_start + 'T12:00:00.000+07:00'); 
                const dow = dateObj.getDay();
                const spend = parseFloat(row.spend || '0');
                days[dow].spend += spend;
                days[dow].clicks += parseInt(row.clicks || '0', 10);
                days[dow].impressions += parseInt(row.impressions || '0', 10);
                totalSpendAll += spend;
              }
            }
          }
        }));
      } catch (err) {}
    }

    // Fetch DB Leads
    const dateFilter = getWibDateRange(startDate, endDate);
    const whereLead: any = { businessId };
    if (dateFilter) {
      whereLead.createdAt = dateFilter;
    }
    const leads = await prisma.lead.findMany({
      where: whereLead,
      select: { createdAt: true, confirmedCodAmount: true, capiEventsSent: true }
    });

    for (const lead of leads) {
      // Adjusted to WIB explicitly
      const dateWibStr = lead.createdAt.toLocaleString('en-US', { timeZone: 'Asia/Jakarta' });
      const dow = new Date(dateWibStr).getDay();
      days[dow].leads += 1;
      
      const isCapiPurchase = Array.isArray(lead.capiEventsSent) && lead.capiEventsSent.includes('Purchase');
      if (isCapiPurchase) {
        days[dow].closing += 1;
        days[dow].omset += Number(lead.confirmedCodAmount) || 0;
      }
    }

    // Compute Derived & Norm Metrics
    let maxRoas = 0;
    let maxOmset = 0;
    let maxClosingRate = 0;
    let maxVolume = 0;

    for (const d of days) {
      d.roas = d.spend > 0 ? d.omset / d.spend : 0;
      d.cpa = d.closing > 0 ? d.spend / d.closing : 0;
      d.closingRate = d.leads > 0 ? d.closing / d.leads : 0;

      // Ambang batas (Gate): 5% spend & >= 3 leads
      if (d.spend >= totalSpendAll * 0.05 && d.leads >= 3) {
        if (d.roas > maxRoas) maxRoas = d.roas;
        if (d.omset > maxOmset) maxOmset = d.omset;
        if (d.closingRate > maxClosingRate) maxClosingRate = d.closingRate;
        if (d.leads > maxVolume) maxVolume = d.leads;
      }
    }

    // Score
    for (const d of days) {
      if (d.spend >= totalSpendAll * 0.05 && d.leads >= 3) {
        const normRoas = maxRoas > 0 ? d.roas / maxRoas : 0;
        const normOmset = maxOmset > 0 ? d.omset / maxOmset : 0;
        const normClosingRate = maxClosingRate > 0 ? d.closingRate / maxClosingRate : 0;
        const normVolume = maxVolume > 0 ? d.leads / maxVolume : 0;

        d.score = (0.40 * normRoas) + (0.35 * normOmset) + (0.15 * normClosingRate) + (0.10 * normVolume);
      } else {
        d.score = 0;
      }
    }

    const dayNames = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
    const sorted = [...days].sort((a, b) => b.score - a.score);
    const bestDay = sorted[0]?.score > 0 ? dayNames[sorted[0].dayOfWeek] : null;
    const lowDay = sorted.filter(d => d.score > 0).pop();
    const lowDayName = lowDay ? dayNames[lowDay.dayOfWeek] : null;

    const payload = {
      days,
      bestDay,
      lowDayName,
      recommendation: bestDay ? `Berdasarkan ROAS dan konversi, ${bestDay} adalah Peak Day Anda. Pertimbangkan menaikkan budget di hari ini.` : 'Belum cukup data konversi untuk rekomendasi Peak Day.'
    };

    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 20 * 60).catch(() => {});
    res.json(payload);
  } catch (e) { next(e); }
});

