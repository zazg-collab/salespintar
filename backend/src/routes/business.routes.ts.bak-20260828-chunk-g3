/**
 * ── Fase 40 (2026-08-20): Konfigurasi Meta Conversions API (CAPI) ──────────────
 * Rencana lengkap: projek-ceo/20260820-rencana-integrasi-meta-capi.md
 *
 * ⚠️ ATURAN WAJIB (audit Fase 39, temuan #1): endpoint di bawah ini TIDAK PERNAH
 * mengembalikan `metaCapiAccessToken` mentah ATAU terenkripsi dalam bentuk apa pun.
 * Frontend hanya diberi tahu "sudah diisi/belum" (metaCapiConfigured) + preview
 * tersamar (metaCapiTokenPreview, mis. "EAAbc1••••"). Ini SENGAJA beda dari pola
 * `mengantarApiKey` di atas (yang balikin nilai mentah) -- access token Meta System
 * User jauh lebih sensitif kalau bocor ke Network tab browser.
 */

const META_CAPI_SELECT = {
  metaCapiEnabled: true,
  metaCapiPixelId: true,
  metaCapiAccessToken: true, // dibaca di server, TIDAK PERNAH ikut ke response mentah
  metaCapiTestEventCode: true,
  metaCapiWabaId: true,
  metaCapiCurrency: true,
  metaCapiEventMap: true,
  updatedAt: true,
} as const;

function shapeMetaCapiResponse(b: {
  metaCapiEnabled: boolean;
  metaCapiPixelId: string | null;
  metaCapiAccessToken: string | null;
  metaCapiTestEventCode: string | null;
  metaCapiWabaId: string | null;
  metaCapiCurrency: string;
  metaCapiEventMap: any;
  updatedAt: Date;
}) {
  let metaCapiTokenPreview: string | null = null;
  if (b.metaCapiAccessToken) {
    try {
      metaCapiTokenPreview = maskedPreview(decrypt(b.metaCapiAccessToken));
    } catch (e) {
      // Ciphertext rusak/ENCRYPTION_KEY beda dari saat disimpan -- jangan bikin
      // seluruh halaman Konfigurasi gagal load, cukup tandai butuh isi ulang.
      logger.warn(`[Business/MetaCapi] Gagal decrypt token utk preview: ${(e as Error).message}`);
      metaCapiTokenPreview = '(gagal dibaca, isi ulang token)';
    }
  }
  return {
    metaCapiEnabled: b.metaCapiEnabled,
    metaCapiConfigured: Boolean(b.metaCapiAccessToken && b.metaCapiPixelId),
    metaCapiPixelId: b.metaCapiPixelId,
    metaCapiTestEventCode: b.metaCapiTestEventCode,
    metaCapiWabaId: b.metaCapiWabaId,
    metaCapiCurrency: b.metaCapiCurrency,
    metaCapiTokenPreview,
    metaCapiEventMap: b.metaCapiEventMap,
    updatedAt: b.updatedAt,
  };
}

