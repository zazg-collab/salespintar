    let campaignName = campaignNameHint;
    let status = 'UNKNOWN';
    let objective = 'UNKNOWN';
    let campaignDailyBudget: number | null = null;
    let campaignBidStrategy: string | null = null;

    let todaySpend = 0, todayClicks = 0, todayImpressions = 0, todayCtr = 0, todayFrequency = 0;
    let sumSpend7d = 0, sumClicks7d = 0, sumImpressions7d = 0;
    const ctr7dList: number[] = [];
    const freq7dList: number[] = [];
    let todayActions: { action_type: string; value: string }[] = [];
    let todayCostPerAction: { action_type: string; value: string }[] = [];
    let todayPurchaseRoas: { action_type: string; value: string }[] = [];
    let aggActions: { action_type: string; value: string }[] = [];
    let aggCostPerAction: { action_type: string; value: string }[] = [];
    let aggPurchaseRoas: { action_type: string; value: string }[] = [];
    let foundInsights = false;
    const warnings: string[] = [];

    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) continue;
      try {
        const query = new URLSearchParams({
          fields: 'spend,clicks,ctr,frequency,impressions,campaign_name,actions,cost_per_action_type,purchase_roas',
          time_range: JSON.stringify({ since: sinceStr, until: todayStr }),
          time_increment: '1',
          access_token: token,
        });
        const insResp = await fetch(`https://graph.facebook.com/v21.0/${campaignId}/insights?${query}`);
        if (!insResp.ok) continue;
        const insData: any = await insResp.json();
        const rows = insData.data || [];
        if (rows.length === 0) continue;
        foundInsights = true;
        for (const row of rows) {
          const spend = parseFloat(row.spend || '0');
          const clicks = parseInt(row.clicks || '0', 10);
          const impressions = parseInt(row.impressions || '0', 10);
          const ctr = parseFloat(row.ctr || '0');
          const frequency = parseFloat(row.frequency || '0');
          if (row.campaign_name) campaignName = row.campaign_name;
          sumSpend7d += spend;
          sumClicks7d += clicks;
          sumImpressions7d += impressions;
          ctr7dList.push(ctr);
          freq7dList.push(frequency);
          if (row.date_start === todayStr) {
            todaySpend = spend; todayClicks = clicks; todayImpressions = impressions;
            todayCtr = ctr; todayFrequency = frequency;
            todayActions = Array.isArray(row.actions) ? row.actions : [];
            todayCostPerAction = Array.isArray(row.cost_per_action_type) ? row.cost_per_action_type : [];
            todayPurchaseRoas = Array.isArray(row.purchase_roas) ? row.purchase_roas : [];
          }
        }
        try {
          const aggQuery = new URLSearchParams({
            fields: 'spend,actions,cost_per_action_type,purchase_roas',
            time_range: JSON.stringify({ since: sinceStr, until: todayStr }),
            access_token: token,
          });
          const aggResp = await fetch(`https://graph.facebook.com/v21.0/${campaignId}/insights?${aggQuery}`);
          if (aggResp.ok) {
            const aggData: any = await aggResp.json();
            const aggRow = (aggData.data || [])[0];
            if (aggRow) {
              aggActions = Array.isArray(aggRow.actions) ? aggRow.actions : [];
              aggCostPerAction = Array.isArray(aggRow.cost_per_action_type) ? aggRow.cost_per_action_type : [];
              aggPurchaseRoas = Array.isArray(aggRow.purchase_roas) ? aggRow.purchase_roas : [];
            }
          }
        } catch (aggErr) {
          warnings.push(`Gagal fetch aggregate insight 7 hari: ${aggErr instanceof Error ? aggErr.message : String(aggErr)}`);
        }
        break;
      } catch (err) {
        warnings.push(`Gagal fetch insight Meta: ${err instanceof Error ? err.message : String(err)}`);
      }
    }
    if (!foundInsights) {
      warnings.push('Tidak ada data insight Meta ditemukan untuk campaign ini pada 7 hari terakhir.');
    }

    let budgetLevel: 'CBO' | 'ABO' | 'UNKNOWN' = 'UNKNOWN';
    let activeAdsets: any[] = [];
    let budgetFactsOptimizationGoal: string | undefined;
    let budgetFactsCustomEventType: string | undefined;
    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) continue;
      try {
        const campResp = await fetch(`https://graph.facebook.com/v21.0/${campaignId}?fields=name,effective_status,daily_budget,lifetime_budget,objective,bid_strategy&access_token=${token}`);
        if (campResp.ok) {
          const campData: any = await campResp.json();
          if (campData.name) campaignName = campData.name;
          if (campData.effective_status) status = campData.effective_status;
          if (campData.objective) objective = campData.objective;
          if (campData.bid_strategy) campaignBidStrategy = campData.bid_strategy;
          if (campData.daily_budget || campData.lifetime_budget) {
            budgetLevel = 'CBO';
            campaignDailyBudget = campData.daily_budget ? parseFloat(campData.daily_budget) : null;
          }
        }
        const adsetResp = await fetch(`https://graph.facebook.com/v21.0/${campaignId}/adsets?fields=name,effective_status,daily_budget,lifetime_budget,bid_strategy,optimization_goal,promoted_object&limit=50&access_token=${token}`);
        if (adsetResp.ok) {
          const adsetData: any = await adsetResp.json();
          const allFetchedAdsets = (adsetData?.data) || [];
          activeAdsets = allFetchedAdsets.filter((a: any) => a.effective_status === 'ACTIVE');
          // [2026-08-26] Ground truth optimization_goal/custom_event_type (Opsi 2) -- mixed-detection:
          // kalau semua ad set sepakat pakai nilai yang sama, pakai itu; kalau ada yg beda, undefined
          // (ambigu, biar resolver jatuh ke heuristik objective lama, bukan nebak).
          let firstSeen = true;
          for (const as of allFetchedAdsets) {
            const og = (as as any).optimization_goal as string | undefined;
            const cet = (as as any).promoted_object?.custom_event_type as string | undefined;
            if (firstSeen) {
              budgetFactsOptimizationGoal = og;
              budgetFactsCustomEventType = cet;
              firstSeen = false;
            } else if (budgetFactsOptimizationGoal !== og || budgetFactsCustomEventType !== cet) {
              budgetFactsOptimizationGoal = undefined;
              budgetFactsCustomEventType = undefined;
            }
          }
        }
        if (campResp.ok) break;
      } catch (err) {
        warnings.push(`Gagal fetch status/budget/bid strategy: ${err instanceof Error ? err.message : String(err)}`);
      }
    }
    if (budgetLevel !== 'CBO' && activeAdsets.length > 0) {
      budgetLevel = 'ABO';
    }

    let currentDailyBudget: number | null = null;
    let targetObjectId: string | null = null;
    let targetLevel: 'CAMPAIGN' | 'ADSET' | null = null;
    let editableBudget = false;
    let editableReason = '';
    if (budgetLevel === 'CBO') {
      currentDailyBudget = campaignDailyBudget;
      targetObjectId = campaignId;
      targetLevel = 'CAMPAIGN';
      editableBudget = status === 'ACTIVE' && currentDailyBudget != null;
      editableReason = editableBudget ? '' : 'Campaign tidak aktif atau budget harian tidak terbaca.';
    } else if (budgetLevel === 'ABO') {
      const sumAdsetBudget = activeAdsets.reduce((s, a) => s + (a.daily_budget ? parseFloat(a.daily_budget) : 0), 0);
      currentDailyBudget = sumAdsetBudget > 0 ? sumAdsetBudget : null;
      if (activeAdsets.length === 1) {
        targetObjectId = activeAdsets[0].id;
        targetLevel = 'ADSET';
        editableBudget = status === 'ACTIVE';
        editableReason = editableBudget ? '' : 'Campaign tidak aktif.';
      } else {
        editableBudget = false;
        editableReason = `Campaign ini pakai ABO (budget per ad set) dengan ${activeAdsets.length} ad set aktif -- edit budget lewat sini belum didukung utk kasus ini, silakan atur manual per ad set di Ads Manager.`;
      }
    } else {
      editableReason = 'Level budget (CBO/ABO) tidak terbaca dari Meta.';
    }

    const bidStrategyRaw = campaignBidStrategy || activeAdsets.find((a) => a.bid_strategy)?.bid_strategy || null;
    const bidStrategyLabelMap: Record<string, string> = {
      LOWEST_COST_WITHOUT_CAP: 'Otomatis (Lowest Cost)',
      LOWEST_COST_WITH_BID_CAP: 'Manual (Bid Cap)',
      COST_CAP: 'Otomatis dgn Batas Biaya (Cost Cap)',
      LOWEST_COST_WITH_MIN_ROAS: 'Otomatis dgn Target ROAS Minimum',
    };
    const bidStrategyLabel = bidStrategyRaw ? (bidStrategyLabelMap[bidStrategyRaw] || bidStrategyRaw) : 'Tidak diketahui';

    // [2026-08-26] Ground-truth resolver (Opsi 1+2+3) -- konsolidasi, ganti heuristik lokal
    // (predicate cascade lama sudah dipindah SATU implementasi ke meta-result-resolver.service.ts,
    // semantik dipertahankan persis, plus ground truth optimization_goal/custom_event_type kalau ada).
    const { matchedType, source: resultSource } = resolveMatchedType({
      objective,
      actions: aggActions,
      costPerActionType: aggCostPerAction,
      spend: sumSpend7d,
      optimizationGoal: budgetFactsOptimizationGoal,
      customEventType: budgetFactsCustomEventType,
      campaignId,
      campaignName
    });
    const { resultLabel, badgeLabel } = getResultLabels(matchedType);
    const { resultValue: todayResult, cprValue: todayCprMeta } = computeResultValue(matchedType, todayActions, todayCostPerAction, todaySpend);
    const todayCpr = todayCprMeta > 0 ? todayCprMeta : (todayResult > 0 ? todaySpend / todayResult : 0);
    const { resultValue: sumResult7d, cprValue: avgCprMeta } = computeResultValue(matchedType, aggActions, aggCostPerAction, sumSpend7d);
    const avgCpr7d = avgCprMeta > 0 ? avgCprMeta : (sumResult7d > 0 ? sumSpend7d / sumResult7d : 0);

    // [2026-08-26] ROAS SEBELUMNYA pakai Meta-native `purchase_roas` (dari pixel di halaman form/LP).
    // Bossfren koreksi: funnel bisnis ini iklan -> LP -> isi form -> REDIRECT ke WA -> closing manual
    // oleh CS (belum tentu closing!) -- jadi pixel "Purchase" yang nembak pas form submit itu TIDAK
    // valid sebagai transaksi beneran, cuma nandain form ke-isi. Yang valid cuma closing yang
    // dikonfirmasi CS lewat WA (confirmedCodAmount + capiEventsSent includes 'Purchase', linked ke
    // meta_campaign_id campaign ini) -- SAMA PERSIS definisi omset yang dipakai di
    // GET /meta-ads-performance (omsetByCampaign). Kalau CAPI dataset di Pengaturan SalesPintar belum
    // disambungkan (leads belum ke-link ke campaign manapun), ini akan 0 -- itu memang benar dan harus
    // di-skip (hasRoas=false), BUKAN fallback ke angka pixel yang gak valid.
    const todayLeadDateFilter = getWibDateRange(todayStr, todayStr);
    const last7LeadDateFilter = getWibDateRange(sinceStr, todayStr);
    const sumCsOmset = (rows: { confirmedCodAmount: number | null; capiEventsSent: string[] }[]) =>
      rows.reduce((sum, l) => {
        const isCapiPurchase = Array.isArray(l.capiEventsSent) && l.capiEventsSent.includes('Purchase');
        return sum + (isCapiPurchase ? (Number(l.confirmedCodAmount) || 0) : 0);
      }, 0);
    const [todayCsLeads, last7CsLeads] = await Promise.all([
      prisma.lead.findMany({
        where: { businessId, metaCampaignId: campaignId, ...(todayLeadDateFilter ? { createdAt: todayLeadDateFilter } : {}) },
        select: { confirmedCodAmount: true, capiEventsSent: true },
      }),
      prisma.lead.findMany({
        where: { businessId, metaCampaignId: campaignId, ...(last7LeadDateFilter ? { createdAt: last7LeadDateFilter } : {}) },
        select: { confirmedCodAmount: true, capiEventsSent: true },
      }),
    ]);
    const todayCsOmset = sumCsOmset(todayCsLeads);
    const sumCsOmset7d = sumCsOmset(last7CsLeads);
    const todayRoasCs = todaySpend > 0 ? todayCsOmset / todaySpend : 0;
    const avgRoasCs = sumSpend7d > 0 ? sumCsOmset7d / sumSpend7d : 0;
    const hasRoas = avgRoasCs > 0 || todayRoasCs > 0;

    const avgCtr7d = ctr7dList.length > 0 ? ctr7dList.reduce((a, b) => a + b, 0) / ctr7dList.length : 0;
    const avgFreq7d = freq7dList.length > 0 ? freq7dList.reduce((a, b) => a + b, 0) / freq7dList.length : 0;
    const n = last7.length || 1;

    const cprDeltaPct = avgCpr7d > 0 ? ((todayCpr - avgCpr7d) / avgCpr7d) * 100 : null;
    const ctrDeltaPct = avgCtr7d > 0 ? ((todayCtr - avgCtr7d) / avgCtr7d) * 100 : null;
    const frequencyFlag = todayFrequency > 2.5;
    const weeklyConversions = sumResult7d;

    const rp = (v: number) => `Rp${Math.round(v).toLocaleString('id-ID')}`;
    let verdict: string;
    let verdictReason: string;
    let suggestedDailyBudget: number | null = null;

    if (!foundInsights || (todaySpend <= 0 && todayImpressions <= 0)) {
      verdict = 'BELUM_CUKUP_DATA';
      verdictReason = 'Belum ada aktivitas iklan (spend/impresi) dari Meta hari ini, tunggu data lebih banyak sebelum bikin keputusan budget.';
    } else if (cprDeltaPct !== null && cprDeltaPct >= 200 && todayClicks >= 20) {
      verdict = 'PERTIMBANGKAN_STOP';
      verdictReason = `CPR (${badgeLabel}) hari ini ${rp(todayCpr)}, lebih dari 3x lipat rata-rata 7 hari (${rp(avgCpr7d)}), dengan ${todayClicks} klik hari ini (data cukup).`;
    } else if (todayResult === 0 && todayClicks >= 50) {
      verdict = 'PERTIMBANGKAN_STOP';
      verdictReason = `Sudah ${todayClicks} klik hari ini tapi belum ada Result (${resultLabel}) sama sekali.`;
      suggestedDailyBudget = 0;
    } else if (hasRoas && avgRoasCs > 0 && todayRoasCs > 0 && todayRoasCs < avgRoasCs * 0.5) {
      verdict = 'TURUNKAN_BUDGET';
      verdictReason = `ROAS hari ini ${todayRoasCs.toFixed(2)}x, kurang dari separuh rata-rata 7 hari (${avgRoasCs.toFixed(2)}x).`;
      suggestedDailyBudget = currentDailyBudget != null ? Math.round(currentDailyBudget * 0.5) : null;
    } else if (weeklyConversions < 50) {
      verdict = 'PANTAU';
      verdictReason = `Konversi 7 hari terakhir baru ${Math.round(weeklyConversions)} (Result: ${resultLabel}) -- di bawah ambang 50/minggu buat penilaian scale yang solid, pantau dulu.`;
    } else if (cprDeltaPct !== null && cprDeltaPct <= -15 && !frequencyFlag && (ctrDeltaPct === null || ctrDeltaPct >= -15) && (!hasRoas || todayRoasCs >= avgRoasCs)) {
      verdict = 'SCALE_UP';
      verdictReason = `CPR (${badgeLabel}) hari ini ${rp(todayCpr)}, ${Math.abs(cprDeltaPct).toFixed(0)}% lebih murah dari rata-rata 7 hari (${rp(avgCpr7d)}), konversi 7 hari ${Math.round(weeklyConversions)} (>=50), CTR stabil, tanpa sinyal fatigue.`;
      suggestedDailyBudget = currentDailyBudget != null ? Math.round(currentDailyBudget * 1.2) : null;
    } else if (cprDeltaPct !== null && cprDeltaPct > 15) {
      verdict = 'PERHATIAN';
      verdictReason = `CPR (${badgeLabel}) hari ini ${rp(todayCpr)}, ${cprDeltaPct.toFixed(0)}% lebih mahal dari rata-rata 7 hari (${rp(avgCpr7d)}) -- pantau dulu sebelum scale, jangan buru-buru naikin budget.`;
    } else {
      verdict = 'MAINTAIN';
      verdictReason = `CPR (${badgeLabel}) hari ini ${rp(todayCpr)}, masih sepadan dengan rata-rata 7 hari (${rp(avgCpr7d)}).`;
    }

    const payload = {
      campaignId,
      campaignName,
      status,
      objective,
      budgetLevel,
      targetObjectId,
      targetLevel,
      currentDailyBudget,
      matchedType,
      resultSource,
      bidStrategy: { raw: bidStrategyRaw, label: bidStrategyLabel },
      editableBudget,
      editableReason,
      today: { date: todayStr, spend: todaySpend, clicks: todayClicks, impressions: todayImpressions, ctr: todayCtr, frequency: todayFrequency, cpr: todayCpr, result: todayResult, resultLabel, badgeLabel },
      avg7d: { spend: sumSpend7d / n, clicks: Math.round(sumClicks7d / n), impressions: Math.round(sumImpressions7d / n), ctr: avgCtr7d, frequency: avgFreq7d, cpr: avgCpr7d, result: sumResult7d / n, weeklyConversions, resultLabel, badgeLabel },
      roas: hasRoas ? { today: todayRoasCs, avg7d: avgRoasCs } : null,
      cprDeltaPct,
      ctrDeltaPct,
      frequencyFlag,
      verdict,
      verdictReason,
      suggestedDailyBudget,
      fetchedAt: new Date().toISOString(),
      warnings,
    };
    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 20 * 60).catch(() => {});
    res.json(payload);
  } catch (e) { next(e); }
});

// [2026-08-27] Stage B -- edit manual budget harian (independen dari rekomendasi AI).
// Bossfren approve: SEMUA PIC boleh pakai (gak dibatasi role tertentu), makanya authorize('ADMIN')
// dipakai persis sama seperti GET /budget-facts (di sistem ini semua user business = role ADMIN,
// jadi authorize('ADMIN') efektifnya "siapapun yang login ke business ini").
//
// PENTING: targetObjectId/targetLevel TIDAK PERNAH dipercaya dari client -- selalu dideteksi ulang
// di sini (CBO vs ABO, campaign aktif atau tidak) persis logic yang sama dgn /budget-facts, supaya
// client yang bug/nakal gak bisa nyuruh nge-update objek Meta yang salah.
router.patch('/campaigns/:campaignId/budget', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId, userId } = req.user!;
    const campaignId = String(req.params.campaignId || '');
    const rawNewBudget = req.body?.newDailyBudget;
    const newDailyBudget = typeof rawNewBudget === 'number' ? rawNewBudget : parseFloat(rawNewBudget);

    if (!campaignId) {
      res.status(400).json({ error: { message: 'campaignId wajib diisi.' } });
      return;
    }
    if (!Number.isFinite(newDailyBudget) || newDailyBudget < 1000) {
      res.status(400).json({ error: { message: 'Budget harian baru tidak valid (minimal Rp1.000).' } });
      return;
    }

    const { redisCache } = await import('../config/redis');
    const bms = await prisma.metaBusinessManager.findMany({ where: { businessId, isActive: true, tokenStatus: 'ACTIVE' } });

    let status = 'UNKNOWN';
    let campaignDailyBudget: number | null = null;
    let budgetLevel: 'CBO' | 'ABO' | 'UNKNOWN' = 'UNKNOWN';
    let activeAdsets: any[] = [];
    let workingToken: string | null = null;

    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) continue;
      try {
        const campResp = await fetch(`https://graph.facebook.com/v21.0/${campaignId}?fields=effective_status,daily_budget,lifetime_budget&access_token=${token}`);
        if (!campResp.ok) continue;
        const campData: any = await campResp.json();
        if (campData.effective_status) status = campData.effective_status;
        if (campData.daily_budget || campData.lifetime_budget) {
          budgetLevel = 'CBO';
          campaignDailyBudget = campData.daily_budget ? parseFloat(campData.daily_budget) : null;
        }
        const adsetResp = await fetch(`https://graph.facebook.com/v21.0/${campaignId}/adsets?fields=daily_budget,lifetime_budget,effective_status&limit=50&access_token=${token}`);
        if (adsetResp.ok) {
          const adsetData: any = await adsetResp.json();
          activeAdsets = ((adsetData?.data) || []).filter((a: any) => a.effective_status === 'ACTIVE');
        }
        workingToken = token;
        break;
      } catch (err) {
        // Token BM ini gagal (mungkin gak punya akses ke campaign ini) -- coba BM berikutnya.
      }
    }

    if (!workingToken) {
      res.status(502).json({ error: { message: 'Gagal menghubungi Meta -- tidak ada token Business Manager yang punya akses ke campaign ini.' } });
      return;
    }

    if (budgetLevel !== 'CBO' && activeAdsets.length > 0) {
      budgetLevel = 'ABO';
    }

    let targetObjectId: string | null = null;
    let targetLevel: 'CAMPAIGN' | 'ADSET' | null = null;
    let editableBudget = false;
    let editableReason = '';
    let currentDailyBudget: number | null = null;

    if (budgetLevel === 'CBO') {
      currentDailyBudget = campaignDailyBudget;
      targetObjectId = campaignId;
      targetLevel = 'CAMPAIGN';
      editableBudget = status === 'ACTIVE' && currentDailyBudget != null;
      editableReason = editableBudget ? '' : 'Campaign tidak aktif atau budget harian tidak terbaca.';
    } else if (budgetLevel === 'ABO') {
      const sumAdsetBudget = activeAdsets.reduce((s, a) => s + (a.daily_budget ? parseFloat(a.daily_budget) : 0), 0);
      currentDailyBudget = sumAdsetBudget > 0 ? sumAdsetBudget : null;
      if (activeAdsets.length === 1) {
        targetObjectId = activeAdsets[0].id;
        targetLevel = 'ADSET';
        editableBudget = status === 'ACTIVE';
        editableReason = editableBudget ? '' : 'Campaign tidak aktif.';
      } else {
        editableBudget = false;
        editableReason = `Campaign ini pakai ABO (budget per ad set) dengan ${activeAdsets.length} ad set aktif -- edit budget lewat sini belum didukung utk kasus ini, silakan atur manual per ad set di Ads Manager.`;
      }
    } else {
      editableReason = 'Level budget (CBO/ABO) tidak terbaca dari Meta.';
    }

    if (!editableBudget || !targetObjectId || !targetLevel) {
      res.status(409).json({ error: { message: editableReason || 'Budget campaign ini tidak bisa diedit lewat sini.' } });
      return;
    }

    const roundedBudget = Math.round(newDailyBudget);
    const updateParams = new URLSearchParams({ daily_budget: String(roundedBudget), access_token: workingToken });
    let metaSuccess = false;
    let metaResponseBody: any = null;
    let metaErrorMessage: string | null = null;

    try {
      const updateResp = await fetch(`https://graph.facebook.com/v21.0/${targetObjectId}?${updateParams.toString()}`, { method: 'POST' });
      metaResponseBody = await updateResp.json().catch(() => null);
      metaSuccess = updateResp.ok && metaResponseBody?.success !== false;
      if (!metaSuccess) {
        metaErrorMessage = metaResponseBody?.error?.message || `Meta menolak update (HTTP ${updateResp.status}).`;
      }
    } catch (err) {
      metaErrorMessage = err instanceof Error ? err.message : String(err);
      metaResponseBody = { error: metaErrorMessage };
    }

    // Audit log SELALU disimpan, sukses maupun gagal -- ini jalur PERTAMA di dashboard yg nyentuh
    // duit sungguhan, jejaknya wajib ada siapapun hasilnya.
    await prisma.aiAdsBudgetActionLog.create({
      data: {
        businessId,
        campaignId,
        targetObjectId,
        targetLevel,
        oldDailyBudget: currentDailyBudget != null ? currentDailyBudget : undefined,
        newDailyBudget: roundedBudget,
        source: 'manual',
        triggeredByUserId: userId,
        metaSuccess,
        metaResponse: metaResponseBody,
      },
    }).catch((logErr: unknown) => {
      logger.error(`[BudgetEdit] Gagal simpan audit log: ${logErr instanceof Error ? logErr.message : String(logErr)}`);
    });

    await redisCache.del(`salespintar:budget-facts:${businessId}:${campaignId}`).catch(() => {});
    // [2026-08-27] Fix bug: tabel campaign dashboard (endpoint /meta-performance, cache 20 menit)
    // gak ikut ke-invalidate di atas -- budget baru gak kelihatan di tabel sampai cache expire atau
    // user pencet Refresh manual (forceRefresh=true). Sekarang disapu juga tiap kombinasi date-range.
    const { delCachePattern } = await import('../config/redis');
    await delCachePattern(redisCache, `salespintar:meta-perf:${businessId}:*`).catch(() => 0);

    if (!metaSuccess) {
      res.status(502).json({ error: { message: `Meta gagal update budget: ${metaErrorMessage}` } });
      return;
    }

    res.json({ success: true, newDailyBudget: roundedBudget, targetLevel });
  } catch (e) { next(e); }
});

export default router;
