// ── Fase 51 (2026-08-22): Multi-BM System User Token Registry ────────────────────
// Mendaftarkan banyak Meta Business Manager (BM) dengan System User Token.
// Token selalu dienkripsi AES-256-GCM sebelum disimpan (sama dengan MetaPixelConfig).
// API TIDAK PERNAH mengembalikan token mentah — hanya tokenPreview (EAAbc1••••).

const META_GRAPH_BASE = 'https://graph.facebook.com/v21.0';

async function validateMetaToken(token: string): Promise<{ valid: boolean; metaBusinessId?: string; error?: string }> {
  try {
    const url = `${META_GRAPH_BASE}/me?fields=id,name&access_token=${encodeURIComponent(token)}`;
    const res = await fetch(url);
    const data = await res.json() as any;
    if (data.error) {
      return { valid: false, error: data.error.message ?? 'Token tidak valid' };
    }
    // Ambil Business ID dari token level BM
    const bizRes = await fetch(`${META_GRAPH_BASE}/me/businesses?fields=id,name&access_token=${encodeURIComponent(token)}`);
    const bizData = await bizRes.json() as any;
    const metaBusinessId: string | undefined = bizData?.data?.[0]?.id;
    return { valid: true, metaBusinessId };
  } catch (e: any) {
    return { valid: false, error: e?.message ?? 'Gagal menghubungi Meta Graph API' };
  }
}

