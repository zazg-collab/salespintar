// AI Media Buyer Automation — default & toggle per BM (redesign UX Fase 3,
// hasil brainstorming 2026-08-24)
// ============================================================================
// Layer "umum": tiap BM bisa mengaktifkan Threshold Shift / Spend Anomaly /
// Landing Page Check untuk SEMUA campaign di akun-akun iklan BM ini, dengan
// satu set nilai default -- diaktifkan & diisi langsung di modal "Kelola Aset
// BM" ini (bukan di tab Pengaturan). Kalau ada campaign yang butuh angka beda
// dari default, override diatur terpisah di /ai-ads/settings (Threshold
// Shift) & /ai-ads/spend-anomaly-settings (Spend Anomaly), keduanya di-scope
// per bmId yang sama (lihat ai-ads.routes.ts). Landing Page TIDAK ada
// override per-campaign -- daftar URL-nya murni global (/ai-ads/landing-pages),
// campaign yang dipause ditentukan otomatis lewat pencocokan destination URL
// saat down (menyusul di Fase 3 Langkah 2, sama seperti wiring run_shift.py).
//
// Disimpan di Business.settings.bmAutomationDefaults, keyed by
// MetaBusinessManager.id -- BUKAN migration baru, pola sama seperti
// aiAdsShiftTargets di ai-ads.routes.ts.

const morningEarlyKillSchema = z.object({
  costThreshold: z.number().positive(),
  cpcKillMultiplier: z.number().positive(),
});
const middayPacingSchema = z.object({
  dailyBudget: z.number().positive(),
  dailyLeadsTarget: z.number().nonnegative(),
  spendPaceThreshold: z.number().min(0).max(1),
  leadsPaceThreshold: z.number().min(0).max(1),
  reducePct: z.number().min(0).max(1),
});
const goldenHourScalingSchema = z.object({
  roasTarget: z.number().positive(),
  scalePct: z.number().min(0).max(1),
  maxDailyBudgetCeiling: z.number().positive(),
});

const bmAutomationDefaultsPayloadSchema = z.object({
  thresholdShift: z.object({
    enabled: z.boolean().default(false),
    default: z.object({
      morningEarlyKill: morningEarlyKillSchema,
      middayPacing: middayPacingSchema,
      goldenHourScaling: goldenHourScalingSchema,
    }),
  }),
  spendAnomaly: z.object({
    enabled: z.boolean().default(false),
    default: z.object({
      spendIncreasePctThreshold: z.number().positive().max(1000).default(50),
    }),
  }),
  landingPageCheck: z.object({
    enabled: z.boolean().default(false),
    autoPauseOnDown: z.boolean().default(false),
    timeoutSeconds: z.number().int().positive().max(60).default(10),
  }),
});

