    }
    const campaignNameHint = String(req.query.campaignName || campaignId);
    const forceRefresh = req.query.forceRefresh === 'true';
    const cacheKey = `salespintar:budget-facts:${businessId}:${campaignId}`;
    const { redisCache } = await import('../config/redis');
