router.post('/meta-bms', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { name, picName, accessToken, metaBusinessId: manualBizId } = req.body;
    if (!name?.trim()) throw new ValidationError('Nama / Label BM wajib diisi');
    if (!picName?.trim()) throw new ValidationError('Nama PIC Marketing wajib diisi');
