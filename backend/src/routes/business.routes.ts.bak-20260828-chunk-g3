/**
 * Batas panjang nama toko.
 */
const MAKS_NAMA = 60;

// ── GET /business ─────────────────────────────────────────────────────────────
router.get('/', async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const b = await prisma.business.findUnique({
      where: { id: businessId },
      select: { id: true, name: true, mengantarApiKey: true, updatedAt: true },
    });
    if (!b) throw new ValidationError('Bisnis tidak ditemukan');
    const jedaHl = await getHlJedaStatus(businessId);
    const jedaCrm = await getCrmJedaStatus(businessId);
    res.json({ ...b, maksNama: MAKS_NAMA, ...jedaHl, ...jedaCrm });
  } catch (e) { next(e); }
});

// ── PATCH /business ───────────────────────────────────────────────────────────
router.patch('/', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const body = req.body ?? {};
    const mentah = body.name;
    const mengantarApiKey = body.mengantarApiKey;

    const dataToUpdate: any = {};

    if (mentah !== undefined) {
      if (typeof mentah !== 'string') throw new ValidationError('Nama toko wajib teks');
      const nama = mentah.trim().replace(/\s+/g, ' ');
      if (nama.length === 0) throw new ValidationError('Nama toko tidak boleh kosong');
      if (nama.length > MAKS_NAMA) {
        throw new ValidationError(`Nama toko maksimal ${MAKS_NAMA} karakter (sekarang ${nama.length})`);
      }
      if (/[\r\n]/.test(mentah)) throw new ValidationError('Nama toko tidak boleh memuat baris baru');
      dataToUpdate.name = nama;
    }

    if (mengantarApiKey !== undefined) {
      dataToUpdate.mengantarApiKey = typeof mengantarApiKey === 'string' ? mengantarApiKey.trim() : null;
    }

    if (Object.keys(dataToUpdate).length === 0) {
      res.json({ message: 'Tidak ada perubahan data' });
      return;
    }

    const b = await prisma.business.update({
      where: { id: businessId },
      data: dataToUpdate,
      select: { id: true, name: true, mengantarApiKey: true, updatedAt: true },
    });

    logger.info(`[Business] Pengaturan toko diperbarui (business ${businessId})`);
    res.json({ ...b, message: 'Pengaturan berhasil disimpan.' });
  } catch (e) { next(e); }
});

// ── POST /business/mengantar-test ─────────────────────────────────────────────
router.post('/mengantar-test', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    let apiKey = (req.body ?? {}).apiKey;

    if (!apiKey) {
      const b = await prisma.business.findUnique({
        where: { id: businessId },
        select: { mengantarApiKey: true },
      });
      apiKey = b?.mengantarApiKey;
    }

    if (!apiKey || typeof apiKey !== 'string' || apiKey.trim().length === 0) {
      throw new ValidationError('API Key Mengantar belum diisi');
    }

    const testRes = await MengantarService.testConnection(apiKey.trim());
    res.json(testRes);
  } catch (e) { next(e); }
});

/**
 * PATCH /business/human-learning-jeda — jeda atau lanjutkan Auto-Learning (Pilar 2).
 *
 * Body:
 *   { aksi: 'jeda', mode: 'permanen' }          — jeda permanen (bebas on/off)
 *   { aksi: 'jeda', mode: 'durasi', jam: number } — jeda `jam` jam ke depan (1–24)
 *   { aksi: 'lanjut' }                          — aktifkan kembali sekarang juga
 */
router.patch(
  '/human-learning-jeda',
  authorize('ADMIN'),
  async (req: Request, res: Response, next: NextFunction) => {
    try {
      const { businessId } = req.user!;
      const aksi = (req.body ?? {}).aksi;
      const mode = (req.body ?? {}).mode;

      if (aksi === 'lanjut') {
        await setHlJeda(businessId, false, null);
        logger.info(`[HL] Jeda Auto-Learning dibatalkan (business ${businessId})`);
        res.json({
          humanLearningPaused: false,
          humanLearningPausedUntil: null,
          message: 'Knowledge Base Auto-Learning diaktifkan kembali.',
        });
        return;
      }

      if (aksi === 'jeda') {
        if (mode === 'permanen' || req.body?.jam === 'permanen') {
          await setHlJeda(businessId, true, null);
          res.json({
            humanLearningPaused: true,
            humanLearningPausedUntil: null,
            message: 'Knowledge Base Auto-Learning dijeda permanen (bisa diaktifkan kapan saja).',
          });
          return;
        }

        const jamMentah = (req.body ?? {}).jam;
        const jam = Number(jamMentah);
        if (!Number.isFinite(jam) || !Number.isInteger(jam) || jam < 1 || jam > 24) {
          throw new ValidationError('Durasi jeda wajib bilangan bulat 1–24 jam');
        }
        const sampai = new Date(Date.now() + jam * 60 * 60 * 1000).toISOString();
        await setHlJeda(businessId, true, sampai);
        res.json({
          humanLearningPaused: true,
          humanLearningPausedUntil: sampai,
          message: `Knowledge Base Auto-Learning dijeda selama ${jam} jam.`,
        });
        return;
      }

      throw new ValidationError('aksi wajib "jeda" atau "lanjut"');
    } catch (e) { next(e); }
  },
);

