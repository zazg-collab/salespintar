// GET /business/meta-ad-fatigue — "Top Ad Fatigue" (Layer 1, Fase 4+) ─────────────────────────
// [2026-08-26] Tombol kedua di kartu "Top Creatives", rumus diadaptasi dari OpenAdKit lokal
// `lib/prompts/ad-fatigue.ts` (MIT). SEMUA perhitungan decay%/skor-sinyal/severity di sini MURNI
// matematika Node (Layer 1) -- NOL panggilan agy -- supaya angka yang tampil di grid card SELALU
// konsisten & tidak tergantung availability/latency LLM. Layer 2 (refresh_options/new_angles/
// kill_threshold, yang butuh bahasa) ada di POST /ai-ads/fatigue-insight, dipicu terpisah dari
// popup detail. Beda dari /meta-top-creatives (snapshot 1 window): endpoint ini pakai
// `time_increment: 7` supaya 1 panggilan insights balikin beberapa bucket mingguan sekaligus,
// bucket PERTAMA = "week 1" dan bucket TERAKHIR = "latest week" dipakai utk hitung decay
// week-over-week persis rumus OpenAdKit PHASE 1. Kalau rentang tanggal < 14 hari cuma dapat 1
// bucket -- decay ditandai "tidak bisa dihitung" (JANGAN dikarang), severity tetap dinilai dari
// frequency + creative_lifespan yang tidak butuh perbandingan minggu.
router.get('/meta-ad-fatigue', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const startDate = (req.query.startDate as string) || new Date(Date.now() - 21 * 86400000).toISOString().split('T')[0];
    const endDate = (req.query.endDate as string) || new Date().toISOString().split('T')[0];
    const limit = parseInt(req.query.limit as string) || 10;

    const cacheKey = `salespintar:meta-ad-fatigue:${businessId}:${startDate}:${endDate}:${limit}`;
    const { redisCache } = await import('../config/redis');
    const forceRefresh = req.query.forceRefresh === 'true';
    const cached = await redisCache.get(cacheKey).catch(() => null);
    if (cached && !forceRefresh) {
      return res.json(JSON.parse(cached));
    }

    const bms = await prisma.metaBusinessManager.findMany({
      where: { businessId, isActive: true, tokenStatus: 'ACTIVE' }
    });

    // Kumpulkan bucket mingguan per ad_id: Map<adId, { meta: {...}, buckets: [...] }>
    const adBucketsMap = new Map<string, { meta: any; buckets: any[]; token: string }>();
    const uniqueAdAccounts = new Set<string>();

    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) continue;
      try {
        const adAccResp = await fetch(`https://graph.facebook.com/v21.0/me/adaccounts?fields=id&access_token=${token}`);
        if (!adAccResp.ok) continue;
        const adAccounts = ((await adAccResp.json()) as any).data || [];

        await Promise.allSettled(adAccounts.map(async (act: any) => {
          const actId = act.id;
          if (uniqueAdAccounts.has(actId)) return;
          uniqueAdAccounts.add(actId);

          const query = new URLSearchParams({
            level: 'ad',
            fields: 'ad_id,ad_name,campaign_name,spend,ctr,clicks,impressions,frequency,cpm,quality_ranking,engagement_rate_ranking,conversion_rate_ranking',
            time_range: JSON.stringify({ since: startDate, until: endDate }),
            time_increment: '7',
            access_token: token
          });
          const insResp = await fetch(`https://graph.facebook.com/v21.0/${actId}/insights?${query}`);
          if (insResp.ok) {
            const rows = ((await insResp.json()) as any).data || [];
            for (const row of rows) {
              const adId = row.ad_id;
              if (!adId) continue;
              if (!adBucketsMap.has(adId)) {
                adBucketsMap.set(adId, {
                  meta: {
                    adId,
                    adName: row.ad_name,
                    campaignName: row.campaign_name,
                    qualityRanking: row.quality_ranking || 'UNKNOWN',
                    engagementRanking: row.engagement_rate_ranking || 'UNKNOWN',
                    conversionRanking: row.conversion_rate_ranking || 'UNKNOWN',
                  },
                  buckets: [],
                  token,
                });
              }
              adBucketsMap.get(adId)!.buckets.push({
                dateStart: row.date_start,
                impressions: parseInt(row.impressions || '0', 10),
                clicks: parseInt(row.clicks || '0', 10),
                spend: parseFloat(row.spend || '0'),
                ctr: parseFloat(row.ctr || '0'),
                frequency: parseFloat(row.frequency || '0'),
                cpm: parseFloat(row.cpm || '0'),
              });
            }
          }
        }));
      } catch (err) {}
    }

    // ── Layer 1: hitung decay%, skor sinyal, severity -- murni matematika, RETIRE_THRESHOLD_RULE
    // (OpenAdKit common-rules.ts): min 1000 impresi ATAU 50 klik kumulatif sebelum dinilai, supaya
    // noise statistik ad baru tidak keliru dibaca sebagai fatigue.
    const pctChange = (from: number, to: number): number | null => {
      if (!from || from === 0) return null;
      return ((to - from) / from) * 100;
    };
    const fmtPct = (v: number | null, digits = 0): string => v === null ? 'tidak bisa dihitung' : `${v >= 0 ? '+' : ''}${v.toFixed(digits)}%`;

    const FREQ_WARNING = 3.0;
    const FREQ_SEVERE = 5.0;
    const LIFESPAN_TYPICAL_DAYS = 21; // Meta typical burnout window (14-21 hari, OpenAdKit)

    const evaluated: any[] = [];
    for (const [adId, entry] of adBucketsMap.entries()) {
      const buckets = entry.buckets.sort((a: any, b: any) => (a.dateStart > b.dateStart ? 1 : -1));
      const totalImpressions = buckets.reduce((s: number, b: any) => s + b.impressions, 0);
      const totalClicks = buckets.reduce((s: number, b: any) => s + b.clicks, 0);
      if (totalImpressions < 1000 && totalClicks < 50) continue; // RETIRE_THRESHOLD_RULE

      const week1 = buckets[0];
      const latest = buckets[buckets.length - 1];
      const hasComparison = buckets.length >= 2;

      const reachDecayPct = hasComparison ? pctChange(week1.impressions, latest.impressions) : null;
      const ctrDecayPct = hasComparison ? pctChange(week1.ctr, latest.ctr) : null;
      const cpmCreepPct = hasComparison ? pctChange(week1.cpm, latest.cpm) : null;
      const currentFrequency = latest.frequency || 0;

      // Skor 0-10 + threshold_breached per sinyal (bands persis OpenAdKit PHASE 2)
      const freqScore = Math.max(0, Math.min(10, Math.round((currentFrequency / FREQ_SEVERE) * 10)));
      const freqBreached = currentFrequency >= FREQ_WARNING;

      const ctrDecayAbs = ctrDecayPct !== null ? Math.abs(ctrDecayPct) : 0;
      let ctrDecayScore = 0;
      let ctrDecayReading = 'tidak bisa dihitung (kurang dari 2 minggu data)';
      if (ctrDecayPct !== null) {
        if (ctrDecayAbs <= 15) { ctrDecayScore = 2; ctrDecayReading = `Decay ringan (${fmtPct(ctrDecayPct)})`; }
        else if (ctrDecayAbs <= 25) { ctrDecayScore = 5; ctrDecayReading = `Decay moderat (${fmtPct(ctrDecayPct)})`; }
        else if (ctrDecayAbs <= 40) { ctrDecayScore = 7; ctrDecayReading = `Decay tinggi (${fmtPct(ctrDecayPct)})`; }
        else { ctrDecayScore = 10; ctrDecayReading = `Decay parah (${fmtPct(ctrDecayPct)})`; }
      }
      const ctrDecayBreached = ctrDecayPct !== null && ctrDecayPct < 0 && ctrDecayAbs >= 15;

      const cpmIncreaseAbs = cpmCreepPct !== null ? Math.max(0, cpmCreepPct) : 0;
      let cpmScore = 0;
      let cpmReading = 'tidak bisa dihitung (kurang dari 2 minggu data)';
      if (cpmCreepPct !== null) {
        if (cpmIncreaseAbs <= 10) { cpmScore = 2; cpmReading = `CPM naik wajar (${fmtPct(cpmCreepPct)})`; }
        else if (cpmIncreaseAbs <= 20) { cpmScore = 5; cpmReading = `CPM creep moderat (${fmtPct(cpmCreepPct)})`; }
        else { cpmScore = 8; cpmReading = `CPM creep parah (${fmtPct(cpmCreepPct)})`; }
      }
      const cpmBreached = cpmCreepPct !== null && cpmIncreaseAbs >= 10;

      evaluated.push({
        adId,
        adName: entry.meta.adName,
        campaignName: entry.meta.campaignName,
        qualityRanking: entry.meta.qualityRanking,
        engagementRanking: entry.meta.engagementRanking,
        conversionRanking: entry.meta.conversionRanking,
        token: entry.token,
        currentFrequency,
        totalImpressions,
        totalClicks,
        totalSpend: buckets.reduce((s: number, b: any) => s + b.spend, 0),
        weekCount: buckets.length,
        computedDecay: {
          reachDecay: fmtPct(reachDecayPct),
          ctrDecay: fmtPct(ctrDecayPct, 1),
          cpmCreep: fmtPct(cpmCreepPct, 1),
          notes: !hasComparison
            ? `Rentang tanggal cuma menghasilkan ${buckets.length} bucket mingguan -- perbandingan week-over-week butuh minimal 2 minggu data.`
            : (reachDecayPct !== null && reachDecayPct > 0 && ctrDecayPct !== null && ctrDecayPct < 0
                ? 'Perhatian: reach naik tapi CTR turun -- indikasi audiens sama disodori iklan yang sama berulang.'
                : ''),
        },
        signals: {
          frequency: { score: freqScore, reading: `Frekuensi saat ini ${currentFrequency.toFixed(2)}x (ambang waspada ${FREQ_WARNING}x, parah ${FREQ_SEVERE}x)`, thresholdBreached: freqBreached },
          ctrDecay: { score: ctrDecayScore, reading: ctrDecayReading, thresholdBreached: ctrDecayBreached },
          cpmIncrease: { score: cpmScore, reading: cpmReading, thresholdBreached: cpmBreached },
        },
      });
    }

    // Severity overall persis rumus PHASE 3 OpenAdKit
    for (const ad of evaluated) {
      const breachedCount = [ad.signals.frequency.thresholdBreached, ad.signals.ctrDecay.thresholdBreached, ad.signals.cpmIncrease.thresholdBreached].filter(Boolean).length;
      const ctrDecayNum = parseFloat(String(ad.computedDecay.ctrDecay).replace(/[^0-9.-]/g, '')) || 0;
      const ctrDecayIsNumber = ad.computedDecay.ctrDecay !== 'tidak bisa dihitung';
      let severity = 'none';
      let reasonParts: string[] = [];
      if (ad.currentFrequency >= FREQ_SEVERE || (ctrDecayIsNumber && ctrDecayNum <= -40)) {
        severity = 'severe';
      } else if (breachedCount >= 2 || (ctrDecayIsNumber && ctrDecayNum <= -25 && ctrDecayNum > -40)) {
        severity = 'moderate';
      } else if (breachedCount === 1) {
        severity = 'mild';
      } else {
        severity = 'none';
      }
      if (ad.signals.frequency.thresholdBreached) reasonParts.push(`frekuensi ${ad.currentFrequency.toFixed(2)}x`);
      if (ad.signals.ctrDecay.thresholdBreached) reasonParts.push(`CTR decay ${ad.computedDecay.ctrDecay}`);
      if (ad.signals.cpmIncrease.thresholdBreached) reasonParts.push(`CPM creep ${ad.computedDecay.cpmCreep}`);
      ad.severityOverall = severity;
      ad.severityReason = reasonParts.length > 0 ? `Sinyal terdeteksi: ${reasonParts.join(', ')}.` : 'Tidak ada ambang batas yang terlampaui pada data saat ini.';
    }

    // Urutkan severe > moderate > mild > none, lalu frekuensi desc; potong sesuai limit
    const severityRank: Record<string, number> = { severe: 3, moderate: 2, mild: 1, none: 0 };
    evaluated.sort((a, b) => (severityRank[b.severityOverall] - severityRank[a.severityOverall]) || (b.currentFrequency - a.currentFrequency));
    const topAds = evaluated.slice(0, limit);

    // Step 2: fetch creative thumbnail/preview + created_time HANYA utk topAds (sama pola /meta-top-creatives)
    await Promise.allSettled(topAds.map(async (ad) => {
      try {
        const adResp = await fetch(`https://graph.facebook.com/v21.0/${ad.adId}?fields=created_time,creative{id,name,title,body,thumbnail_url,image_url,video_id,object_story_spec,asset_feed_spec,status}&access_token=${ad.token}`);
        if (adResp.ok) {
          const data = (await adResp.json()) as any;
          const creative = data.creative || {};
          ad.thumbnailUrl = creative.thumbnail_url || creative.image_url || creative.object_story_spec?.video_data?.image_url || creative.object_story_spec?.link_data?.picture || creative.object_story_spec?.photo_data?.url || creative.asset_feed_spec?.images?.[0]?.url || null;

          const isVideo = Boolean(creative.video_id || creative.object_story_spec?.video_data?.video_id || creative.asset_feed_spec?.videos?.[0]?.video_id);
          ad.mediaType = isVideo ? 'VIDEO' : 'IMAGE';
          ad.adTitle = creative.title || creative.object_story_spec?.video_data?.title || creative.name || '';
          ad.adBody = creative.body || creative.object_story_spec?.video_data?.message || '';

          if (data.created_time) {
            ad.daysRunning = Math.max(1, Math.round((Date.now() - new Date(data.created_time).getTime()) / 86400000));
          } else {
            ad.daysRunning = null;
          }
        }

        const prevRes = await fetch(`https://graph.facebook.com/v21.0/${ad.adId}/previews?ad_format=MOBILE_FEED_STANDARD&access_token=${ad.token}`);
        if (prevRes.ok) {
          const prevData = (await prevRes.json()) as any;
          ad.previewIframe = prevData.data?.[0]?.body || null;
        }
      } catch (err) {}
      delete ad.token;

      // creative_lifespan: skor + breached dihitung di sini krn butuh daysRunning dari Step 2
      const daysRunning = ad.daysRunning;
      let lifespanScore = 0;
      let lifespanReading = 'Umur iklan tidak diketahui (created_time tidak tersedia dari Meta).';
      let lifespanBreached = false;
      if (typeof daysRunning === 'number') {
        lifespanBreached = daysRunning > LIFESPAN_TYPICAL_DAYS;
        lifespanScore = Math.max(0, Math.min(10, Math.round((daysRunning / (LIFESPAN_TYPICAL_DAYS * 2)) * 10)));
        lifespanReading = lifespanBreached
          ? `Sudah tayang ${daysRunning} hari, melewati jendela tipikal burnout Meta (14-21 hari).`
          : `Sudah tayang ${daysRunning} hari, masih dalam jendela tipikal Meta (14-21 hari).`;
      }
      ad.signals.creativeLifespan = { score: lifespanScore, reading: lifespanReading, thresholdBreached: lifespanBreached };
    }));

    const payload = { data: topAds };
    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 20 * 60).catch(() => {});
    res.json(payload);
  } catch (e) { next(e); }
});

// GET /business/campaign-ads-ctr — "Jembatan" CTR campaign -> ad (Fase 4+) ────────────────────
// [2026-08-26] Klik kolom CTR di tabel drill-down campaign -> panel ringan MURNI Node (nol agy)
// yang nunjukin ad-ad MANA di dalam campaign itu yang paling nyeret CTR turun/naik. Dari panel ini
// user lanjut klik ke popup "Preview & Insight" (yang sudah ada, isinya termasuk "Analisa Copy AI")
// utk ad spesifik yang mencurigakan -- BUKAN bikin analisa AI baru di level campaign (didiskusikan
// dulu sama Bossfren: lever-scoring CTR Optimizer butuh SATU copy spesifik, sementara 1 campaign
// biasanya isinya banyak ad dgn copy beda-beda, jadi gak ada "satu copy campaign" yang bisa
// di-lever-score -- lebih make sense jembatanin ke ad-level yang sudah tepat granularitasnya).
// Response per-ad SENGAJA disamakan persis field-nya dgn `TopCreative` (dipakai /meta-top-creatives)
// supaya frontend bisa langsung oper hasilnya ke popup Preview & Insight yang sama tanpa mapping.
router.get('/campaign-ads-ctr', authorize('ADMIN'), async (req: Request, res: Response, next: NextFunction) => {
  try {
    const { businessId } = req.user!;
    const campaignId = String(req.query.campaignId || '');
    if (!campaignId) {
      res.status(400).json({ error: { message: 'campaignId wajib diisi.' } });
      return;
    }
    const campaignNameHint = String(req.query.campaignName || campaignId);
    const startDate = (req.query.startDate as string) || new Date().toISOString().split('T')[0];
    const endDate = (req.query.endDate as string) || new Date().toISOString().split('T')[0];

    const cacheKey = `salespintar:campaign-ads-ctr:${businessId}:${campaignId}:${startDate}:${endDate}`;
    const { redisCache } = await import('../config/redis');
    const forceRefresh = req.query.forceRefresh === 'true';
    const cached = await redisCache.get(cacheKey).catch(() => null);
    if (cached && !forceRefresh) {
      return res.json(JSON.parse(cached));
    }

    const bms = await prisma.metaBusinessManager.findMany({
      where: { businessId, isActive: true, tokenStatus: 'ACTIVE' }
    });

    let ads: any[] = [];
    let campaignNameResolved = campaignNameHint;

    // Pola resolusi token SAMA PERSIS dgn computeCampaignAuditFacts() (ai-ads.routes.ts) -- coba
    // tiap BM punya business ini, break begitu ketemu yang punya akses ke campaign ini.
    for (const bm of bms) {
      const token = decrypt(bm.accessToken);
      if (!token) continue;
      try {
        const query = new URLSearchParams({
          level: 'ad',
          fields: 'ad_id,ad_name,campaign_name,spend,ctr,clicks,impressions,quality_ranking,engagement_rate_ranking,conversion_rate_ranking',
          time_range: JSON.stringify({ since: startDate, until: endDate }),
          access_token: token,
        });
        const insResp = await fetch(`https://graph.facebook.com/v21.0/${campaignId}/insights?${query}`);
        if (!insResp.ok) continue;
        const rows = ((await insResp.json()) as any).data || [];
        if (rows.length === 0) continue;
        for (const row of rows) {
          const imp = parseInt(row.impressions || '0', 10);
          if (imp < 100) continue; // konsisten sama ambang minimum /meta-top-creatives
          if (row.campaign_name) campaignNameResolved = row.campaign_name;
          ads.push({
            adId: row.ad_id,
            adName: row.ad_name,
            campaignName: row.campaign_name || campaignNameResolved,
            spend: parseFloat(row.spend || '0'),
            ctr: parseFloat(row.ctr || '0'),
            clicks: parseInt(row.clicks || '0', 10),
            impressions: imp,
            qualityRanking: row.quality_ranking || 'UNKNOWN',
            engagementRanking: row.engagement_rate_ranking || 'UNKNOWN',
            conversionRanking: row.conversion_rate_ranking || 'UNKNOWN',
            token,
          });
        }
        break;
      } catch (err) {}
    }

    // CTR rata-rata campaign = weighted (total klik / total impresi), BUKAN rata-rata sederhana
    // antar ad -- konsisten sama cara Meta sendiri hitung CTR di level campaign (ad ber-impresi
    // besar bobotnya lebih besar).
    const totalClicks = ads.reduce((s, a) => s + a.clicks, 0);
    const totalImpressions = ads.reduce((s, a) => s + a.impressions, 0);
    const campaignAvgCtr = totalImpressions > 0 ? (totalClicks / totalImpressions) * 100 : 0;

    for (const ad of ads) {
      ad.deltaFromAvgPct = campaignAvgCtr > 0 ? ((ad.ctr - campaignAvgCtr) / campaignAvgCtr) * 100 : 0;
    }
    ads.sort((a, b) => a.deltaFromAvgPct - b.deltaFromAvgPct); // paling nyeret turun duluan

    // Kalau ad di campaign ini banyak (>20), ambil 10 paling nyeret TURUN + 10 paling nyeret NAIK
    // (biar 2 sisi ekstrem selalu kelihatan) drpd cuma slice(0,20) yang bisa mubazir kepotong di
    // satu sisi doang. Kalau <=20, tampilkan semua.
    let selected: any[];
    if (ads.length <= 20) {
      selected = ads;
    } else {
      const worst = ads.slice(0, 10);
      const best = ads.slice(-10);
      const seenIds = new Set(worst.map((a) => a.adId));
      selected = [...worst, ...best.filter((a) => !seenIds.has(a.adId))];
      selected.sort((a, b) => a.deltaFromAvgPct - b.deltaFromAvgPct);
    }

    // Step 2: thumbnail/preview/copy -- pola SAMA PERSIS /meta-top-creatives, HANYA utk ads yg
    // ditampilkan (supaya jembatan ke popup Preview & Insight bisa langsung jalan tanpa fetch ulang).
    await Promise.allSettled(selected.map(async (ad) => {
      try {
        const adResp = await fetch(`https://graph.facebook.com/v21.0/${ad.adId}?fields=creative{id,name,title,body,thumbnail_url,image_url,video_id,object_story_spec,asset_feed_spec,status}&access_token=${ad.token}`);
        if (adResp.ok) {
          const data = (await adResp.json()) as any;
          const creative = data.creative || {};
          ad.thumbnailUrl = creative.thumbnail_url || creative.image_url || creative.object_story_spec?.video_data?.image_url || creative.object_story_spec?.link_data?.picture || creative.object_story_spec?.photo_data?.url || creative.asset_feed_spec?.images?.[0]?.url || null;
          const isVideo = Boolean(creative.video_id || creative.object_story_spec?.video_data?.video_id || creative.asset_feed_spec?.videos?.[0]?.video_id);
          ad.mediaType = isVideo ? 'VIDEO' : 'IMAGE';
          ad.adTitle = creative.title || creative.object_story_spec?.video_data?.title || creative.name || '';
          ad.adBody = creative.body || creative.object_story_spec?.video_data?.message || '';
        }
        const prevRes = await fetch(`https://graph.facebook.com/v21.0/${ad.adId}/previews?ad_format=MOBILE_FEED_STANDARD&access_token=${ad.token}`);
        if (prevRes.ok) {
          const prevData = (await prevRes.json()) as any;
          ad.previewIframe = prevData.data?.[0]?.body || null;
        }
      } catch (err) {}
      delete ad.token;
    }));

    const payload = { campaignId, campaignName: campaignNameResolved, campaignAvgCtr, ads: selected };
    await redisCache.set(cacheKey, JSON.stringify(payload), 'EX', 20 * 60).catch(() => {});
    res.json(payload);
  } catch (e) { next(e); }
});


