# nginx DI DALAM container frontend — khusus penerapan mode host di vps-upcloud.
#
# Beda dari nginx/default.conf (versi bridge):
#   upstream  api:3000        -> 127.0.0.1:3000   (tidak ada DNS nama-service di mode host)
#   listen    80              -> 127.0.0.1:3001   (80 & 443 milik nginx HOST yang melayani 62 vhost)
#
# Mengikat ke 127.0.0.1, BUKAN 0.0.0.0: di jaringan host, 0.0.0.0 berarti terbuka
# ke internet. CSF memang menolaknya (3001 tidak ada di TCP_IN), tapi jangan
# bergantung pada satu lapis saja.
upstream salespintar_api {
    server 127.0.0.1:3000;
}

server {
    listen 127.0.0.1:3001;
    server_name _;
    client_max_body_size 10m;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    location /api/ {
        proxy_pass http://salespintar_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    location /socket.io/ {
        proxy_pass http://salespintar_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location /uploads/ {
        proxy_pass http://salespintar_api;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
